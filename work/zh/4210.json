 "lines": {
  "0": {
   "text": "「不行！\n像你這種、怪物……、」"
  },
  "1": {
   "text": "「應該、一直、待在這裡才對呀！」"
  },
  "2": {
   "text": "「……別、礙事呀。」"
  },
  "3": {
   "text": "「嘎？」"
  },
  "4": {
   "text": "「啾、啾啾……！？」"
  },
  "5": {
   "text": "「……嗚、嗚。」"
  },
  "6": {
   "text": "「……！\n（真是的，再怎麼鬧也該安分一點了……）」"
  },
  "7": {
   "text": "「（……咦？）」"
  },
  "8": {
   "text": "「……。」"
  },
  "9": {
   "text": "「（為什麼、我會、在這裡？）」"
  },
  "10": {
   "text": "「（……、……開玩笑。\n怎、怎麼可能……）」"
  },
  "11": {
   "text": "「（我、變成坎特了！？）」"
  },
  "12": {
   "text": "「（明明剛才、還是我、變成異形的）」"
  },
  "13": {
   "text": "「……下雨、的聲音？」"
  },
  "14": {
   "text": "「（……。\n水、沒有落下來……）」"
  },
  "15": {
   "text": "「（因為樹長得茂密……、\n連天空都看不見，所以吧）」"
  },
  "16": {
   "text": "「（……雨也、\n進不到這裡來呢）」"
  },
  "17": {
   "text": "「好、好冷呀。」"
  },
  "18": {
   "text": "「咦……。」"
  },
  "19": {
   "text": "「爸爸，我們躲到樹下去吧！」"
  },
  "20": {
   "text": "「……呀。\n（有人、來了）」"
  },
  "21": {
   "text": "「呼，幸好森林離得近。\n突然下起來真是……、」"
  },
  "22": {
   "text": "「哇，那是什麼？\n這裡長出的糖果，全都……好奇怪。」"
  },
  "23": {
   "text": "「……原來是異形化的森林啊。」"
  },
  "24": {
   "text": "「小心，別靠糖果太近。\n異形森林的糖果，\n只要稍微碰一下就會發動攻擊。」"
  },
  "25": {
   "text": "「欸——！\n這裡是那種、危險的森林嗎！？」"
  },
  "26": {
   "text": "「嘛，只要靜靜地避雨應該沒問題。\n只要不碰觸，就不會有害處……、」"
  },
  "27": {
   "text": "「……！」"
  },
  "28": {
   "text": "「剛才，沒有發出聲音嗎？\n像是刀子摩擦之類的……。」"
  },
  "29": {
   "text": "「啊，是啊。\n從比較近的地方，響起聲音了……、」"
  },
  "30": {
   "text": "「哇，又來了！？」"
  },
  "31": {
   "text": "「爸、爸爸……\n不取消避雨嗎？\n與其嚇到，不如淋濕比較好。」"
  },
  "32": {
   "text": "「也是，確實很詭異……。\n我們跑回家吧。」"
  },
  "33": {
   "text": "「（回家後馬上找媽媽要毛巾。\n好好暖身，\n再泡杯熱可可……、」"
  },
  "34": {
   "text": "「……。」"
  },
  "35": {
   "text": "「（……那些人。\n已經走了吧）」"
  },
  "36": {
   "text": "「（……淋濕了，\n會不會感冒？\n……因為看起來家不遠，\n應該沒關係吧）」"
  },
  "37": {
   "text": "「（……、家。\n……爸爸、媽媽、哥哥……）」"
  },
  "38": {
   "text": "「（―――）」"
  },
  "39": {
   "text": "「……嗚。」"
  },
  "40": {
   "text": "「（別這樣……。\n你，安靜點）」"
  },
  "41": {
   "text": "「如果安靜不下來……、」"
  },
  "42": {
   "text": "「」"
  },
  "43": {
   "text": "「（雨，要停了……。」"
  },
  "44": {
   "text": "「（……安靜了下來）」"
  },
  "45": {
   "text": "「呼……。」"
  },
  "46": {
   "text": "「」"
  },
  "47": {
   "text": "「（……啊。\n又、把樹枝……、折斷了）」"
  },
  "48": {
   "text": "「（……討厭。\n這種身體）」"
  },
  "49": {
   "text": "「」"
  },
  "50": {
   "text": "「（身體一動……。\n連東西……、\n手腳都會跟著動起來……）」"
  },
  "51": {
   "text": "「（動起來的聲音，好可怕……。\n真的很討厭）」"
  },
  "52": {
   "text": "「（……。\n但是……）」"
  },
  "53": {
   "text": "「（故意弄響……。\n嚇到你們，對不起。\n但是……、你們離開了，真好）」"
  },
  "54": {
   "text": "「（不想被看到樣子。\n如果在附近……、\n不知道什麼時候會傷到你們……）」"
  },
  "55": {
   "text": "「啾嚏。」"
  },
  "56": {
   "text": "「（……好冷）」"
  },
  "57": {
   "text": "「啾嚏！」"
  },
  "58": {
   "text": "「……誰在打噴嚏？」"
  },
  "59": {
   "text": "「」"
  },
  "60": {
   "text": "「啾嚏、啾嚏！」"
  },
  "61": {
   "text": "「……嗚嗚～。」"
  },
  "62": {
   "text": "「（啊……。\n那邊，有魔物……）」"
  },
  "63": {
   "text": "「嗚嗚嗚！」"
  },
  "64": {
   "text": "「樹……樹上的餅乾，\n開始打起來了……！？」"
  },
  "65": {
   "text": "「（啊，餅乾，\n一下子就碎掉了……）」"
  },
  "66": {
   "text": "「嗚嗚嗚！」"
  },
  "67": {
   "text": "「住手～！\n樹葉掉光的話，就藏不住了啦。」"
  },
  "68": {
   "text": "「啊……。」"
  },
  "69": {
   "text": "「……。」"
  },
  "70": {
   "text": "「（……。\n得、得趕快藏起來）」"
  },
  "71": {
   "text": "「（要是被發現了……）」"
  },
  "72": {
   "text": "「（……怕我……。\n……也許會，\n從樹外頭出去吧……？）」"
  },
  "73": {
   "text": "「嗚嗚嗚！」"
  },
  "74": {
   "text": "「撲過來了！？」"
  },
  "75": {
   "text": "「咕嚕嚕！」"
  },
  "76": {
   "text": "「呀啊。」"
  },
  "77": {
   "text": "「（嗚～，好、好可怕……。\n該不會，是想跟我打吧）」"
  },
  "78": {
   "text": "「（那當然了）」"
  },
  "79": {
   "text": "「（長成這樣。\n人類根本不可能看得懂吧）」"
  },
  "80": {
   "text": "「……好吵。」"
  },
  "81": {
   "text": "「咕嚕嚕嚕！」"
  },
  "82": {
   "text": "「啊，我不是對你說的啦！\n不、不要抓我～！」"
  },
  "83": {
   "text": "「嗚……，」"
  },
  "84": {
   "text": "「啾嚏、啾嚏！」"
  },
  "85": {
   "text": "「啾～……。」"
  },
  "86": {
   "text": "「……？\n（在……在抖得很厲害）」"
  },
  "87": {
   "text": "「（……咦？\n該不會……。\n這隻，魔物……）」"
  },
  "88": {
   "text": "「（因為冷，所以心情不好？\n所以，對餅乾和我……）」"
  },
  "89": {
   "text": "「（……只是在，發脾氣而已？）」"
  },
  "90": {
   "text": "「嗚！」"
  },
  "91": {
   "text": "「呀！\n袖、袖子……，不要咬～。」"
  },
  "92": {
   "text": "「（再、再破掉的話……，\n手就會露出來了！）」"
  },
  "93": {
   "text": "「啾嚏。」"
  },
  "94": {
   "text": "「……嗚。」"
  },
  "95": {
   "text": "「（我的手……。\n像鬼一樣，好可怕。\n不想看，也不想被看到，可是……）」"
  },
  "96": {
   "text": "「（……但是。\n只要被咬住袖子、被拉著走，\n身體……、就不會動了）」"
  },
  "97": {
   "text": "「……我的手。\n也動不了……」"
  },
  "98": {
   "text": "「咕嚕……？」"
  },
  "99": {
   "text": "「（……。\n其實……）」"
  },
  "100": {
   "text": "「（不想再，孤單一人了……。\n寒冷……、也很討厭。\n所以……）」"
  },
  "101": {
   "text": "「沒……、沒關係。\n在氣消之前，咬袖子也……」"
  },
  "102": {
   "text": "「就這樣，請便！」"
  },
  "103": {
   "text": "「……嗚。」"
  },
  "104": {
   "text": "「……啊啊～，但是呢，\n這、這件衣服，是我最愛的……！\n稍微，注意一下力道的話，我會很高興……！」"
  },
  "105": {
   "text": "「……。」"
  },
  "106": {
   "text": "「咕嚕……」"
  },
  "107": {
   "text": "「……咦？」"
  },
  "108": {
   "text": "「（完全沒有，用力拉……。\n咬住嘴巴，左右、甩動……、\n只是在玩嗎？）」"
  },
  "109": {
   "text": "「咕嚕嚕、咕嚕。」"
  },
  "110": {
   "text": "「……。\n（魔物和袖子……、\n一起搖晃著……）」"
  },
  "111": {
   "text": "「（……像是在跳舞）」"
  },
  "112": {
   "text": "「啾～」"
  },
  "113": {
   "text": "「（……呵呵。\n已經，心情好了嗎？）」"
  },
  "114": {
   "text": "「……。」"
  },
  "115": {
   "text": "「（好久沒有，笑過了吧）」"
  },
  "116": {
   "text": "「（……手，用不了。\n即使長滿了，頭髮）」"
  },
  "117": {
   "text": "「（能跟誰，一起，搖擺著跳舞呢……）」"
  },
  "118": {
   "text": "「」"
  },
  "119": {
   "text": "「嘎！」"
  },
  "120": {
   "text": "「……！」"
  },
  "121": {
   "text": "「啊、啊啊……。\n（頭髮……、被，剪斷了……）」"
  },
  "122": {
   "text": "「不行！對不起！\n我馬上，把頭髮，讓開……！」"
  },
  "123": {
   "text": "「嗯……、」"
  },
  "124": {
   "text": "「嗯～……」"
  },
  "125": {
   "text": "「嘎嘎嘎！」"
  },
  "126": {
   "text": "「……啊、……咦？\n本來應該，變成，頭髮的……。」"
  },
  "127": {
   "text": "「……在變成，頭髮之前，\n你閃開了？」"
  },
  "128": {
   "text": "「轉了一圈。」"
  },
  "129": {
   "text": "「……太好了。」"
  },
  "130": {
   "text": "「太好了，但是……。\n不過，真的……、對不起，了。」"
  },
  "131": {
   "text": "「嘎……。」"
  },
  "132": {
   "text": "「（我……。\n因為覺得，開心了……、\n為什麼，身體，動了呢？）」"
  },
  "133": {
   "text": "「（如果，這個孩子，沒有閃開的話。\n會造成，重傷的）」"
  },
  "134": {
   "text": "「（因為，我的關係……）」"
  },
  "135": {
   "text": "「（不是我的錯！）」"
  },
  "136": {
   "text": "「（……。\n你在，說什麼。\n怎麼想，剛才那都是……）」"
  },
  "137": {
   "text": "「（我只是，覺得開心而已）」"
  },
  "138": {
   "text": "「（壞的是，\n變成，這種模樣這件事……。\n不是，普通的女孩子！）」"
  },
  "139": {
   "text": "「（所以，不是我的錯。\n因為，這種模樣，\n不是，想變成才變的……）」"
  },
  "140": {
   "text": "「（別，說了！）」"
  },
  "141": {
   "text": "「（會，想起來，的……、\n你，閉嘴吧……）」"
  },
  "142": {
   "text": "「（……想起來吧）」"
  },
  "143": {
   "text": "「（明明，受了，重傷！\n別當作，沒發生！）」"
  },
  "144": {
   "text": "「（我。\n本來，是，普通的女孩子）」"
  },
  "145": {
   "text": "「（生日，時，收到的，禮物餅乾……。\n不知道，是危險的餅乾，就，吃掉了。\n結果……）」"
  },
  "146": {
   "text": "「皮塔尼亞，生日快……樂！\n媽媽和爸爸，哥哥……、\n把家裡，裝飾……好了。」"
  },
  "147": {
   "text": "「今天，大家一起，慶祝……、」"
  },
  "148": {
   "text": "「怎……麼了？\n……皮塔尼亞？」"
  },
  "149": {
   "text": "「皮塔尼亞……。\n你，那隻爪子是……、」"
  },
  "150": {
   "text": "「」"
  },
  "151": {
   "text": "「……！」"
  },
  "152": {
   "text": "「（已經，不是，普通的女孩子了。\n家人，還有，家，都毀了……）」"
  },
  "153": {
   "text": "「」"
  },
  "154": {
   "text": "「（滿身，頭髮的，異形）」"
  },
  "155": {
   "text": "「（即使，很冷，也回不了，家）」"
  },
  "156": {
   "text": "「（也無法，跟誰，好好相處）」"
  },
  "157": {
   "text": "「（一直、都是、孤單一人！）」"
  },
  "158": {
   "text": "「（那、是……）」"
  },
  "159": {
   "text": "「（……得、忍耐才行！）」"
  },
  "160": {
   "text": "「（要是、沒收到、那種點心，\n不用忍耐、就好了）」"
  },
  "161": {
   "text": "「（……都是、那傢伙的錯）」"
  },
  "162": {
   "text": "「（把點心、當作禮物送來的，\n都是那傢伙的錯。\n我……！）」"
  },
  "163": {
   "text": "「住手！\n閉嘴！」"
  },
  "164": {
   "text": "「嘎、嘎？」"
  },
  "165": {
   "text": "「為什麼、總是、說這種話呢。\n從我、吃了點心、開始……、」"
  },
  "166": {
   "text": "「都是別人的錯」，\n一直、都在這麼說！"
  },
  "167": {
   "text": "「真的、很吵。\n因為你的話，我……快瘋了。」"
  },
  "168": {
   "text": "「別試圖改變我。\n連內心、都不想變得可怕！」"
  },
  "169": {
   "text": "「……你，總是，\n像另一個我一樣、說話。\n但其實，你不是我，對吧？」"
  },
  "170": {
   "text": "「吃了那種點心時，\n擅自、闖進我心中的……、\n怪物吧！」"
  },
  "171": {
   "text": "「（……你這樣下去，\n外表、內心，\n都會、變成怪物）」"
  },
  "172": {
   "text": "「（都是那傢伙的錯）」"
  },
  "173": {
   "text": "「……真煩人！\n又在說那種話！」"
  },
  "174": {
   "text": "「（……煩人的、是你吧！）」"
  },
  "175": {
   "text": "「（一次又一次、\n欺騙我！）」"
  },
  "176": {
   "text": "「（別原諒那傢伙！）」"
  },
  "177": {
   "text": "「（讓我把他、捲入這種處境的傢伙，\n不能再……）」"
  },
  "178": {
   "text": "「（別放過他！）」"
  },
  "179": {
   "text": "「……！」"
  },
  "180": {
   "text": "「不行！\n像你這種、怪物……、」"
  },
  "181": {
   "text": "「應該、一直、待在這裡才對呀！」"
  },
  "182": {
   "text": "「（……雨。\n得、舔掉雨才行！）」"
  },
  "183": {
   "text": "「（住手！\n別壓制我！）」"
  },
  "184": {
   "text": "「……別、礙事呀。」"
  },
  "185": {
   "text": "「（礙事的……）」"
  },
  "186": {
   "text": "「（是你吧！）」"
  },
  "187": {
   "text": "「嘎？」"
  },
  "188": {
   "text": "「啾、啾啾……！？」"
  },
  "189": {
   "text": "「……嗚、嗚。」"
  },
  "190": {
   "text": "「……！\n（真是的，再怎麼鬧也該安分一點了……）」"
  },
  "191": {
   "text": "「（……咦？）」"
  },
  "192": {
   "text": "「……。」"
  },
  "193": {
   "text": "「（為什麼、我會、在這裡？）」"
  },
  "194": {
   "text": "「（……、……開玩笑。\n怎、怎麼可能……）」"
  },
  "195": {
   "text": "「」"
  },
  "196": {
   "text": "「（我、變成坎特了！？\n明明剛才還是異形的）」"
  },
  "197": {
   "text": "「（咦……、咦咦——？\n這……、變成這樣是因為……。\n是、是因為我的身體、不普通嗎？）」"
  },
  "198": {
   "text": "「（不不，那不重要！\n站在那裡的我……）」"
  },
  "199": {
   "text": "「（……不會吧）」"
  },
  "200": {
   "text": "「」"
  },
  "201": {
   "text": "「」"
  },
  "202": {
   "text": "「……雨。不需要。」"
  },
  "203": {
   "text": "「……都怪那傢伙。\n不能、放任不管！」"
  },
  "204": {
   "text": "「我不原諒你！」"
  },
  "205": {
   "text": "「（啊、啊啊……！）」"
  },
  "206": {
   "text": "「（果然、是怪物。\n可是……、怎麼辦才好……）」"
  },
  "207": {
   "text": "「（衝出森林了！）」"
  },
  "208": {
   "text": "「嘎……、嘎昂？」"
  },
  "209": {
   "text": "「啊，雨停了。\n總算行李沒淋濕……。\n大家，差不多該出發了。」"
  },
  "210": {
   "text": "「失禮了。那邊的商隊。\n可以問一下路嗎？」"
  },
  "211": {
   "text": "「啊，可以啊。\n哥哥，你想去哪裡？」"
  },
  "212": {
   "text": "「」"
  },
  "213": {
   "text": "「……那是只有特定之人才能抵達之地。\n若你知道具體方位就好了。」"
  },
  "214": {
   "text": "「異形森林。」"
  }
 },
