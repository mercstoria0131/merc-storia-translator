  },
  "6": {
   "text": "「……！」"
  },
  "7": {
   "text": "「不……。」"
  },
  "8": {
   "text": "「明白了。\n那麼帶他們走。」"
  },
  "9": {
   "text": "「……是。」"
  },
  "10": {
   "text": "「……。」"
  },
  "11": {
   "text": "「……抱歉。」"
  },
  "12": {
   "text": "「士兵，過來。\n請幫忙搬運。」"
  },
  "13": {
   "text": "「搬。搬。」"
  },
  "14": {
   "text": "「……？」"
  },
  "15": {
   "text": "「怎麼了？」"
  },
  "16": {
   "text": "「在搖晃。」"
  },
  "17": {
   "text": "「在搖晃。」"
  },
  "18": {
   "text": "「這個女人。」"
  },
  "19": {
   "text": "「……。」"
  },
  "20": {
   "text": "「……我無法確認。」"
  },
  "21": {
   "text": "「是、鈴鐺。」"
  },
  "22": {
   "text": "「鈴鐺？」"
  },
  "23": {
   "text": "「……啊。」"
  },
  "24": {
   "text": "「怎麼了……、」"
  },
  "25": {
   "text": "「過來這裡。」"
  },
  "26": {
   "text": "「欸，等一下你在……？」"
  },
  "27": {
   "text": "「咕嚕嚕……。」"
  },
  "28": {
   "text": "「好暗啊啊啊啊！」"
  },
  "29": {
   "text": "「……！？」"
  },
  "30": {
   "text": "「魔、魔寵！？」"
  },
  "31": {
   "text": "「閃耀種子，\n自己反應過來了。」"
  },
  "32": {
   "text": "「察覺到持有者的危機了？」"
  },
  "33": {
   "text": "「咕嚕嚕嚕……。」"
  },
  "34": {
   "text": "「好暗啊啊啊啊！」"
  },
  "35": {
   "text": "「哇啊啊啊啊！？」"
  },
  "36": {
   "text": "「……反而讓持有者陷入更深的危機了。」"
  },
  "37": {
   "text": "「不、不要放火啊啊啊！」"
  },
  "38": {
   "text": "「咕嚕嚕嚕嚕！」"
  },
  "39": {
   "text": "「好燙、好燙、好燙！\n為、為什麼弗蘭會在這裡！？」"
  },
  "40": {
   "text": "「咕嚕嚕！」"
  },
  "41": {
   "text": "「啊！\n這、這個是……！」"
  },
  "42": {
   "text": "「好暗啊啊啊啊！」"
  },
  "43": {
   "text": "「這次又是怎麼了！\n到底是怎麼回事啦——！」"
  },
  "44": {
   "text": "「咦？\n這、這個好漂亮……、\n是閃耀種子嗎？」"
  },
  "45": {
   "text": "「咕嚕嚕！\n好暗！\n咕嚕嚕～！」"
  },
  "46": {
   "text": "「嚇死我了，知道了！\n我戴！我戴著就是啦～！」"
  },
  "47": {
   "text": "「不會吧……\n是要用這個嗎！？」"
  },
  "48": {
   "text": "「咕嚕嚕嚕！」"
  },
  "49": {
   "text": "「唉，也就是說從今以後，\n都要一直害怕弗蘭突然出現嗎……。」"
  },
  "50": {
   "text": "「好暗……？」"
  },
  "51": {
   "text": "「嚇死我了！\n我一點都不不滿！」"
  },
  "52": {
   "text": "「而、而且……嘿嘿。\n沒有就此別過，還真是讓人開心……。」"
  },
  "53": {
   "text": "「咕！？」"
  },
  "54": {
   "text": "「咕、好暗啊啊啊！」"
  },
  "55": {
   "text": "「啊，不可以用火哦！\n這裡是飯店……！」"
  },
  "56": {
   "text": "「等等，咦？」"
  },
  "57": {
   "text": "「……。」"
  },
  "58": {
   "text": "「……。」"
  },
  "59": {
   "text": "「……咦，變多了？」"
  },
  "60": {
   "text": "「作戰計畫不變。」"
  },
  "61": {
   "text": "「什、什、什麼……！？」"
  },
  "62": {
   "text": "「請逮捕他們。」"
  },
  "63": {
   "text": "「特拉埃羅。」"
  },
  "64": {
   "text": "「大家——！」"
  },
  "65": {
   "text": "「啊？\n我、我要做什麼……」"
  },
  "66": {
   "text": "「特拉埃羅。」"
  },
  "67": {
   "text": "「啊啊啊啊啊！？」"
  },
  "68": {
   "text": "「這邊，小提奧！」"
  },
  "69": {
   "text": "「哇啊！？」"
  },
  "70": {
   "text": "「所有人，快逃出飯店！」"
  },
  "71": {
   "text": "「什、什麼！？」"
  },
  "72": {
   "text": "「特拉埃羅，特拉埃羅。」"
  },
  "73": {
   "text": "「不知道！\n雖然不知道，但快跑，<name>！」"
  },
  "74": {
   "text": "「好、好的！」"
  },
  "75": {
   "text": "「啊。」"
  },
  "76": {
   "text": "「很、非常抱歉！」"
  },
  "77": {
   "text": "「……？」"
  },
  "78": {
   "text": "「為什麼要道歉？\n將他們留在飯店內，並移交給我，\n就是你的職責。我認為你已經充分履行了。」"
  },
  "79": {
   "text": "「那、那是……。」"
  },
  "80": {
   "text": "「接下來是我的管轄範圍。\n你完全不需要擔心任何事。」"
  },
  "81": {
   "text": "「志緒。」"
  },
  "82": {
   "text": "「是，請進行追跡。」"
  },
  "83": {
   "text": "「外圍的包圍網也即將完成了。」"
  },
  "84": {
   "text": "「是『沙漠玫瑰』！包圍起來！」"
  },
  "85": {
   "text": "「一定要抓起來獻上——！」"
  },
  "86": {
   "text": "「這、這、這是怎麼回事——！」"
  },
  "87": {
   "text": "「喂喂，整個鎮子都大騷動了！\n難道說，這些全都是……！？」"
  },
  "88": {
   "text": "「目標是我們……吧。\n腳步聲全都朝這邊逼近了。」"
  },
  "89": {
   "text": "「那、那是說這種情況嗎？\n首都的所有人，都在追捕我們……？」"
  },
  "90": {
   "text": "「就是這麼回事。\n哈、哈哈，不知不覺間我們竟然成了名人了？」"
  },
  "91": {
   "text": "「為什麼呀——！？」"
  },
  "92": {
   "text": "「……！大家，後面也有人！」"
  },
  "93": {
   "text": "「請追擊。」"
  },
  "94": {
   "text": "「噢、噢。」"
  },
  "95": {
   "text": "「該死！就算賭上性命，\n那傢伙也絕對不是能好好說話的對象！\n連旁邊的士兵也是！」"
  },
  "96": {
   "text": "「嗚嗚嗚嗚……！」"
  },
  "97": {
   "text": "「這下只能逃了……！」"
  },
  "98": {
   "text": "「是啊，不過要分開行動。」"
  },
  "99": {
   "text": "「分、分開！？」"
  },
  "100": {
   "text": "「我瞄了一眼，這鎮子的巷子很窄。\n再加上我們對地形不熟，\n就會被對方如願以償地逼入絕境。」"
  },
  "101": {
   "text": "「這裡就讓機動性高的人數，分散逃跑！\n這樣應該也能讓追兵分散一些！」"
  },
  "102": {
   "text": "「和、和大家分開，這怎麼行……。」"
  },
  "103": {
   "text": "「抱歉，但別說『可是』了。\n小子，帶著平時那幫人跟我走！\n大膽鬼，你負責帶蕾雅和弗蘭她們！」"
  },
  "104": {
   "text": "「我、我！？……現在不是說這個的時候！\n這邊，走啦！」"
  },
  "105": {
   "text": "「等、等等——！」"
  },
  "106": {
   "text": "「咕嚕嚕嚕嚕！」"
  },
  "107": {
   "text": "「艾絲！」"
  },
  "108": {
   "text": "「……！」"
  },
  "109": {
   "text": "「赫斯佩拉和提奧交給你。\n關鍵時刻的判斷就交給你了。」"
  },
  "110": {
   "text": "「……明白了。」"
  },
  "111": {
   "text": "「厄、厄爾庇斯姊姊……。」"
  },
  "112": {
   "text": "「沒事的，提奧。\n來，騎上赫斯佩拉。」"
  },
  "113": {
   "text": "「……大家，平安無事！」"
  },
  "114": {
   "text": "「嗯，你們也是！」"
  },
  "115": {
   "text": "「好，我們也出發了！」"
  },
  "116": {
   "text": "「三組……嗎。」"
  },
  "117": {
   "text": "「情況有變。停止行動。」"
  },
  "118": {
   "text": "「志緒。」"
  },
  "119": {
   "text": "「更改命令。\n追擊目標是奏鐘士。」"
  },
  "120": {
   "text": "「剩下的兩組就交給你們了。」"
  },
  "121": {
   "text": "「明白了，穆迪亞。\n那我去負責癒術士。」"
  },
  "122": {
   "text": "「呵呵呵，那我就是多餘的人了嗎。\n好吧，就當個新來的聽話一點吧。」"
  },
  "123": {
   "text": "「那麼。」"
  },
  "124": {
   "text": "「追擊，開始。」"
  },
  "125": {
   "text": "「呼、呼……！」"
  },
  "126": {
   "text": "「啾啾！」"
  },
  "127": {
   "text": "「往那邊去了，追上去！」"
  },
  "128": {
   "text": "「包圍上去，逼他們就範！」"
  },
  "129": {
   "text": "「為什麼……！」"
  },
  "130": {
   "text": "「這嘛。\n我只知道，這個國家現在不太對勁。」"
  },
  "131": {
   "text": "「呀……！？」"
  },
  "132": {
   "text": "「這裡是國王身邊、王國的王都。\n這種地方的居民鬧得這麼大，\n國王不可能沒聽到。」"
  },
  "133": {
   "text": "「……！\n但是，沒有要阻止的跡象……。」"
  },
  "134": {
   "text": "「嗯，這大概是國王本人的命令，\n目前看來最合理。」"
  },
  "135": {
   "text": "「呀……！？」"
  },
  "136": {
   "text": "「接下來就是聯想遊戲了。\n既然首腦如此，整個國家受影響的可能性很大。\n喲，對不起啦！」"
  },
  "137": {
   "text": "「哇啊啊！？」"
  },
  "138": {
   "text": "「糟了，路被堵住了！讓開——！」"
  },
  "139": {
   "text": "「現在首要任務是逃出王都！\n但之後也要做好一路跑到底的準備！\n王都附近的城鎮，肯定都受國王控制。」"
  },
  "140": {
   "text": "「大、大家……！」"
  },
  "141": {
   "text": "「我教艾絲練劍時，\n也順便教了她幾招戰術。\n只要她記得，應該會優先考慮脫離王都。」"
  },
  "142": {
   "text": "「大膽鬼只要看懂狀況就能靈活應對。\n只要讓他護住重要的人，\n他就能順利脫身。」"
  },
  "143": {
   "text": "「你、你居然把大家的事都考慮到……。」"
  },
  "144": {
   "text": "「我只看跟戰鬥有關的事。」"
  },
  "145": {
   "text": "「……！停下！」"
  },
  "146": {
   "text": "「咦。」"
  },
  "147": {
   "text": "「喂！」"
  },
  "148": {
   "text": "「哇！？」"
  },
  "149": {
   "text": "「噗、噗！是、是沙子！？」"
  },
  "150": {
   "text": "「哎呀，沒想到你居然防住了剛才那招。」"
  },
  "151": {
   "text": "「看來，不是那麼好對付的嘛。」"
  },
  "152": {
   "text": "「唔、後方被擋住了呀！」"
  },
  "153": {
   "text": "「（站位選得真好。\n而且這聲音聽起來怪怪的……）」"
  },
  "154": {
   "text": "「呀呼呀呼，初次見面。\n我的名字是佩爾阿阿。」"
  },
  "155": {
   "text": "「（在那面具上裝了變聲術式吧？\n是不想暴露真身的意思嗎）」"
  },
  "156": {
   "text": "「這下真是承蒙關照了。\n我叫良巴。」"
  },
  "157": {
   "text": "「那？你們國王找我們有什麼事。」"
  },
  "158": {
   "text": "「真是的！\n偏偏對我們國王起疑心——！\n這種無禮之徒絕對不能原諒哦——！」"
  },
  "159": {
   "text": "「想拖時間是吧，抱歉，我可沒那個閒心。\n不回答的話我就直接闖過去了。」"
  },
  "160": {
   "text": "「……真是冷淡呢。\n不過，男人冷淡一點也沒關係啦。」"
  },
  "161": {
   "text": "「好啊。\n作為你發現幕後黑手的獎勵，稍微透露一點吧。\n下令逮捕你們的，確實是國王。」"
  },
  "162": {
   "text": "「然後再次自我介紹一下！我是佩爾阿阿。\n是榮耀的國王親衛隊成員哦！」"
  },
  "163": {
   "text": "「（親衛隊！\n這個國家的國王真的對我們……！？）」"
  },
  "164": {
   "text": "「喔，聽到這裡就夠了。\n多謝了——。」"
  },
  "165": {
   "text": "「嘛嘛嘛，請陪我把話說完……，」"
  },
  "166": {
   "text": "「嘿！」"
  },
  "167": {
   "text": "「呀呀！？有、有岩石塊過來了呀——！」"
  },
  "168": {
   "text": "「喂，小心！」"
  },
  "169": {
   "text": "「又、又是沙子……。\n對了，剛才那招也是這個吧！」"
  },
  "170": {
   "text": "「答對了。\n不過就算知道了，你也無能為力……吧！」"
  },
  "171": {
   "text": "「躲開，小鬼！」"
  },
  "172": {
   "text": "「哇哇哇哇！？梅露可，快蓋上蓋子——！」"
  },
  "173": {
   "text": "「收到呀——！」"
  },
  "174": {
   "text": "「哈哈哈，果然如我所料！\n那個瓶子里的小姐對你來說很重要呢。」"
  },
  "175": {
   "text": "「是吧。癒術士的<name>君？」"
  },
  "176": {
   "text": "「怎、怎麼知道我的名字！？」"
  },
  "177": {
   "text": "「……目標是小鬼！」"
  },
  "178": {
   "text": "「咦！？」"
  },
  "179": {
   "text": "「沒錯！\n趁此機會，我也來試試這種談判方式吧。」"
  },
  "180": {
   "text": "「如果你肯把他交出來，\n其他的事我也可以放過你們。\n覺得如何？」"
  },
  "181": {
   "text": "「這種條件怎麼可能答應呀——！」"
  },
  "182": {
   "text": "「啾！」"
  },
  "183": {
   "text": "「不行，別出來！」"
  },
  "184": {
   "text": "「而且，願意放過我們的只有你一個吧？」"
  },
  "185": {
   "text": "「呵呵呵，被發現了嗎？\n答對了，良巴君！」"
  },
  "186": {
   "text": "「嘿嘿，這當然知道啦！」"
  },
  "187": {
   "text": "「在那裡，包圍起來！」"
  },
  "188": {
   "text": "「把那邊的巷子也封住！」"
  },
  "189": {
   "text": "「看他們這麼狂熱，\n肯定不會放我們走的吧？」"
  },
  "190": {
   "text": "「哎呀，可不只是他們喔？」"
  },
  "191": {
   "text": "「特拉埃羅。特拉埃羅。」"
  },
  "192": {
   "text": "「呀，呀哇——！？」"
  },
  "193": {
   "text": "「又來了！」"
  },
  "194": {
   "text": "「對不起，真的非常對不起！\n剛才我下令逮捕你們了！\n啊，該怎麼辦才能阻止他們啊！」"
  },
  "195": {
   "text": "「喂，那傢伙性格真差！」"
  },
  "196": {
   "text": "「特拉埃羅！」"
  },
  "197": {
   "text": "「良巴先生，危險呀——！」"
  },
  "198": {
   "text": "「別擔心！」"
  },
  "199": {
   "text": "「……！？」"
  },
  "200": {
   "text": "「啊啊啊啊！？」"
  },
  "201": {
   "text": "「良、良、良，良巴——先生！」"
  },
  "202": {
   "text": "「啊，頭！頭是不是用力過頭了呀——！？」"
  },
  "203": {
   "text": "「別這樣，別輕蔑我！\n在那方面我一點都不擔心……！」"
  },
  "204": {
   "text": "「因為這些是粘土做的。」"
  },
  "205": {
   "text": "「黏、粘土！？」"
  },
  "206": {
   "text": "「雖然用衣服遮住了，但聞起來有土味。\n看好了，剛才那個傢伙。要動了。」"
  },
  "207": {
   "text": "「那、那怎麼可能……」"
  },
  "208": {
   "text": "「咳歐……。」"
  },
  "209": {
   "text": "「笨蛋是我！」"
  },
  "210": {
   "text": "「這、這到底是怎麼回事呀——！？」"
  },
  "211": {
   "text": "「那是你們不該知道的事……！」"
  },
  "212": {
   "text": "「前方又有岩石接近了呀！」"
  },
  "213": {
   "text": "「哇啊啊！？」"
  },
  "214": {
   "text": "「快點快點快點！」"
  },
  "215": {
   "text": "「喂！」"
  },
  "216": {
   "text": "「啾、啾啾～！」"
  },
  "217": {
   "text": "「包圍起來！\n抓住他們！」"
  },
  "218": {
   "text": "「逃、退路正被一一封鎖……！」"
  },
  "219": {
   "text": "「抱歉了，少年……！」"
  },
  "220": {
   "text": "「如果不把你們獻上，我們就……！」"
  },
  "221": {
   "text": "「切！\n既然如此就強行突破……！」"
  },
  "222": {
   "text": "「不，現在還太早。」"
  },
  "223": {
   "text": "「……！？」"
  },
  "224": {
   "text": "「這個聲音是……！」"
  },
  "225": {
   "text": "「哇啊！？」"
  },
  "226": {
   "text": "「子、子彈！？」"
  },
  "227": {
   "text": "「那裡……！」"
  },
  "228": {
   "text": "「……！？」"
  },
  "229": {
   "text": "「怎、怎麼了！？發生了什麼……！」"
  },
  "230": {
   "text": "「……！」"
  },
  "231": {
   "text": "「不能離開光源！\n她的目標是黑暗……！」"
  },
  "232": {
   "text": "「已經晚了。」"
  },
  "233": {
   "text": "「啊！？」"
  },
  "234": {
   "text": "「怎、怎麼了！？發生了什麼事！」"
  },
  "235": {
   "text": "「一片漆黑什麼都看不見……！」"
  },
  "236": {
   "text": "「……失算了。」"
  },
  "237": {
   "text": "「冷靜點！\n這麼黑，對方也動不了！」"
  },
  "238": {
   "text": "「確實，正常思考的話是這樣。\n但很可惜，她的眼睛並不普通。」"
  },
  "239": {
   "text": "「再黑的夜也能看得一清二楚，\n就像太陽在頭上照耀一樣……。」"
  },
  "240": {
   "text": "「點燈！」"
  },
  "241": {
   "text": "「」"
  },
  "242": {
   "text": "「……！？」"
  },
  "243": {
   "text": "「那群孩子……不在？」"
  },
  "244": {
   "text": "「自由地，四處走動。」"
  },
  "245": {
   "text": "「哎呀，又要被罵了嗎？」"
  },
  "246": {
   "text": "「呼、呼、呼……。」"
  },
  "247": {
   "text": "「再堅持一下。\n前面有地方可以調整呼吸。」"
  },
  "248": {
   "text": "「啊、是。謝謝……。」"
  },
  "249": {
   "text": "「不過，為什麼你會在這……？」"
  },
  "250": {
   "text": "「……這個問題的答案很簡單，<name>。」"
  },
  "251": {
   "text": "「因為我愛管閒事呀。」"
  },
  "252": {
   "text": "「原、原來如此？」"
  },
  "253": {
   "text": "「那、那個，之前沒來得及問……。\n請問你的名字是……？」"
  },
  "254": {
   "text": "「啊，抱歉。差點忘了。\n嗯，現在說名字應該沒問題了。」"
  },
  "255": {
   "text": "「我是法朱爾。請多指教。」"
  },
  "256": {
   "text": "「法朱爾……大人。」"
  },
  "257": {
   "text": "「哎呀哎呀，你們在幹嘛呢。\n早該一起行動了才對呀。」"
  },
  "258": {
   "text": "「啊，我是梅托特托。\n大家請多指教。」"
  },
  "259": {
   "text": "「請、請多指教。」"
  },
  "260": {
   "text": "「是呀……。」"
  },
  "261": {
   "text": "「啾……。」"
  },
  "262": {
   "text": "「雖然想感謝你們的幫助。\n但恕我無禮，請先告訴我。」"
  },
  "263": {
   "text": "「你們，是我們的盟友嗎？」"
  },
  "264": {
   "text": "「可以這麼認為。」"
  },
  "265": {
   "text": "「那麼，你們的身份是。」"
  },
  "266": {
   "text": "「良巴先生，我們被救了卻……，」"
  },
  "267": {
   "text": "「抱歉了，年輕人。\n我現在最優先的是保護你們。」"
  },
  "268": {
   "text": "「……。」"
  },
  "269": {
   "text": "「真是忠誠的臣下……不對，抱歉。\n原來你有同伴啊。」"
  },
  "270": {
   "text": "「有疑問是自然的。讓我回答吧。」"
  },
  "271": {
   "text": "「喂，法大人！」"
  },
  "272": {
   "text": "「不過，說了也是白說吧。\n坦白講，從法大人決定出手的那一刻起，\n結局就是這個走向嘛～。」"
  },
  "273": {
   "text": "「抱歉，梅托特托。」"
  },
  "274": {
   "text": "「不用了，沒有改意的抱歉就免了。\n來，趕快說明一下吧。\n馬上就要到號令的時間了哦。」"
  },
  "275": {
   "text": "「呀……？」"
  },
  "276": {
   "text": "「我有個作戰計畫。\n會在我的信號下啟動它。」"
  },
  "277": {
   "text": "「也就是說，對王的反叛。」"
  },
  "278": {
   "text": "「哈、反叛！？」"
  },
  "279": {
   "text": "「原來如此，你們是……。」"
  },
  "280": {
   "text": "「啊，我們就是所謂的抵抗軍。\n為了反對現行的王政而站起來的人。」"
  },
  "281": {
   "text": "「……而我是那裡的隊長。」"
  },
  "282": {
   "text": "「我是王女，法朱爾。」"
  },
  "283": {
   "text": "「哈啊——，是抵抗軍的隊長啊……，」"
  },
  "284": {
   "text": "「王女殿下……。」"
  },
  "285": {
   "text": "「……。」"
  },
  "286": {
   "text": "「欸欸欸欸欸欸！？」"
  },
  "287": {
   "text": "「法大人，時間到了！」"
  },
  "288": {
   "text": "「啊！發布號令！」"
  },
  "289": {
   "text": "「」"
  },
  "290": {
   "text": "「……動起來了。」"
  },
  "291": {
   "text": "「呵呵，分毫不差，準時執行。\n看來，你們帶來的情報，\n是正確的哦？」"
  },
  "292": {
   "text": "「能被相信真是太好了。\n好，在為時已晚之前行動吧。」"
  },
  "293": {
   "text": "「啊，我來這裡就是為了這個。\n走吧，同志們。」"
  },
  "294": {
   "text": "「抵抗軍，就在這裡殲滅。」"
  }
 },
 "warnings": []
}