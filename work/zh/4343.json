  },
  "55": {
   "text": "「啾～！」"
  },
  "56": {
   "text": "「圖圖！？」"
  },
  "57": {
   "text": "「啾啾～！」"
  },
  "58": {
   "text": "「弗羅羅洛！」"
  },
  "59": {
   "text": "「哇……好險！\n好危險……、」"
  },
  "60": {
   "text": "「嘎阿阿阿阿！」"
  },
  "61": {
   "text": "「啾嗚嗚嗚！」"
  },
  "62": {
   "text": "「」"
