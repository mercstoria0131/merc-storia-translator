 "lines": {
  "0": {
   "text": "「……、」"
  },
  "1": {
   "text": "「……？」"
  },
  "2": {
   "text": "「……。」"
  },
  "3": {
   "text": "「……你、我、背著……、」"
  },
  "4": {
   "text": "「別、別誤會了！\n我是山犬！\n所以，只是不會像人類那樣\n把你丟下不管而已！」"
  },
  "5": {
   "text": "「……不、不……、」"
  },
  "6": {
   "text": "「……？」"
  },
  "7": {
   "text": "「要、要吐了……、」"
  },
  "8": {
   "text": "「哈？」"
  },
  "9": {
   "text": "「搖動……、唔……、」"
  },
  "10": {
   "text": "「等、等一下笨蛋！\n我、我現在就把你放下來\n忍一……、」"
  },
  "11": {
   "text": "「放放放放放……、」"
  },
  "12": {
   "text": "「啊啊啊啊啊！」"
  },
  "13": {
   "text": "「……。」"
  },
  "14": {
   "text": "「……非常抱歉。」"
  },
  "15": {
   "text": "「……真是的，好累啊，\n今天就先在這裡休息……。」"
  },
  "16": {
   "text": "「啊、是……。」"
  },
  "17": {
   "text": "「……。」"
  },
  "18": {
   "text": "「……。\n那個，白天特地\n背著我運送上山，謝……、」"
  },
  "19": {
   "text": "「呼嚕。」"
  },
  "20": {
   "text": "「睡得好快啊！」"
  },
  "21": {
   "text": "「……。」"
  },
  "22": {
   "text": "「……嘛，也是啦。\n畢竟是背著我爬了山嘛……。」"
  },
  "23": {
   "text": "「……。」"
  },
  "24": {
   "text": "「……嗯嗯。」"
  },
  "25": {
   "text": "「好像在發抖……、」"
  },
  "26": {
   "text": "「而且好冷……！\n這樣肯定會感冒的……！\n就算我是肌肉男孩也會感冒！」"
  },
  "27": {
   "text": "「生個火吧……。」"
  },
  "28": {
   "text": "「……撿完柴火才想到，\n要怎麼生火啊……。」"
  },
  "29": {
   "text": "「……咦？\n紅色的光？\n難道是火把……？」"
  },
  "30": {
   "text": "「也就是說，有人……、」"
  },
  "31": {
   "text": "「咕嚕嚕嚕……、」"
  },
  "32": {
   "text": "「不在！」"
  },
  "33": {
   "text": "「咕嚕嚕嚕！」"
  },
  "34": {
   "text": "「哇哇哇哇……！」"
  },
  "35": {
   "text": "「……咦，不過來？」"
  },
  "36": {
   "text": "「……！\n那邊的方向是那個傢伙……、」"
  },
  "37": {
   "text": "「咕嚕嚕嚕！」"
  },
  "38": {
   "text": "「等等等，等一下！」"
  },
  "39": {
   "text": "「咕！？」"
  },
  "40": {
   "text": "「對，剛才丟柴火的是我……！\n不能讓它往那邊去……、」"
  },
  "41": {
   "text": "「咕嚕嚕嚕嚕……！」"
  },
  "42": {
   "text": "「嚇死我了，對不起對不起！\n說、說清楚就懂了！\n所以求求你！稍微等一下下！」"
  },
  "43": {
   "text": "「咕嚕嚕嚕嚕！」"
  },
  "44": {
   "text": "「咿啊啊啊啊！」"
  },
  "45": {
   "text": "「你在幹嘛啊！」"
  },
  "46": {
   "text": "「你剛才不是睡著了……、」"
  },
  "47": {
   "text": "「這種時候怎麼可能睡得著！」"
  },
  "48": {
   "text": "「是、也是啦……。」"
  },
  "49": {
   "text": "「哼！\n我才不是為了救人類才來的！\n只是吵得我睡不著而已！」"
  },
  "50": {
   "text": "「所以，人類給我退到後面去！」"
  },
  "51": {
   "text": "「不，治療之類的我也……、」"
  },
  "52": {
   "text": "「……我才不會跟人類一起戰鬥。\n那是夥伴該做的事。」"
  },
  "53": {
   "text": "「那，沒問題了。\n我打不過嘛！」"
  },
  "54": {
   "text": "「……、」"
  },
  "55": {
   "text": "「咕嚕嚕嚕！」"
  }
 },
 "warnings": []
