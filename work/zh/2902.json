  "6": {
   "text": "「～♪」"
  },
  "7": {
   "text": "「……。」"
  },
  "8": {
   "text": "「哇……。」"
  },
  "9": {
   "text": "「……呵呵呵呵。」"
  },
  "10": {
   "text": "「感謝各位的聆聽。\n小丑名為希斯魯。接下來一段時間……，」"
  },
  "11": {
   "text": "「希望能得到大家的注視。」"
  },
  "12": {
   "text": "「啊、啊……！」"
  },
  "13": {
   "text": "「喂，你臉紅什麼啦！」"
  },
  "14": {
   "text": "「啊！不不不，不是那個意思！」"
  },
  "15": {
   "text": "「哼，我才不管！\n好不容易來約會，真是讓人受不了！」"
  },
  "16": {
   "text": "「啊！等等我啦——！」"
  },
  "17": {
   "text": "「……。」"
  },
  "18": {
   "text": "「……。」"
  },
  "19": {
   "text": "「……。」"
  },
  "20": {
   "text": "「……呵呵呵。」"
  },
  "21": {
   "text": "「那麼，接下來將運用這四肢，\n為大家表演舞蹈。\n請盡情欣賞到最後哦。」"
  },
  "22": {
   "text": "「哇——！哇——！」"
  },
  "23": {
   "text": "「……♪　……♪」"
  },
  "24": {
   "text": "「……呼。」"
  },
  "25": {
   "text": "「哇……。」"
  },
  "26": {
   "text": "「感謝大家的觀賞。」"
  },
  "27": {
   "text": "「哇啊啊啊啊！」"
  },
  "28": {
   "text": "「哎呀，真是看呆了。\n這不是門票費，請收下吧！」"
  },
  "29": {
   "text": "「哇，看起來很好吃的麵包呢。\n……謝謝您，大叔。」"
  },
  "30": {
   "text": "「大叔！」"
  },
  "31": {
   "text": "「好，這個也給你！\n都帶走吧，希斯魯！」"
  },
  "32": {
   "text": "「呵呵，呵呵呵呵。\n這麼多，吃得完嗎……」"
  },
  "33": {
   "text": "「那麼，這個給你！」"
  },
  "34": {
   "text": "「呵呵，好開心。\n謝謝你，姐姐。」"
  },
  "35": {
   "text": "「哎，叫我姐姐什麼的！\n別這樣啦！」"
  },
  "36": {
   "text": "「喂，真狡猾！\n別從旁邊插隊啊！」"
  },
  "37": {
   "text": "「沒、沒關係！沒關係！\n我也看了希斯魯的舞蹈啊！」"
  },
  "38": {
   "text": "「呵呵，不可以吵架哦。\n你們都是好孩子。對吧？」"
  },
  "39": {
   "text": "「是！」"
  },
  "40": {
   "text": "「呵呵……。\n接下來要表演的是……」"
  },
  "41": {
   "text": "「大叔——！給我麵包——！」"
  },
  "42": {
   "text": "「啊，好！馬上來。」"
  },
  "43": {
   "text": "「咦……。」"
  },
  "44": {
   "text": "「抱歉啦，希斯魯！\n店裡沒人看管，我得回去。」"
  },
  "45": {
   "text": "「哎呀，都這個時間了！\n不行不行，該走了！」"
  },
  "46": {
   "text": "「……。」"
  },
  "47": {
   "text": "「希斯魯！\n阿嬤在那邊開料亭哦！\n結束後來吃吧！」"
  },
  "48": {
   "text": "「……啊，是這樣啊。」"
  },
  "49": {
   "text": "「……啊，是嗎。」"
  },
  "50": {
   "text": "「對哦。如果記得的話，就去拜訪一下。」"
  },
  "51": {
   "text": "「啊，太好了！得去打掃一下才行。」"
  },
  "52": {
   "text": "「……。」"
  },
  "53": {
   "text": "「……呼。」"
  },
  "54": {
   "text": "「那、那個……」"
  },
  "55": {
   "text": "「嗯？」"
  },
  "56": {
   "text": "「已經結束了嗎？」"
  },
  "57": {
   "text": "「……。」"
  },
  "58": {
   "text": "「……不，還能再表演給你看呢。」"
  },
  "59": {
   "text": "「太好了……！\n接下來能看什麼呢！」"
  },
  "60": {
   "text": "「那麼接下來就來點雜技吧。\n來，很危險的，請保持距離。」"
  },
  "61": {
   "text": "「好的！」"
  },
  "62": {
   "text": "「就是、就是……！就是這裡！」"
  },
  "63": {
   "text": "「哇啊啊啊啊啊！」"
  },
  "64": {
   "text": "「……呼。」"
  },
  "65": {
   "text": "「……好了，沒有魔法。\n是名副其實、毫無機關的魔術喔。」"
  },
  "66": {
   "text": "「好厲害！\n好厲害喔！」"
  },
  "67": {
   "text": "「……。」"
  },
  "68": {
   "text": "「來，表演還沒結束呢。\n接下來是……！」"
  },
  "69": {
   "text": "「大家——差不多該回家囉！」"
  },
  "70": {
   "text": "「啊，是媽媽！」"
  },
  "71": {
   "text": "「……要回去了嗎？」"
  },
  "72": {
   "text": "「嗯，不然會被罵的……。\n啊！這個玩具，謝謝你！」"
  },
  "73": {
   "text": "「姐姐，下次教我吹笛子吧！」"
  },
  "74": {
   "text": "「如果有下次的話。」"
  },
  "75": {
   "text": "「好耶，說好了喔！\n那，拜拜！」"
  },
  "76": {
   "text": "「……結果，大家都要走了呢。」"
  },
  "77": {
   "text": "「那，你不用回去嗎？\n小姑娘。」"
  },
  "78": {
   "text": "「啊，嗯……。」"
  },
  "79": {
   "text": "「沒關係，不用客氣。\n趁天黑前快回去吧。」"
  },
  "80": {
   "text": "「……不回去不行嗎？」"
  },
  "81": {
   "text": "「咦？」"
  },
  "82": {
   "text": "「……。」"
  },
  "83": {
   "text": "「……。」"
  },
  "84": {
   "text": "「不想回家嗎？」"
  },
  "85": {
   "text": "「因為和爸爸吵架了……。」"
  },
  "86": {
   "text": "「爸爸……非常生氣地罵了我。\n但是，但是！我絕對沒有錯……。」"
  },
  "87": {
   "text": "「所以，好難過……。」"
  },
  "88": {
   "text": "「哦。」"
  },
  "89": {
   "text": "「但是！那種心情呢。\n看著哥哥……啊？是姐姐嗎……。」"
  },
  "90": {
   "text": "「隨便你啦。用你喜歡的方式就好。」"
  },
  "91": {
   "text": "「那、哥哥！」"
  },
  "92": {
   "text": "「嗯。看著我怎麼了？」"
  },
  "93": {
   "text": "「看著哥哥，難過就消失了！\n你給我看了好多東西對吧？\n所以我，心情變得很開心！」"
  },
  "94": {
   "text": "「我想一直看著你。」"
  },
  "95": {
   "text": "「……喂，小姑娘。」"
  },
  "96": {
   "text": "「嗚嗚……。」"
  },
  "97": {
   "text": "「吃點麵包吧。」"
  },
  "98": {
   "text": "「咦？」"
  },
  "99": {
   "text": "「肚子餓了吧。\n從我開始表演以來，\n你就一直待在這裡嘛。」"
  },
  "100": {
   "text": "「來，吃點你喜歡的。\n剛才咬了一口，味道還滿不錯的。」"
  },
  "101": {
   "text": "「可以嗎……？」"
  },
  "102": {
   "text": "「這是給我的呀。\n而且一個人也吃不完嘛。」"
  },
  "103": {
   "text": "「那、那個不是重點！」"
  },
  "104": {
   "text": "「……我可以留下來嗎？」"
  },
  "105": {
   "text": "「……現在觀眾只剩你了。」"
  },
  "106": {
   "text": "「有想看的節目嗎？想看什麼就表演給你。」"
  },
  "107": {
   "text": "「……！」"
  },
  "108": {
   "text": "「那、那就再聽一次歌吧！」"
  },
  "109": {
   "text": "「沒問題。\n那麼，我作的歌……。」"
  },
  "110": {
   "text": "「～♪」"
  },
  "111": {
   "text": "「哇……！」"
  },
  "112": {
   "text": "「……～♪ 好了，結束了。」"
  },
  "113": {
   "text": "「再唱一次！再聽一次！」"
  },
  "114": {
   "text": "「呵呵，還想聽？\n我還會唱很多其他歌哦。」"
  },
  "115": {
   "text": "「不要，沒關係！我就喜歡這首！」"
  },
  "116": {
   "text": "「這樣啊。\n那讓我稍微休息一下好嗎。\n這樣才能繼續唱哦。」"
  },
  "117": {
   "text": "「當然！\n啊，對了！坐這裡，這裡！」"
  },
  "118": {
   "text": "「呵呵，你真可愛。\n要是再大一點，我可能也會著迷呢。」"
  },
  "119": {
   "text": "「……星星出來了呢。」"
  },
  "120": {
   "text": "「啊……。」"
  },
  "121": {
   "text": "「我可沒有說讓你回去哦。」"
  },
  "122": {
   "text": "「真的……？」"
  },
  "123": {
   "text": "「因為你不想回家吧？\n那我怎麼都好啦。」"
  },
  "124": {
   "text": "「……。」"
  },
  "125": {
   "text": "「……哥哥不用回去嗎？」"
  },
  "126": {
   "text": "「我？嗯，不用啦。」"
  },
  "127": {
   "text": "「家人不會擔心嗎？」"
  },
  "128": {
   "text": "「呵呵，難道你是希望我回去嗎？」"
  },
  "129": {
   "text": "「才、才沒有！」"
  },
  "130": {
   "text": "「只是覺得一直挽留你不太好……。」"
  },
  "131": {
   "text": "「不用在意。\n我沒有那種會讓人安心的家人哦。」"
  },
  "132": {
   "text": "「……哥哥也吵架了嗎？」"
  },
  "133": {
   "text": "「才沒有。\n我從來沒有和任何家人吵過架哦。」"
  },
  "134": {
   "text": "「這樣啊……。真好呢。」"
  },
  "135": {
   "text": "「呵呵，也許吧。」"
  },
  "136": {
   "text": "「……啊，不過。\n我沒有告訴那些人就出來了呢。」"
  },
  "137": {
   "text": "「誰？」"
  },
  "138": {
   "text": "「嗯……算是夥伴吧。\n一時興起去介紹所用了下服務。」"
  },
  "139": {
   "text": "「感覺不太對勁，就把他們丟下了。」"
  },
  "140": {
   "text": "「是討厭的人嗎？」"
  },
  "141": {
   "text": "「不，他們兩個都是好人。\n雖然不知道其中一個是不是人類。\n但至少，他們有在看著我。」"
  },
  "142": {
   "text": "「但那兩個人不行。\n畢竟最後，他們還是會互相看著對方吧。」"
  },
  "143": {
   "text": "「……？」"
  },
  "144": {
   "text": "「意思是，我想要的東西，\n從那兩個人那裡拿不到哦。」"
  },
  "145": {
   "text": "「這樣啊……。\n不太懂，但好可惜呢。」"
  },
  "146": {
   "text": "「那，我給不了你嗎？\n當作聽了那麼多歌的謝禮！」"
  },
  "147": {
   "text": "「……這樣嗎？那我就收下吧。」"
  },
  "148": {
   "text": "「咦？」"
  },
  "149": {
   "text": "「喂，大小姐。你叫什麼名字？」"
  },
  "150": {
   "text": "「米扎……。」"
  },
  "151": {
   "text": "「那麼，米扎。\n如果你不想回去的話，就跟我一起……」"
  },
  "152": {
   "text": "「喂——米扎！米扎！」"
  },
  "153": {
   "text": "「……！爸爸？」"
  },
  "154": {
   "text": "「是爸爸……。」"
  },
  "155": {
   "text": "「……。」"
  },
  "156": {
   "text": "「為什麼……，是來發脾氣的嗎？」"
  },
  "157": {
   "text": "「……不知道呢。\n聽起來不像是生氣的聲音。」"
  },
  "158": {
   "text": "「可能是擔心你，所以來找你吧。」"
  },
  "159": {
   "text": "「擔心我……？」"
  },
  "160": {
   "text": "「明明說了那麼過分的話……。」"
  },
  "161": {
   "text": "「……原來不是為你啊。」"
  },
  "162": {
   "text": "「去吧。去見你重要的人吧。」"
  },
  "163": {
   "text": "「等等，可是還沒和哥哥談完……！」"
  },
  "164": {
   "text": "「……哥哥？」"
  },
  "165": {
   "text": "「……結果還是回來了啊。」"
  },
  "166": {
   "text": "「唉，好累……。\n回答點歌真是虧大了呢。」"
  },
  "167": {
   "text": "「……真是虧大了呢。」"
  },
  "168": {
   "text": "「希斯魯？」"
  },
  "169": {
   "text": "「……！」"
  },
  "170": {
   "text": "「果然是希斯魯！」"
  },
  "171": {
   "text": "「呀～，你去哪裡了呀！？」"
  },
  "172": {
   "text": "「你們……。」"
  },
  "173": {
   "text": "「為什麼在這裡？今天不是出發日嗎？」"
  },
  "174": {
   "text": "「什……！你記得啊！？」"
  },
  "175": {
   "text": "「嗯。」"
  },
  "176": {
   "text": "「嗯什麼……。\n你剛才去哪裡了啦！」"
  },
  "177": {
   "text": "「隔壁鎮而已。」"
  },
  "178": {
   "text": "「什麼！？」"
  },
  "179": {
   "text": "「難怪把整個鎮子找遍了，\n也找不到人呢……。」"
  },
  "180": {
   "text": "「……為什麼不跟著我們走？」"
  },
  "181": {
   "text": "「呀。你、你問我為什麼……。」"
  },
  "182": {
   "text": "「你願意成為我們的……夥伴吧？」"
  },
  "183": {
   "text": "「……。」"
  },
  "184": {
   "text": "「總之，明天一定要出發，\n別再不見人了喔？」"
  },
  "185": {
   "text": "「嗯～，現在還找得到住宿嗎……。」"
  },
  "186": {
   "text": "「……廉價旅店大概都客滿了，\n但高級旅館應該還有空房吧？反正很貴嘛。」"
  },
  "187": {
   "text": "「不不不，我哪有那種錢……。」"
  },
  "188": {
   "text": "「沒關係。我請客。」"
  },
  "189": {
   "text": "「咦？」"
  },
  "190": {
   "text": "「嘛，反正讓你們等這麼久，\n總得賠罪一下才行。」"
  },
  "191": {
   "text": "「……我自己其實也挺開心的啦。」"
  },
  "192": {
   "text": "「這話是什麼意思……？」"
  },
  "193": {
   "text": "「呼～，怎麼說呢？我也不太清楚～。\n好啦好啦，走吧。我有點睏了。」"
  },
  "194": {
   "text": "「呀呀！人已經走掉了呢！」"
  },
  "195": {
   "text": "「等、等一下，希斯魯！」"
  },
  "196": {
   "text": "「「等一下……」\n明明最重要的人就在身邊……。」"
  },
  "197": {
   "text": "「真奇怪。」"
  }
 },
