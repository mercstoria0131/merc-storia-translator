 "lines": {
  "0": {
   "text": "「喂！」"
  },
  "1": {
   "text": "「咦……？」"
  },
  "2": {
   "text": "「你沒事吧！？」"
  },
  "3": {
   "text": "「那黑色的羽毛……、六象！？」"
  },
  "4": {
   "text": "「怎麼會知道我的名字……、」"
  },
  "5": {
   "text": "「不對，你是……、雄鶴！？」"
  },
  "6": {
   "text": "「魔、魔寵！」"
  },
  "7": {
   "text": "「是呀！」"
  },
  "8": {
   "text": "「梅露可！？」"
  },
  "9": {
   "text": "「而且，那個女孩是……、\n被綁架的村莊孩子……！？」"
  },
  "10": {
   "text": "「天、天狗啊啊啊！？」"
  },
  "11": {
   "text": "「真是的！\n一天要重演幾次這種場面啊！」"
  },
  "12": {
   "text": "「六象，你竟然要綁架……！\n六年內就變了嗎！？」"
  },
  "13": {
   "text": "「我說！才不是那樣啊啊啊！」"
  },
  "14": {
   "text": "「呼嗚嗚嗚！」"
  },
  "15": {
   "text": "「喂，會說話的水。」"
  },
  "16": {
   "text": "「才不是會說話的水！我是梅露可呀！」"
  },
  "17": {
   "text": "「知道了，梅露可。\n這傢伙就是你要找的，<name>吧。」"
  },
  "18": {
   "text": "「是呀！」"
  },
  "19": {
   "text": "「喂，<name>。」"
  },
  "20": {
   "text": "「是、是！」"
  },
  "21": {
   "text": "「把梅露可還給你！」"
  },
  "22": {
   "text": "「啊，謝、謝謝……？」"
  },
  "23": {
   "text": "「<name>先生！」"
  },
  "24": {
   "text": "「梅露可！平安無事就好……。」"
  },
  "25": {
   "text": "「還有雄鶴！」"
  },
  "26": {
   "text": "「幹嘛！？」"
  },
  "27": {
   "text": "「這小鬼就拜託你了！」"
  },
  "28": {
   "text": "「哇！？」"
  },
  "29": {
   "text": "「喂！對孩子要更禮貌一點！」"
  },
  "30": {
   "text": "「吵死了，現在不是說這個的時候吧！」"
  },
  "31": {
   "text": "「呼嗚嗚！」"
  },
  "32": {
   "text": "「沒想到領地擴張到這種程度……。」"
  },
  "33": {
   "text": "「嘁。」"
  },
  "34": {
   "text": "「先不管細節！\n你們全部躲到岩石陰影裡去！風又要來了！」"
  },
  "35": {
   "text": "「又要來？」"
  },
  "36": {
   "text": "「呼嗚嗚！」"
  },
  "37": {
   "text": "「主人，那隻天狗說得對，風要來了！」"
  },
  "38": {
   "text": "「那隻天狗……就像六象先生說的，\n我們還是躲起來比較安全。」"
  },
  "39": {
   "text": "「是的，我同意。」"
  },
  "40": {
   "text": "「那隻天狗……\n跟傳聞不同，似乎願意幫助我們……？」"
  },
  "41": {
   "text": "「六象是……六年前救過我的恩人。」"
  },
  "42": {
   "text": "「呀！？是這樣嗎！？」"
  },
  "43": {
   "text": "「好。」"
  },
  "44": {
   "text": "「剛才看到你們跟著梅露可，\n我還以為這六年間他變了心，\n變成綁架人類的壞蛋了……」"
  },
  "45": {
   "text": "「看來一點都沒變。什麼都沒變。」"
  },
  "46": {
   "text": "「廢話真多！快躲起來！\n不然就跑去村子那邊！」"
  },
  "47": {
   "text": "「可是，只留下他一個人……」"
  },
  "48": {
   "text": "「對付這傢伙，我一個就夠了！」"
  },
  "49": {
   "text": "「……我明白了。」"
  },
  "50": {
   "text": "「大家，先暫時撤退吧。」"
  },
  "51": {
   "text": "「好。」"
  },
  "52": {
   "text": "「梅露可，剛才對不起。\n下次絕對不會再讓你離開我的手了。」"
  },
  "53": {
   "text": "「謝謝你，<name>先生！」"
  },
  "54": {
   "text": "「你是初音吧。」"
  },
  "55": {
   "text": "「嗯、嗯。」"
  },
  "56": {
   "text": "「躲在我身後。絕對不要離開！」"
  },
  "57": {
   "text": "「我、我知道了！」"
  },
  "58": {
   "text": "「呼嗚嗚！」"
  },
  "59": {
   "text": "「風要來了！」"
  },
  "60": {
   "text": "「以毒攻毒。那麼我……」"
  },
  "61": {
   "text": "「就以風制風！」"
  },
  "62": {
   "text": "「呼嗚嗚嗚！」"
  },
  "63": {
   "text": "「哈啊啊啊！」"
  },
  "64": {
   "text": "「好厲害，風和風撞在一起……」"
  },
  "65": {
   "text": "「兩邊都消失了呀！」"
  },
  "66": {
   "text": "「薩克梅！\n這些傢伙不會對你為非作歹！\n你回原本的地方去！」"
  },
  "67": {
   "text": "「呼嗚嗚嗚嗚！」"
  },
  "68": {
   "text": "「該死……！\n它的情緒激動到連我的聲音都聽不進去嗎……！」"
  },
  "69": {
   "text": "「呼嗚嗚嗚嗚嗚！」"
  },
  "70": {
   "text": "「休想！」"
  },
  "71": {
   "text": "「要是六象能制住\n那隻魔寵的動作，\n我就能馬上施展癒術了……！」"
  },
  "72": {
   "text": "「主人，現在很危險！\n那隻天狗……正如六象大人所說，\n我們應該往村莊的方向跑……」"
  },
  "73": {
   "text": "「呼嗚嗚嗚嗚！」"
  },
  "74": {
   "text": "「糟了！」"
  },
  "75": {
   "text": "「呼嗚嗚嗚嗚嗚！」"
  },
  "76": {
   "text": "「不妙，照這樣下去\n六象會被那隻魔寵抓住……！」"
  },
  "77": {
   "text": "「六象！」"
  },
  "78": {
   "text": "「六象大人！」"
  },
  "79": {
   "text": "「呼嗚嗚嗚！？」"
  },
  "80": {
   "text": "「」"
  },
  "81": {
   "text": "「你、們……。」"
  },
  "82": {
   "text": "「沒事吧，六象！」"
  },
  "83": {
   "text": "「您平安無事！」"
  },
  "84": {
   "text": "「為什麼要救我。我……」"
  },
  "85": {
   "text": "「因為六年前，恩人曾對我說：『要變強』。」"
  },
  "86": {
   "text": "「雄鶴大人是我們的同伴。\n幫助那位恩人是理所當然的！」"
  },
  "87": {
   "text": "「多虧你了，剎那大人。」"
  },
  "88": {
   "text": "「不，對身為忍者的我來說，這不算什麼！\n雄鶴大人才是，表現得真精彩。」"
  },
  "89": {
   "text": "「謝謝。能展現出修練的成果，真好。」"
  },
  "90": {
   "text": "「哈。小鬼成長得真快啊。」"
  },
  "91": {
   "text": "「喂。我已經不是小孩子了！」"
  },
  "92": {
   "text": "「……你還記得我說的話啊，雄鶴。」"
  },
  "93": {
   "text": "「咦？」"
  },
  "94": {
   "text": "「沒什麼。」"
  },
  "95": {
   "text": "「身為天狗，不能再讓你看見我丟臉的樣子了！」"
  },
  "96": {
   "text": "「薩克梅！\n由我來再次對上你！」"
  },
  "97": {
   "text": "「呼嗚嗚嗚嗚嗚！」"
  },
  "98": {
   "text": "「哈啊啊啊啊啊！」"
  },
  "99": {
   "text": "「呼嗚嗚？！」"
  },
  "100": {
   "text": "「魔寵的動作完全停住了！」"
  },
  "101": {
   "text": "「<name>，就是現在！」"
  },
  "102": {
   "text": "「好，我知道了！」"
  }
 },
