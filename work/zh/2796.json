 "model": "ollama:qwen3.8:27b",
 "time": "2026-11-06 01:07:18",
 "lines": {
  "0": {
   "text": "「嗚嚕嚕嚕嚕嚕！」"
  },
  "1": {
   "text": "「沙美嗚嗚嗚嗚嗚！？」"
  },
  "2": {
   "text": "「蕾雅姊姊，用威嚇來解決吧！\n一、二！」"
  },
  "3": {
   "text": "「連續發射！」"
  },
  "4": {
   "text": "「沙美嗚嗚嗚嗚嗚！？」"
  },
  "5": {
   "text": "「好厲害呀！\n進度一直在推進呀！」"
  },
  "6": {
   "text": "「哈哈！\n完美配合嘛！」"
  },
  "7": {
   "text": "「不過嘛……，\n這種移動方式真的沒問題嗎，蕾雅。\n要是讓我這種大叔背著你……，」"
  },
  "8": {
   "text": "「雖、雖然有點害羞，但我沒關係啦！」"
  },
  "9": {
   "text": "「而且是我沒辦法騎在赫斯佩拉身上，\n這全是我的錯……。呵呵，真是給你們添麻煩了……。」"
  },
  "10": {
   "text": "「嗚嚕嚕……。」"
  },
  "11": {
   "text": "「嘛，既然蕾雅你沒意見，那就這樣吧。」"
  },
  "12": {
   "text": "「話說回來，那個姿勢真的沒問題嗎？\n剛才你說只要擺出姿勢就能攻擊，\n是這樣嗎……。」"
  },
  "13": {
   "text": "「啊，嗯。\n沒有姿勢也能攻擊。」"
  },
  "14": {
   "text": "「欸……。」"
  },
  "15": {
   "text": "「不過，我想積極地展現出來。\n因為我在意識著我最推的激情玫瑰，\n多虧這樣，攻擊期間會暫時進入蘿絲狀態……，」"
  },
  "16": {
   "text": "「因為能瞬間忘記魔寵的事！」"
  },
  "17": {
   "text": "「繞了一圈後，\n蕾雅姐姐看起來變得堅強了……。」"
  },
  "18": {
   "text": "「大概現在只是為了不昏過去而亢奮著吧。\n換個說法就是……、自暴自棄。」"
  },
  "19": {
   "text": "「自暴自棄啊……。」"
  },
  "20": {
   "text": "「好，出發！住在黑暗中的可憐傢伙們！\n我要為你們帶來光的樂趣！」"
  },
  "21": {
   "text": "「愛與希望的使者，激情玫瑰！\n哇哈哈！哇哈哈哈！」"
  },
  "22": {
   "text": "「好，有這股幹勁就好，激情玫瑰什麼的。\n說真的，你是關鍵人物，所以給我認真點。」"
  },
  "23": {
   "text": "「交給我吧，怪人紳士風！」"
  },
  "24": {
   "text": "「那傢伙絕對不受歡迎。」"
  },
  "25": {
   "text": "「……！\n馬上就要到我和赫斯佩拉被趕走的地方了！」"
  },
  "26": {
   "text": "「也就是說，再往前就是……！」"
  },
  "27": {
   "text": "「沙美嗚嗚嗚嗚嗚！」"
  },
  "28": {
   "text": "「……，比剛才的數量多了一倍都不止！」"
  },
  "29": {
   "text": "「嘎！」"
  },
  "30": {
   "text": "「抱歉，請撐住！」"
  },
  "31": {
   "text": "「我、我會努力的呀！\n激情玫瑰！」"
  },
  "32": {
   "text": "「<name>同學……，」"
  },
  "33": {
   "text": "「是我嗎？」"
  },
  "34": {
   "text": "「如果在句尾加上『yujy』的話，\n我就有干勁了……。」"
  },
  "35": {
   "text": "「完全不知道哪裡能加油的yujy。」"
  },
  "36": {
   "text": "「適應得真快的yujy。」"
  },
  "37": {
   "text": "「已經傳過來的yujy哦。」"
  },
  "38": {
   "text": "「Yujy好多！\n謝謝！啊，不過給那兩人的是別的角色……，」"
  },
  "39": {
   "text": "「雷耶桑——！」"
  },
  "40": {
   "text": "「對、對不起！」"
  },
  "41": {
   "text": "「……！\n不行，道路沒有打開多少！」"
  },
  "42": {
   "text": "「那、那就提高輸出……，」"
  },
  "43": {
   "text": "「請等一下！\n再這樣下去，夏薩伊爾那邊的傷害會……！」"
  },
  "44": {
   "text": "「但、但是，這樣下去的話！」"
  },
  "45": {
   "text": "「沙美嗚嗚嗚嗚嗚！」"
  },
  "46": {
   "text": "「總之，先回去調整態勢……，」"
  },
  "47": {
   "text": "「……魯魯？」"
  },
  "48": {
   "text": "「赫斯佩拉？」"
  },
  "49": {
   "text": "「……啾！」"
  },
  "50": {
   "text": "「啾啾——！」"
  },
  "51": {
   "text": "「巴嘎巴嘎巴嘎。」"
  },
  "52": {
   "text": "「嗚魯魯！」"
  },
  "53": {
   "text": "「嗚魯魯魯魯魯！」"
  },
  "54": {
   "text": "「哇啊！？」"
  },
  "55": {
   "text": "「加、加速了！？\n提奧，別掉下去！」"
  },
  "56": {
   "text": "「咿啊啊啊啊！？」"
  },
  "57": {
   "text": "「情況不妙，直接衝進去的話……！」"
  },
  "58": {
   "text": "「……不對，等等，這個味道是！」"
  },
  "59": {
   "text": "「嗯？」"
  },
  "60": {
   "text": "「……沙梅！？」"
  },
  "61": {
   "text": "「沙啊啊啊、梅啊啊啊啊～。」"
  },
  "62": {
   "text": "「它醉了呢……！」"
  },
  "63": {
   "text": "「那麼就……！」"
  },
  "64": {
   "text": "「……這個，得再自動化一點才行。\n明明是緊急用的，啟動步驟卻多到不行。」"
  },
  "65": {
   "text": "「總之這次，\n多虧大家的努力才勉強撐過來了。\n好，辛苦了～。」"
  },
  "66": {
   "text": "「謝、謝謝大家～。」"
  },
  "67": {
   "text": "「不過，還沒結束呢……！\n大家～，去保護魔寵吧～……。」"
  },
  "68": {
   "text": "「喔～……。」"
  },
  "69": {
   "text": "「沙梅啊啊～。」"
  },
  "70": {
   "text": "「沒想到會被逼到這種地步。」"
  },
  "71": {
   "text": "「算是意料之外吧。」"
  },
  "72": {
   "text": "「是啊，當醫生從下半身突然撲過來時，\n我還真是嚇了一跳呢。」"
  },
  "73": {
   "text": "「像人魚一樣吧？」"
  },
  "74": {
   "text": "「請向全國懷抱憧憬的少女以及我道歉。」"
  },
  "75": {
   "text": "「呼、呼……。\n好，我現在就去支援<name>他們……，」"
  },
  "76": {
   "text": "「……呃。」"
  },
  "77": {
   "text": "「站穩。」"
  },
  "78": {
   "text": "「對、對不起……。」"
  },
  "79": {
   "text": "「別擔心，那邊沒問題的。\n<name>他們，一定會好好處理的。」"
  },
  "80": {
   "text": "「而且……，」"
  },
  "81": {
   "text": "「梅啊啊啊～……。」"
  },
  "82": {
   "text": "「好，趁現在衝過去！\n在它酒醒之前就是勝負關鍵！」"
  },
  "83": {
   "text": "「赫斯佩拉，交給你囉！」"
  },
  "84": {
   "text": "「嗚魯魯！」"
  },
  "85": {
   "text": "「沙、沙啊啊……，」"
  },
  "86": {
   "text": "「……梅啊啊啊啊！」"
  },
  "87": {
   "text": "「嗚魯魯！」"
  },
  "88": {
   "text": "「呀呀！這太厲害了……。\n下面全都看得一清二楚呢！」"
  },
  "89": {
   "text": "「對吧對吧？好厲害呀！」"
  },
  "90": {
   "text": "「接下來就是直線衝刺！\n沒問題的！」"
  },
  "91": {
   "text": "「呼、終於要到了呢……。」"
  },
  "92": {
   "text": "「辛苦了。\n多虧你走到這裡，雷耶先生。」"
  },
  "93": {
   "text": "「呵呵……我也謝謝你。\n多虧有你，心裡輕鬆了不少呢。」"
  },
  "94": {
   "text": "「對了，厄爾庇斯。\n如果可以的話，我想把你敲鐘的樣子畫下來……，」"
  },
  "95": {
   "text": "「啾啾——！」"
  },
  "96": {
   "text": "「下面呢！」"
  },
  "97": {
   "text": "「……！」"
  },
  "98": {
   "text": "「沙啊啊啊……！」"
  },
  "99": {
   "text": "「梅啊啊啊啊！」"
  },
  "100": {
   "text": "「哇啊啊啊！？」"
  },
  "101": {
   "text": "「什、從下面衝上來的！？\n不過，能飛過來其實也不奇怪啦！」"
  },
  "102": {
   "text": "「赫斯佩拉，沒事吧？」"
  },
  "103": {
   "text": "「嗚魯魯！」"
  },
  "104": {
   "text": "「太好了……。」"
  },
  "105": {
   "text": "「……！<name>和梅露可呢！？」"
  },
  "106": {
   "text": "「沒事！」"
  },
  "107": {
   "text": "「我們只是從赫斯佩拉身上掉下來而已。\n完全沒事的！」"
  },
  "108": {
   "text": "「呼、先等一下，我馬上……！」"
  },
  "109": {
   "text": "「不行，你先走！」"
  },
  "110": {
   "text": "「沙梅啊啊啊啊！」"
  },
  "111": {
   "text": "「呀啊啊啊！」"
  },
  "112": {
   "text": "「抓穩了……！」"
  },
  "113": {
   "text": "「咕、唔唔唔！\n不、你不是喝醉了嗎！？」"
  },
  "114": {
   "text": "「大部分確實都醉了。\n但離噴霧器太遠，或是個體差異吧！\n有些傢伙藥效太弱了！」"
  },
  "115": {
   "text": "「沙梅啊啊啊！」"
  },
  "116": {
   "text": "「哇！」"
  },
  "117": {
   "text": "「二、三、四……，\n該死，還有更多！」"
  },
  "118": {
   "text": "「大家！」"
  },
  "119": {
   "text": "「你先走，厄爾庇斯！\n這裡交給我們來擋住！」"
  },
  "120": {
   "text": "「跟王國時一樣呀！\n只要厄爾庇斯敲鐘，\n局勢就會好轉的呀！」"
  },
  "121": {
   "text": "「……我明白了。\n提奧，抓穩了！」"
  },
  "122": {
   "text": "「你、你是認真的！？」"
  },
  "123": {
   "text": "「我是認真的！\n赫斯佩拉，請全速前進！」"
  },
  "124": {
   "text": "「嗚嚕嚕嚕嚕！」"
  },
  "125": {
   "text": "「……就拜託你了，厄爾庇斯。」"
  },
  "126": {
   "text": "「沙美嗚嗚嗚嗚嗚！」"
  },
  "127": {
   "text": "「……！」"
  },
  "128": {
   "text": "「……就算敲鐘，\n我們的局勢也不會好轉吧？」"
  },
  "129": {
   "text": "「為、為什麼……？」"
  },
  "130": {
   "text": "「因為那樣的話，\n世界鐘就會從那些傢伙的目標中移除。\n到時候，未被治癒的魔寵的目標就會……」"
  },
  "131": {
   "text": "「……謊話。」"
  },
  "132": {
   "text": "「如果在他們醉倒期間能脫離就好……」"
  },
  "133": {
   "text": "「厄爾庇斯應該也明白。\n他一定會回來救我們的呀！」"
  },
  "134": {
   "text": "「當然，圖魯太郎也心知肚明。\n但現在已經有這麼多清醒的人了。\n還是得預備最壞的情況。」"
  },
  "135": {
   "text": "「呀……」"
  },
  "136": {
   "text": "「沙梅啊啊啊！」"
  },
  "137": {
   "text": "「呀啊！」"
  },
  "138": {
   "text": "「抱歉，雷耶小姐。圖魯塔。\n把你們捲入我們的麻煩裡……」"
  },
  "139": {
   "text": "「……」"
  },
  "140": {
   "text": "「嘻、呵呵，你在說什麼呢？\n我可不是那種會抱怨\n自己主動捲入麻煩的人哦。」"
  },
  "141": {
   "text": "「而、而且還沒結束呢！」"
  },
  "142": {
   "text": "「沙梅啊啊！」"
  },
  "143": {
   "text": "「……嗚～」"
  },
  "144": {
   "text": "「跟畫家小姐一樣。」"
  },
  "145": {
   "text": "「不過，我並不是先生的旅伴。\n最後就算拋棄你們，也請別記恨我。」"
  },
  "146": {
   "text": "「圖魯塔……」"
  },
  "147": {
   "text": "「哦，終於說真心話了。\n老頭子我比較喜歡坦率的圖魯太郎。」"
  },
  "148": {
   "text": "「多謝。\n抱歉，我這人挺薄情的。」"
  },
  "149": {
   "text": "「但我也有自己的旅行目的。」"
  },
  "150": {
   "text": "「啊，當然。\n居然能陪我們走到這裡，真的謝謝你。」"
  },
  "151": {
   "text": "「……」"
  },
  "152": {
   "text": "「雷耶小姐，也謝謝你。」"
  },
  "153": {
   "text": "「不、不客……。」"
  },
  "154": {
   "text": "「還有……巴嘎巴嘎也。」"
  },
  "155": {
   "text": "「巴嘎巴嘎。」"
  },
  "156": {
   "text": "「沙梅啊啊啊！」"
  },
  "157": {
   "text": "「……良巴先生。\n這個……您覺得如何？」"
  },
  "158": {
   "text": "「嘛，確實不太妙。\n怎麼想，都覺得難逃一劫。」"
  },
  "159": {
   "text": "「……不過，我可沒打算坐以待斃。\n讓旅程在這裡結束？我才不幹。」"
  },
  "160": {
   "text": "「年輕人你也一樣吧？\n總得去見見大將，應該也有該回的家。」"
  },
  "161": {
   "text": "「……有的。」"
  },
  "162": {
   "text": "「那就別放棄了！\n喔啦！」"
  },
  "163": {
   "text": "「沙美！？」"
  },
  "164": {
   "text": "「在！」"
  },
  "165": {
   "text": "「啾啾——！」"
  },
  "166": {
   "text": "「呀！我來了！」"
  },
  "167": {
   "text": "「好，癒術……！」"
  },
  "168": {
   "text": "「……！」"
  },
  "169": {
   "text": "「沙梅啊啊啊啊啊！」"
  },
  "170": {
   "text": "「同時三隻……！？」"
  },
  "171": {
   "text": "「（這樣連阻止碰撞都……！）」"
  },
  "172": {
   "text": "「」"
  },
  "173": {
   "text": "「」"
  },
  "174": {
   "text": "「」"
  },
  "175": {
   "text": "「……！」"
  },
  "176": {
   "text": "「還沒……結束……！」"
  },
  "177": {
   "text": "「就是這樣呀，<name>先生！\n沒錯，如果是漫畫，這裡……！」"
  },
  "178": {
   "text": "「如果是Pri♡Fi，在這裡……！」"
  },
  "179": {
   "text": "「主角會覺醒，脫離險境！」"
  },
  "180": {
   "text": "「真是……！」"
  },
  "181": {
   "text": "「……對不起！」"
  },
  "182": {
   "text": "「是啊。現實不是漫畫。\n人類不會那麼輕易覺醒，\n光靠心意，也有無能為力的情況。」"
  },
  "183": {
   "text": "「所以……，也需要力量。」"
  },
  "184": {
   "text": "「為了守護心意，而需要的力量！」"
  },
  "185": {
   "text": "「」"
  },
  "186": {
   "text": "「」"
  },
  "187": {
   "text": "「阿哈哈哈！」"
  },
  "188": {
   "text": "「薩啊啊啊啊啊！？」"
  },
  "189": {
   "text": "「用柏手（Kashiwa）一擊，\n把所有人都給打飛了！？」"
  },
  "190": {
   "text": "「哈哈哈哈！」"
  },
  "191": {
   "text": "「哇嗚！」"
  },
  "192": {
   "text": "「……」"
  },
  "193": {
   "text": "「……可以了。」"
  },
  "194": {
   "text": "「請多指教！蕾迪布魯先生！」"
  },
  "195": {
   "text": "「阿哈哈哈哈哈哈！」"
  },
  "196": {
   "text": "「（果然沒錯呀！\n讀漫畫時感受到的英雄條件。\n那就是……！）」"
  },
  "197": {
   "text": "「（是希望呀）」"
  },
  "198": {
   "text": "「（人品、外貌、擅長說話、力氣大！\n都可以呀！什麼都好呀！）」"
  },
  "199": {
   "text": "「（利用這些給予希望的存在！\n那就是，那正是……！）」"
  },
  "200": {
   "text": "「英雄，就是這樣呀！」"
  },
