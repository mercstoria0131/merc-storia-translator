 "lines": {
  "0": {
   "text": "「這裡是……，」"
  },
  "1": {
   "text": "「好多山犬……，」"
  },
  "2": {
   "text": "「這是山犬們的棲家呢……。」"
  },
  "3": {
   "text": "「哇哇哇哇……！\n我們不會被吃掉吧……！？」"
  },
  "4": {
   "text": "「哇哇，就算吃了我\n肯定也是無味無臭，\n跟喝水一樣沒感覺的啦～！」"
  },
  "5": {
   "text": "「嗚嗚……！」"
  },
  "6": {
   "text": "「咿呀！」"
  },
  "7": {
   "text": "「啾啾啾！」"
  },
  "8": {
   "text": "「剛才只是被嘲笑而已啦～。」"
  },
  "9": {
   "text": "「別、別再說了……。」"
  },
  "10": {
   "text": "「嗚嗚嗚♪」"
  },
  "11": {
   "text": "「不過，牠們對我們還算友善呢。」"
  },
  "12": {
   "text": "「確實，不像遇到他時那樣\n對我們抱有敵意呢……。」"
  },
  "13": {
   "text": "「……跟我來。」"
  },
  "14": {
   "text": "「啊，好的……。」"
  },
  "15": {
   "text": "「嗚嗚嗚……，」"
  },
  "16": {
   "text": "「我按照母親的吩咐，\n把你們帶來了。」"
  },
  "17": {
   "text": "「……可是，\n那群松鼠就算了，為什麼連癒術士也……，」"
  },
  "18": {
   "text": "「嗚嗚……。」"
  },
  "19": {
   "text": "「……！？」"
  },
  "20": {
   "text": "「我們自己就夠了！\n根本不需要借助人類的力量……！」"
  },
  "21": {
   "text": "「嗚嗚！」"
  },
  "22": {
   "text": "「對、對不起。」"
  },
  "23": {
   "text": "「可是……，我還是覺得人類……，」"
  },
  "24": {
   "text": "「嗚嗚嗚……，」"
  },
  "25": {
   "text": "「……！」"
  },
  "26": {
   "text": "「……。\n我知道了。」"
  },
  "27": {
   "text": "「嗚嗚嗚嗚……，」"
  },
  "28": {
   "text": "「母親說，\n有隻魔寵想要癒術士為牠治療。」"
  }
 },
 "warnings": []
}