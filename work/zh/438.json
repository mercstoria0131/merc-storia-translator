 "lines": {
  "0": {
   "text": "「呀，千歲大人！\n希望你能成為我們的同伴！」"
  },
  "1": {
   "text": "「啊，介紹所的人說過的癒術士……，」"
  },
  "2": {
   "text": "「呀？」"
  },
  "3": {
   "text": "「是、是妖怪……！」"
  },
  "4": {
   "text": "「溶、溶解！？\n雖然我確實有一部分是溶解狀態……，」"
  },
  "5": {
   "text": "「果然是妖怪……！」"
  },
  "6": {
   "text": "「但、但我也有固體的部分呀！」"
  },
  "7": {
   "text": "「古態！？\n原來如此……，\n人類的姿態只是暫時的，真正的姿態是水呢！」"
  },
  "8": {
   "text": "「也就是說，是水的妖怪……！」"
  },
  "9": {
   "text": "「水、水的溶解……，確實是這樣沒錯呀……。」"
  },
  "10": {
   "text": "「癒術士大人好厲害……！\n竟然連妖怪都能成為同伴……！」"
  },
  "11": {
   "text": "「請務必讓我也成為同伴！」"
  },
  "12": {
   "text": "「可以啦，不過誤解有點大……。」"
  }
 },
