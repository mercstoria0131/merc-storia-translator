  "91": {
   "text": "「哇！」"
  },
  "92": {
   "text": "「嘎烏阿阿！」"
  },
  "93": {
   "text": "「喔魯魯魯……、」"
  },
  "94": {
   "text": "「魯啊啊啊！」"
  },
  "95": {
   "text": "「」"
  },
  "96": {
   "text": "「」"
  },
  "97": {
   "text": "「……喔魯。」"
  },
  "98": {
   "text": "「這裡，是塔裡面……。」"
  },
  "99": {
   "text": "「……。」"
  },
  "100": {
   "text": "「……好安靜。\n完全感覺不到生氣的氣息……。」"
  },
  "101": {
   "text": "「而且，外面明明有那麼多魔寵，\n卻完全聽不到叫聲或動靜呀。」"
  },
  "102": {
   "text": "「跟之前看過的任何建築都不同，\n總覺得有些不一樣呀……。」"
  },
  "103": {
   "text": "「那是當然。\n這座塔是始祖梅菲爾哈內建造的。」"
  },
  "104": {
   "text": "「咦？」"
  },
  "105": {
   "text": "「從人類和魔寵\n開始共同生活之後，\n那傢伙就在雫之國的邊境建造了這座塔。」"
  },
  "106": {
   "text": "「為了不與其他生物產生牽連。\n……因為自己的力量過於強大，\n會扭曲它們的存在方式。」"
  },
  "107": {
   "text": "「就因為做了這種事，\n我們才不得不拼命奔跑，\n來到這種地方。」"
  },
  "108": {
   "text": "「……為什麼你知道這些事？」"
  },
  "109": {
   "text": "「誰知道呢。\n大概是這樣吧。」"
  },
  "110": {
   "text": "「……。」"
  },
  "111": {
   "text": "「發什麼呆呢。」"
  },
  "112": {
   "text": "「快點走吧。\n不是要去敲響世界鐘嗎？」"
  },
  "113": {
   "text": "「世界鐘在塔的最頂端。\n在那之前，你們就騎著赫斯佩拉或爬樓梯上去吧。」"
  },
  "114": {
   "text": "「咦？可是……。」"
  },
  "115": {
   "text": "「圖利亞不一起走嗎？」"
  },
  "116": {
   "text": "「我跟著去有什麼用。」"
  },
  "117": {
   "text": "「……。」"
  },
  "118": {
   "text": "「圖利亞。」"
  },
  "119": {
   "text": "「謝謝你一直以來幫助我們。」"
  },
  "120": {
   "text": "「……。」"
  },
  "121": {
   "text": "「如果沒有你，我們無法抵達世界鐘。」"
  },
  "122": {
   "text": "「我也是。\n……謝謝你，圖利亞。」"
  },
  "123": {
   "text": "「……。」"
  },
  "124": {
   "text": "「是嗎。」"
  },
  "125": {
   "text": "「……。」"
  },
  "126": {
   "text": "「……喔魯。」"
  },
  "127": {
   "text": "「嗯。\n……現在就出發吧。」"
  },
  "128": {
   "text": "「……。」"
  },
  "129": {
   "text": "「……明明是多餘的。」"
  },
  "130": {
   "text": "「……還、還要繼續往上爬嗎？」"
  },
  "131": {
   "text": "「」"
  },
  "132": {
   "text": "「看起來……。\n再堅持一下……！」"
  },
  "133": {
   "text": "「呼啊……、呼啊……！」"
  },
  "134": {
   "text": "「<name>，我扶著你。」"
  },
  "135": {
   "text": "「可是……厄爾庇斯你也搖搖欲墜吧。\n剛才還戰鬥過……。」"
  },
  "136": {
   "text": "「我、我有翅膀呀！」"
  },
  "137": {
   "text": "「因為不能自由飛翔，\n所以不是一直在爬樓梯嗎……？」"
  },
  "138": {
   "text": "「喔魯魯魯魯……！」"
  },
  "139": {
   "text": "「嗚嗚……。\n謝謝你，赫斯佩拉……。」"
  },
  "140": {
   "text": "「……呀！」"
  },
  "141": {
   "text": "「<name>！厄爾庇斯！」"
  },
  "142": {
   "text": "「啊……！」"
  },
  "143": {
   "text": "「」"
  },
  "144": {
   "text": "「……。」"
  },
  "145": {
   "text": "「這就是，最後的世界鐘……。」"
  },
  "146": {
   "text": "「……嗯。」"
  },
  "147": {
   "text": "「美麗、溫暖、巨大……。」"
  },
  "148": {
   "text": "「那是那人的……心。」"
  },
  "149": {
   "text": "「……。」"
  },
  "150": {
   "text": "「……好。」"
  },
  "151": {
   "text": "「厄爾庇斯……。」"
  },
  "152": {
   "text": "「……。」"
  },
  "153": {
   "text": "「沒關係。\n就算有點不順利，也不會放棄的。」"
  },
  "154": {
   "text": "「希望大家能為我加油。\n我要敲響最後的世界鐘，\n拯救那個人……！」"
  },
  "155": {
   "text": "「……啊。」"
  },
  "156": {
   "text": "「」"
  },
  "157": {
   "text": "「」"
  },
  "158": {
   "text": "「」"
  },
  "159": {
   "text": "「（……大家）」"
  },
  "160": {
   "text": "「（謝謝大家帶我來到這裡）」"
  },
  "161": {
   "text": "「（一定要傳達出去。\n用我的舞蹈……）」"
  },
  "162": {
   "text": "「（那個人還不知道，希望依然存在！）」"
  },
  "163": {
   "text": "「」"
  },
  "164": {
   "text": "「（……走吧）」"
  },
  "165": {
   "text": "「（……到那個人心中去……！）」"
  },
  "166": {
   "text": "「」"
  },
  "167": {
   "text": "「……咦？」"
  },
  "168": {
   "text": "「（厄爾庇斯，敲響了鐘……）」"
  },
  "169": {
   "text": "「（……可是，沒有聲音？）」"
  },
  "170": {
   "text": "「唔咕……！」"
  },
  "171": {
   "text": "「嗚啊啊啊……！」"
  },
  "172": {
   "text": "「咦……！？」"
  },
  "173": {
   "text": "「厄爾庇斯！\n怎麼了，你沒事吧！？」"
  },
  "174": {
   "text": "「咕……、啊……！」"
  },
  "175": {
   "text": "「厄爾庇斯……！\n胸口好悶！？」"
  },
  "176": {
   "text": "「嗚喔！ 嗚喔喔！」"
  },
  "177": {
   "text": "「唔……、咕……。\n呼、呼……！」"
  },
  "178": {
   "text": "「……糟了。\n她聽不到我們說話……！」"
  },
  "179": {
   "text": "「怎、怎麼會這樣……！？\n之前敲響世界鐘，\n都不會有這種情況的……！」"
  },
  "180": {
   "text": "「啊……！」"
  },
  "181": {
   "text": "「是啊，是叫希伊羅吧。\n連被稱為大癒術士的他，\n觸碰夏爾的心石時，都因感情逆流而痛苦不堪。」"
  },
  "182": {
   "text": "「」"
  },
  "183": {
   "text": "「……是因為敲響了鐘，所以才痛苦。」"
  },
  "184": {
   "text": "「被始祖梅菲爾哈內過強的感情牽引，\n厄爾庇斯的心靈正在被拖拽……！」"
  },
  "185": {
   "text": "「嗚喔……！」"
  },
  "186": {
   "text": "「唔……、嗚……。」"
  },
  "187": {
   "text": "「這、個……、那、個人……、」"
  },
  "188": {
   "text": "「那、個人的。\n心……。」"
  },
  "189": {
   "text": "「厄爾庇斯……！」"
  },
  "190": {
   "text": "「（……希伊羅先生，\n持續對費尼夏爾施展癒術，因此備受折磨。\n厄爾庇斯也是……）」"
  },
  "191": {
   "text": "「（現在，還在試圖與\n始祖梅菲爾哈內的心靈連結嗎？）」"
  },
  "192": {
   "text": "「（可是，這樣下去厄爾庇斯的心靈會崩潰……！）」"
  },
  "193": {
   "text": "「……、等……。」"
  },
  "194": {
   "text": "「啊……。」"
  },
  "195": {
   "text": "「等、等……。\n還沒……、我、我……。」"
  },
  "196": {
   "text": "「我……、不想、放棄……。」"
  },
  "197": {
   "text": "「如果我、放棄的話……！\n就會、背叛那個人……！」"
  },
  "198": {
   "text": "「必須、傳達出去……、\n給那個人，我的、愛……。」"
  },
  "199": {
   "text": "「可是，在那種狀態下再次敲響鐘的話……！」"
  },
  "200": {
   "text": "「……唔。」"
  },
  "201": {
   "text": "「連對方為什麼悲傷都不知道，\n就說要安慰那傢伙嗎？」"
  },
  "202": {
   "text": "「那種做法，叫作強加於人。\n是離安慰最遠的做法。」"
  },
  "203": {
   "text": "「」"
  },
  "204": {
   "text": "「……。」"
  },
  "205": {
   "text": "「……厄爾庇斯？」"
  },
  "206": {
   "text": "「（是、啊……）」"
  },
  "207": {
   "text": "「（對現在的那個人來說，光有希望……、\n光有我，是不夠的……！）」"
  },
  "208": {
   "text": "「<name>……！」"
  },
  "209": {
   "text": "「」"
  },
  "210": {
   "text": "「請、你……、\n請、你……、幫幫我。」"
  },
  "211": {
   "text": "「力量、……借給我。」"
  },
  "212": {
   "text": "「對最後的、世界鐘、……、」"
  },
  "213": {
   "text": "「施展、癒術……！」"
  },
  "214": {
   "text": "「……。」"
  },
  "215": {
   "text": "「……敲響鐘、的時候。\n那個人心情，傳達過來了……。」"
  },
  "216": {
   "text": "「不要再、來了。」"
  },
  "217": {
   "text": "「……封閉了、心。」"
  },
  "218": {
   "text": "「我……、不、知道。\n那個人，連我的聲音都無法觸及的悲傷，\n獨自一人承受著……。」"
  },
  "219": {
   "text": "「厄爾庇斯……。」"
  },
  "220": {
   "text": "「……但是。\n如果在此放棄，就是否定了。」"
  },
  "221": {
   "text": "「我們的旅途，還有世界。\n以及，可以懷抱希望這件事。」"
  },
  "222": {
   "text": "「我們所知道的、美好的事物，\n被否定而消失的話，我辦不到……！」"
  },
  "223": {
   "text": "「所以，……請、請你。\n用你的力量，治癒那個人。」"
  },
  "224": {
   "text": "「對那個人內心，\n我、無法靠近，但是……、」"
  },
  "225": {
   "text": "「如果是<name>，就能做到。」"
  },
  "226": {
   "text": "「咦？」"
  },
  "227": {
   "text": "「被治癒這件事……、\n與懷抱希望……、是不同的。」"
  },
  "228": {
   "text": "「被治癒之後……、才能、懷抱希望。\n才能、想要站起來……！」"
  },
  "229": {
   "text": "「<name>……\n我會去做我能做的事……。」"
  },
  "230": {
   "text": "「……、」"
  },
  "231": {
   "text": "「你治癒的那個人心中，\n我一定會將希望傳遞給他的……！\n所以，你要……、」"
  },
  "232": {
   "text": "「嗯……。」"
  },
  "233": {
   "text": "「」"
  },
  "234": {
   "text": "「我也要去做我能做的事……！」"
  },
  "235": {
   "text": "「」"
  },
  "236": {
   "text": "「……。」"
  },
  "237": {
   "text": "「嗚嗚！嗚嗚嗚……！」"
  },
  "238": {
   "text": "「……赫斯佩拉。」"
  },
  "239": {
   "text": "「嗚嗚……。」"
  },
  "240": {
   "text": "「厄爾庇斯的事，……就拜託你了。」"
  },
  "241": {
   "text": "「……。」"
  },
  "242": {
   "text": "「嗚嗚嗚……！」"
  },
  "243": {
   "text": "「……。」"
  },
  "244": {
   "text": "「」"
  },
  "245": {
   "text": "「<name>先生。」"
  },
  "246": {
   "text": "「如果是你的話，一定沒問題的呀。」"
  },
  "247": {
   "text": "「」"
  },
  "248": {
   "text": "「嗯。」"
  },
  "249": {
   "text": "「……梅露可。\n不好意思，請進口袋裡待著。」"
  },
  "250": {
   "text": "「我想請你在一旁守護著我。」"
  },
  "251": {
   "text": "「好的呀！」"
  },
  "252": {
   "text": "「……。」"
  },
  "253": {
   "text": "「（……我）」"
  },
  "254": {
   "text": "「（要治癒始祖梅菲爾哈內的內心……）」"
  },
  "255": {
   "text": "「」"
  },
  "256": {
   "text": "「」"
  }
