  },
  "5": {
   "text": "「格拉格拉拉阿……！」"
  },
  "6": {
   "text": "「哈、哈啊……，」"
  },
  "7": {
   "text": "「飛翼龍……、\n這次，換我來救你了……。\n所以我，不會逃的……！」"
  },
  "8": {
   "text": "「塔啊啊啊——！」"
  },
  "9": {
   "text": "「格拉阿阿……，」"
  },
