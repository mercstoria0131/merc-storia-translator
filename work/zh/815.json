 "lines": {
  "0": {
   "text": "「（今天請了半天假，\n應該快回來了……）」"
  },
  "1": {
   "text": "「（嗚嗚，好緊張……）」"
  },
  "2": {
   "text": "「（但是，海涅先生和梅露可說的話……\n是對的。\n我得確認一下，他到底怎麼看我的……）」"
  },
  "3": {
   "text": "「……！」"
  },
  "4": {
   "text": "「……」"
  },
  "5": {
   "text": "「（亞德先生……！\n好、好的，先試著搭話……！）」"
  },
  "6": {
   "text": "「……」"
  },
  "7": {
   "text": "「……啊……！」"
  },
  "8": {
   "text": "「（好、好緊張，發不出聲音……！）」"
  },
  "9": {
   "text": "「（啊！\n亞德先生要走了！）」"
  },
  "10": {
   "text": "「（這、這樣的話，總得讓他注意到我才行……！\n到了關鍵時刻應該能發出聲音……！\n好、好、好——好，就是現在！）」"
  },
  "11": {
   "text": "「（成功了，抓到衣角了！\n這樣他應該會注意到……）」"
  },
  "12": {
   "text": "「……」"
  },
  "13": {
   "text": "「……」"
  },
  "14": {
   "text": "「……」"
  },
  "15": {
   "text": "「尤、尤莉婭大人！？\n尤莉婭大人——！」"
  },
  "16": {
   "text": "「（果然、果然被討厭了啊啊啊！）」"
  }
 },
