 "lines": {
  "0": {
   "text": "「放、放手！\n這個人沒事的！\n這個人是天來呀！」"
  },
  "1": {
   "text": "「給我閉嘴。」"
  },
  "2": {
   "text": "「古恩……？」"
  },
  "3": {
   "text": "「放開殿下。」"
  },
  "4": {
   "text": "「你剛才想對這傢伙做什麼？」"
  },
  "5": {
   "text": "「我只是想碰觸一下而已。」"
  },
  "6": {
   "text": "「然後就想佔據他的身體，是吧。」"
  },
  "7": {
   "text": "「你、你在說什麼啊，古恩。」"
  },
  "8": {
   "text": "「殿下。\n千萬別聽信那人的話。」"
  },
  "9": {
   "text": "「你抓住了尤爾的心，\n讓他更容易被附身。\n為了得到他的身體。」"
  },
  "10": {
   "text": "「……。」"
  },
  "11": {
   "text": "「尤爾跟你氣息種類相似。\n若能借用他的身體，\n你能自由使用的力量就會增加吧。」"
  },
  "12": {
   "text": "「然後。\n你就能更接近自己的願望。」"
  },
  "13": {
   "text": "「我接近殿下，\n只是為了得到身體嗎？」"
  },
  "14": {
   "text": "「沒錯吧。\n你以前……，」"
  },
  "15": {
   "text": "「不、不要！」"
  },
  "16": {
   "text": "「喂，笨蛋尤爾！\n別靠近那傢伙！」"
  },
  "17": {
   "text": "「不要再這樣了，古恩！\n別欺負天來！」"
  },
  "18": {
   "text": "「天來是我重要的人呀！\n哥哥們不在時，他總在身邊，\n晚上給我唱歌，還一起吃飯！」"
  },
  "19": {
   "text": "「所以，這次換我來\n保護天來，我已經決定了……！」"
  },
  "20": {
   "text": "「那、殿下……。」"
  },
  "21": {
   "text": "「……一起吃飯，是吧。」"
  },
  "22": {
   "text": "「對呀！\n明明不餓，\n卻為了我……，」"
  },
  "23": {
   "text": "「……。」"
  },
  "24": {
   "text": "「耀。」"
  },
  "25": {
   "text": "「嘁，來吧！」"
  },
  "26": {
   "text": "「你、你這……！？」"
  },
  "27": {
   "text": "「你緊急避開了術法。\n不知何時你成了術法使用者，\n古恩。」"
  },
  "28": {
   "text": "「只是你變弱了而已。\n果然你違反了禁穀。\n這樣更容易收買你！」"
  },
  "29": {
   "text": "「古、古恩？\n天來……？」"
  },
  "30": {
   "text": "「殿下，請稍候。\n我馬上就收拾那個男人。」"
  },
  "31": {
   "text": "「哪有那麼容易！」"
  },
  "32": {
   "text": "「該死，耍小聰明……！」"
  },
  "33": {
   "text": "「尤爾，過來！」"
  },
  "34": {
   "text": "「不、不要，放開我！\n天來他……！」"
  },
  "35": {
   "text": "「那傢伙哪有那麼好對付！\n趁現在快跑！」"
  },
  "36": {
   "text": "「休想逃！」"
  },
  "37": {
   "text": "「唔……！」"
  },
  "38": {
   "text": "「古恩！？」"
  },
  "39": {
   "text": "「……別以為我還跟以前一樣！」"
  },
  "40": {
   "text": "「什……唔！」"
  },
  "41": {
   "text": "「走，尤爾！」"
  },
  "42": {
   "text": "「古恩，等等！\n等等我！\n這是怎麼回事！？\n天來和古恩認識！？」"
  },
  "43": {
   "text": "「之後再說！\n快聽我的話，乖乖讓我抱著！」"
  },
  "44": {
   "text": "「古……」"
  },
  "45": {
   "text": "「……。」"
  },
  "46": {
   "text": "「呼、呼……。\n總算暫時甩掉了。」"
  },
  "47": {
   "text": "「古、古恩，你沒事……？」"
  },
  "48": {
   "text": "「吵死了，我只是略懂咒術而已。\n還有，尤爾。\n關於那個人……」"
  },
  "49": {
   "text": "「啊、唔……！」"
  },
  "50": {
   "text": "「古恩！」"
  },
  "51": {
   "text": "「該死，不該做這種不習慣的事。」"
  },
  "52": {
   "text": "「怎、怎麼辦，該怎麼辦？」"
  },
  "53": {
   "text": "「當然是快跑啊！」"
  },
  "54": {
   "text": "「但、但是，古恩你……！」"
  },
  "55": {
   "text": "「笨蛋！\n那人的目標是你！\n把我丟下！」"
  },
  "56": {
   "text": "「我、做不到……！\n因為，古恩，古恩你……！」"
  },
  "57": {
   "text": "「真煩……，\n我說了，別捲入我。」"
  },
  "58": {
   "text": "「古、古恩……。」"
  },
  "59": {
   "text": "「聽好了，那人只能在夜間行動。\n在天黑前盡量跑遠一點。\n然後，到了晚上就躲在沒有光的地方。」"
  },
  "60": {
   "text": "「那傢伙怕光，但會從光中獲得力量。\n在黑暗裡，應該比較不容易被發現。\n懂了嗎？」"
  },
  "61": {
   "text": "「嗯、嗯。」"
  },
  "62": {
   "text": "「很好，乖孩子。\n接下來……，\n還記得來這裡之前經過的村子嗎？」"
  },
  "63": {
   "text": "「記、記得。\n我記得啦。」"
  },
  "64": {
   "text": "「在那裡報上我的名字。\n雖然要收錢，\n但他們大概會幫忙……。」"
  },
  "65": {
   "text": "「快……。」"
  },
  "66": {
   "text": "「古恩！」"
  },
  "67": {
   "text": "「快點走，笨蛋。\n我說了別捲入我。\n你不在的話，我比較安全，才對。」"
  },
  "68": {
   "text": "「……。」"
  },
  "69": {
   "text": "「古恩……，」"
  },
  "70": {
   "text": "「……好、好喔。\n既然古恩這麼說，那就是真的，對吧？\n我不在的話，比較、好，對吧？」"
  },
  "71": {
   "text": "「……。」"
  },
  "72": {
   "text": "「啾……。」"
  },
  "73": {
   "text": "「你、你這……！？」"
  },
  "74": {
   "text": "「……。」"
  },
  "75": {
   "text": "「啊……。」"
  },
  "76": {
   "text": "「不、不行！\n別靠近古恩！」"
  },
  "77": {
   "text": "「……。」"
  },
  "78": {
   "text": "「……。」"
  },
  "79": {
   "text": "「呼、呼……，」"
  },
  "80": {
   "text": "「……。」"
  },
  "81": {
   "text": "「是、對吧。\n古恩就是、這種彆扭的人，對吧……。」"
  },
  "82": {
   "text": "「好、好重……！」"
  },
  "83": {
   "text": "「……。」"
  },
  "84": {
   "text": "「等我一下，喔，古恩……。\n我馬上就帶你去村子……！」"
  },
  "85": {
   "text": "「沒關係的。\n我連魔寵都趕走了，\n我是男孩，不會哭的……。」"
  },
  "86": {
   "text": "「嗚！」"
  },
  "87": {
   "text": "「……。」"
  },
  "88": {
   "text": "「不哭……、才不哭呢。」"
  },
  "89": {
   "text": "「……。」"
  },
  "90": {
   "text": "「……嗚、嗚嗚，好痛。」"
  }
 },
