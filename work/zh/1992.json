 "lines": {
  "0": {
   "text": "「……。」"
  },
  "1": {
   "text": "「……。」"
  },
  "2": {
   "text": "「……。」"
  },
  "3": {
   "text": "「……喂，梅露可。」"
  },
  "4": {
   "text": "「我知道你想說什麼，<name>先生。」"
  },
  "5": {
   "text": "「那個奇怪的姿態到底是……\n蜷縮在床邊……？」"
  },
  "6": {
   "text": "「呀呀〜……。\n真讓人好奇他在做什麼呀……。」"
  },
  "7": {
   "text": "「怎麼辦，要不要過去說句話……？」"
  },
  "8": {
   "text": "「感覺不該去打擾他呀……。」"
  },
  "9": {
   "text": "「但就是很在意嘛……。\n特別是『那個』。」"
  },
  "10": {
   "text": "「<name>先生也是嗎……？\n我也很在意『那個』呀……。\n就是頭上的……。」"
  },
  "11": {
   "text": "「『刺』。」"
  },
  "12": {
   "text": "「那些刺摸起來會怎樣呢……。」"
  },
  "13": {
   "text": "「……既想知道又害怕知道的心情呀。」"
  },
  "14": {
   "text": "「好……。\n那就鼓起勇氣，\n試著說句話吧。」"
  },
  "15": {
   "text": "「呀！？\n<name>先生，先等等……！」"
  },
  "16": {
   "text": "「……呼、呼。」"
  },
  "17": {
   "text": "「那個……。」"
  },
  "18": {
   "text": "「呼、呼……。」"
  },
  "19": {
   "text": "「……嗯！？」"
  },
  "20": {
   "text": "「咦！？」"
  },
  "21": {
   "text": "「哇啊啊啊啊有人啊啊啊啊！？」"
  },
  "22": {
   "text": "「哇啊啊啊啊那、那是什麼！？」"
  },
  "23": {
   "text": "「別、別碰我，會很痛的！\n而且，我的槍會刺傷你的！」"
  },
  "24": {
   "text": "「等、等一下！\n我只是想說句話……！」"
  },
  "25": {
   "text": "「我、我可是高貴的豪豬族！\n嚇到我的無禮之舉，絕、絕對不原諒！」"
  },
  "26": {
   "text": "「喂——！\n聽我說話啊！」"
  },
  "27": {
   "text": "「呀〜！\n你們兩個都冷靜一點呀！」"
  },
  "28": {
   "text": "「……。」"
  },
  "29": {
   "text": "「那個……。」"
  },
  "30": {
   "text": "「先來整理一下狀況呀！」"
  },
  "31": {
   "text": "「呀呀〜。\n那個，豪豬族的……。」"
  },
  "32": {
   "text": "「我是伊格爾！」"
  },
  "33": {
   "text": "「伊格爾先生，我是梅露可呀。」"
  },
  "34": {
   "text": "「我是<name>。\n剛才真是對不起。\n沒想到你會嚇成那樣……。」"
  },
  "35": {
   "text": "「伊格爾先生為什麼\n蜷縮在地板上呀？」"
  },
  "36": {
   "text": "「那個、那個……。」"
  },
  "37": {
   "text": "「咦，伊格爾。嘴角好像沾了什麼東西……。」"
  },
  "38": {
   "text": "「嗚嗚。\n這不是口水啦！\n絕對不是！」"
  },
  "39": {
   "text": "「原來是睡著了……。\n而且還睡在地板上……。」"
  },
  "40": {
   "text": "「才、才不是保持剛才的姿勢等待，\n然後不小心睡著了呢！」"
  },
  "41": {
   "text": "「等待……？」"
  },
  "42": {
   "text": "「哼！\n……沒什麼！\n我才沒有睡迷糊呢！」"
  },
  "43": {
   "text": "「哇，別再用槍指著我了！\n很危險的！」"
  },
  "44": {
   "text": "「（伊格爾先生，是個相當敏感的人呢……！）」"
  },
  "45": {
   "text": "「（啊，說話時得小心一點才行……）」"
  },
  "46": {
   "text": "「我、那個，伊格爾頭上的刺……。」"
  },
  "47": {
   "text": "「刺？\n難道是指這個？\n你是對我的時尚帽子感興趣嗎？」"
  },
  "48": {
   "text": "「是、是的！\n我對你戴的那個多刺配件很在意……。」"
  },
  "49": {
   "text": "「……。」"
  },
  "50": {
   "text": "「……。」"
  },
  "51": {
   "text": "「……懂嗎。」"
  },
  "52": {
   "text": "「咦？」"
  },
  "53": {
   "text": "「<name>你懂這頂帽子的好嗎……！？」"
  },
  "54": {
   "text": "「啊，對，當然！\n非常有品味……！\n連帽子內襯都很時尚……。」"
  },
  "55": {
   "text": "「呵呵〜！\n是吧是吧！」"
  },
  "56": {
   "text": "「能看懂我品味之好，\n<name>你真是有眼光呢！」"
  },
  "57": {
   "text": "「（態、態度變化好大！？）」"
  },
  "58": {
   "text": "「那、那真是太好了……。」"
  },
  "59": {
   "text": "「能認識這麼帥氣又時尚的我，\n真是你的榮幸呢！」"
  },
  "60": {
   "text": "「是、是……。」"
  },
  "61": {
   "text": "「既然認識了，就順便問一下吧！\n<name>你們來這裡是幹嘛的？」"
  },
  "62": {
   "text": "「旅行嗎？\n還是找夥伴？」"
  },
  "63": {
   "text": "「啊，對，是的。」"
  },
  "64": {
   "text": "「哦〜？」"
  },
  "65": {
   "text": "「不過，一直找不到……。」"
  },
  "66": {
   "text": "「喔，這樣啊……！」"
  },
  "67": {
   "text": "「……我等的就是這個時機。」"
  },
  "68": {
   "text": "「咦？」"
  },
  "69": {
   "text": "「像我這種高貴的豪豬族，\n也可以成為你們的夥伴喔？」"
  },
  "70": {
   "text": "「啾〜！\n這真是太感激了呀！」"
  },
  "71": {
   "text": "「啊，對。\n這幫上大忙了！」"
  },
  "72": {
   "text": "「好，決定了。\n從今天起，我就是你們的夥伴了！」"
  },
  "73": {
   "text": "「再次請多指教了，伊格爾先生！」"
  },
  "74": {
   "text": "「謝謝你，伊格爾！」"
  },
  "75": {
   "text": "「呵呵，別客氣。\n不過，盡量別拖我的後腿喔！」"
  },
  "76": {
   "text": "「哎呀，伊格爾君。\n順利找到夥伴了呢。\n真讓人放心！」"
  },
  "77": {
   "text": "「呀、介紹所的大姊……！」"
  },
  "78": {
   "text": "「啾？\n這是怎麼回事呀？」"
  },
  "79": {
   "text": "「伊格爾君很怕生，\n所以不敢主動開口，一直找不到夥伴呢。」"
  },
  "80": {
   "text": "「原來是這樣啊？」"
  },
  "81": {
   "text": "「不過能順利成為\n<name>君和梅露可的夥伴，真是太好了。\n他一直蜷縮著想吸引別人注意呢。」"
  },
  "82": {
   "text": "「那個奇怪的姿勢原來是有這種原因呀……。」"
  },
  "83": {
   "text": "「而且中途還因為等人睡著了……。」"
  },
  "84": {
   "text": "「哇、哇啊啊啊。」"
  },
  "85": {
   "text": "「啊……。」"
  },
  "86": {
   "text": "「又縮成一團了呀……。」"
  }
 },
 "warnings": []
}