 "lines": {
  "0": {
   "text": "「咕嚕嚕！？」"
  },
  "1": {
   "text": "「再敢靠近我主人一步！」"
  },
  "2": {
   "text": "「亞德、先生……、」"
  },
  "3": {
   "text": "「這裡交給我，尤莉婭大人請退下！」"
  },
  "4": {
   "text": "「可、可是……、\n（都這時候了，腿卻在發抖……！）」"
  },
  "5": {
   "text": "「咕嚕嚕嚕！」"
  },
  "6": {
   "text": "「哼……！」"
  },
  "7": {
   "text": "「<name>大人！\n沒辦法治癒那隻魔寵呀！？」"
  },
  "8": {
   "text": "「我有在試……！\n但那隻魔寵已經被治癒過了，\n感覺癒術完全沒效！」"
  },
  "9": {
   "text": "「沒辦法了，帶尤莉婭大人撤離吧！\n再這樣下去，那位大人只會處於劣勢！」"
  },
  "10": {
   "text": "「我知……、」"
  },
  "11": {
   "text": "「咕嚕嚕嚕嚕嗚！」"
  },
  "12": {
   "text": "「哇啊！」"
  },
  "13": {
   "text": "「太、太瘋狂了呀……！\n那隻魔寵，\n到底有什麼目的才這麼暴走的呀！？」"
  },
  "14": {
   "text": "「不妙……。\n照這樣下去，不只建築，連居民都會受害……！」"
  },
  "15": {
   "text": "「……！」"
  },
  "16": {
   "text": "「請放心，尤莉婭大人。\n我一定會阻止那隻魔寵的！」"
  },
  "17": {
   "text": "「咕嚕嚕嚕嚕嗚！」"
  },
  "18": {
   "text": "「不能再讓它為所欲為了！」"
  },
  "19": {
   "text": "「亞德先生！」"
  },
  "20": {
   "text": "「一個人戰鬥太冒險了！\n戰士！」"
  },
  "21": {
   "text": "「弓……、」"
  },
  "22": {
   "text": "「（手指在發抖，箭都握不住……！\n腿也軟得無法穩穩站住………！\n好可怕……）」"
  },
  "23": {
   "text": "「但是，我……、」"
  },
  "24": {
   "text": "「不能一直害怕魔寵才對！」"
  },
  "25": {
   "text": "「給我停下啊啊啊啊啊！」"
  },
  "26": {
   "text": "「箭直直地射向魔寵……！」"
  },
  "27": {
   "text": "「到此為止了！」"
  },
  "28": {
   "text": "「被彈開了……！？\n是誰……、」"
  },
  "29": {
   "text": "「長進不少啊，尤莉婭。\n沒想到我的手臂會感到發麻！」"
  },
  "30": {
   "text": "「那是……、媽媽……！？」"
  }
 },
