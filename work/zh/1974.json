 "lines": {
  "0": {
   "text": "「掰掰。」"
  },
  "1": {
   "text": "「那麼……。」"
  },
  "2": {
   "text": "「呀？」"
  },
  "3": {
   "text": "「別過來！\n快滾開！」"
  },
  "4": {
   "text": "「呀！？」"
  },
  "5": {
   "text": "「你已經\n不是我們的同伴了！」"
  },
  "6": {
   "text": "「呀！」"
  },
  "7": {
   "text": "「呀——！」"
  },
  "8": {
   "text": "「哥哥……\n救救我……」"
  },
  "9": {
   "text": "「」"
  },
  "10": {
   "text": "「咳、這是哪裡？」"
  },
  "11": {
   "text": "「巷子……\n原來是被尾巴甩飛了。\n跟以前嬉鬧時比起來，\n力量差距真大啊。」"
  },
  "12": {
   "text": "「米魯魯……！」"
  },
  "13": {
   "text": "「……巴米斯……\n你是在生那件事的氣嗎。\n生我把你丟在森林裡的事。」"
  },
  "14": {
   "text": "「但是，為什麼要在白天\n對阿蒂絲下手。\n她當時應該不在場才對……！」"
  },
  "15": {
   "text": "「米魯魯魯！」"
  },
  "16": {
   "text": "「唔……！」"
  },
  "17": {
   "text": "「難道……還有其他原因。\n你攻擊我和她的理由……」"
  },
  "18": {
   "text": "「叛徒！」"
  },
  "19": {
   "text": "「米魯魯……！」"
  },
  "20": {
   "text": "「你……\n難道已經知道了嗎。」"
  },
  "21": {
   "text": "「我出賣了她的事，\n以及我們因此得救的事。\n所以阿蒂絲才是我的同伴……」"
  },
  "22": {
   "text": "「米魯魯魯！」"
  },
  "23": {
   "text": "「唔！」"
  },
  "24": {
   "text": "「該死，住手巴米斯！\n再這樣亂來，\n你會被騎士團抓起來的！\n到時候我們做這些又是為了什麼……」"
  },
  "25": {
   "text": "「米魯魯魯！」"
  },
  "26": {
   "text": "「嗚！」"
  },
  "27": {
   "text": "「唔……\n住手，巴米……」"
  },
  "28": {
   "text": "「米魯魯魯……！」"
  },
  "29": {
   "text": "「等等，巴米斯！」"
  },
  "30": {
   "text": "「米魯魯……！」"
  },
  "31": {
   "text": "「什麼……？」"
  },
  "32": {
   "text": "「小時候，\n我一直夢想著有一天能像這樣保護你。\n……哥哥。」"
  },
  "33": {
   "text": "「阿蒂絲……」"
  },
  "34": {
   "text": "「米魯魯魯魯！」"
  },
  "35": {
   "text": "「巴米斯……！\n我會阻止你的！」"
  },
  "36": {
   "text": "「喂，住手！\n你辦不到的！」"
  },
  "37": {
   "text": "「才不是辦不到！\n我不再是小孩子了！」"
  },
  "38": {
   "text": "「阿蒂絲！」"
  },
  "39": {
   "text": "「如果想讓他停手……！」"
  },
  "40": {
   "text": "「如果想讓他停手，就告訴我！」"
  },
  "41": {
   "text": "「為什麼哥哥要背叛我們！\n如果有苦衷就告訴我……！」"
  },
  "42": {
   "text": "「告訴我，還有巴米斯！」"
  },
  "43": {
   "text": "「米魯魯魯魯！」"
  },
  "44": {
   "text": "「……！」"
  },
  "45": {
   "text": "「……」"
  },
  "46": {
   "text": "「因為我們約定好了。」"
  },
  "47": {
   "text": "「……約定？」"
  },
  "48": {
   "text": "「……」"
  },
  "49": {
   "text": "「當時，藏身處被騎士團發現只是時間問題。\n但我們沒有退路，\n就算逃了，也知道會被追上。」"
  },
  "50": {
   "text": "「所以……我們倆制定了計畫。\n我把他交給騎士團，\n作為交換，我只要付罰金就能了事。」"
  },
  "51": {
   "text": "「然後，和你一起在外面等他，\n再像以前一樣三人生活。\n……我們是這樣約定好的。」"
  },
  "52": {
   "text": "「……巴米斯，\n因為它可能不知道我們會被抓，\n為了不讓它跟騎士起衝突，就讓它逃進了森林深處。」"
  },
  "53": {
   "text": "「……」"
  },
  "54": {
   "text": "「那也就是說……\n被抓住的，是我的……」"
  },
  "55": {
   "text": "「不是。\n只是我判斷那樣比較好。\n對我和他來說都是。」"
  },
  "56": {
   "text": "「別說謊了……！」"
  },
  "57": {
   "text": "「為什麼……」"
  },
  "58": {
   "text": "「為什麼，哥哥！\n我也約定好了啊！」"
  },
  "59": {
   "text": "「阿蒂……」"
  },
  "60": {
   "text": "「米魯魯魯！」"
  },
  "61": {
   "text": "「唔……！」"
  },
  "62": {
   "text": "「咦……、巴米斯！？」"
  },
  "63": {
   "text": "「米魯魯……！」"
  },
  "64": {
   "text": "「巴米斯，住手！」"
  },
  "65": {
   "text": "「哥哥……、」"
  },
  "66": {
   "text": "「哥哥被抓，\n把巴米斯丟下不管……！」"
  },
  "67": {
   "text": "「都是我的錯啊！」"
  },
  "68": {
   "text": "「米魯魯魯！」"
  },
  "69": {
   "text": "「阿蒂絲，快跑！\n目標還是我！」"
  },
  "70": {
   "text": "「哥哥！」"
  },
  "71": {
   "text": "「米魯魯！」"
  },
  "72": {
   "text": "「啾！」"
  },
  "73": {
   "text": "「呀！？\n帕米！？\n什麼時候……！」"
  },
  "74": {
   "text": "「阿蒂絲！」"
  },
  "75": {
   "text": "「快跑，哥哥！\n我沒事的！」"
  },
  "76": {
   "text": "「米魯魯！」"
  },
  "77": {
   "text": "「哥哥……！」"
  },
  "78": {
   "text": "「羅爾先生！」"
  },
  "79": {
   "text": "「咦……！」"
  },
  "80": {
   "text": "「好痛……、你、你沒事吧？」"
  },
  "81": {
   "text": "「這句該我說的吧！\n為什麼突然衝過來！」"
  },
  "82": {
   "text": "「再這樣下去，\n羅爾先生好像要被打中了，所以忍不住……。」"
  },
  "83": {
   "text": "「米魯魯……！」"
  },
  "84": {
   "text": "「呀！\n又來了呀！」"
  },
  "85": {
   "text": "「<name>，帶哥哥快跑！\n目標是哥哥！」"
  },
  "86": {
   "text": "「啾！」"
  },
  "87": {
   "text": "「阿蒂絲！」"
  },
  "88": {
   "text": "「這種程度的對手，我沒問題！\n所以快帶哥哥走！」"
  },
  "89": {
   "text": "「米魯魯魯！」"
  },
  "90": {
   "text": "「呀哇啊，又衝過來了呀！\n總、總之往深處逃吧！」"
  },
  "91": {
   "text": "「羅爾先生，我們走吧！」"
  },
  "92": {
   "text": "「留在這裡會連累阿蒂絲……！」"
  },
  "93": {
   "text": "「呼、呼……！」"
  },
  "94": {
   "text": "「米魯魯魯！」"
  },
  "95": {
   "text": "「呼、呼……太好了呀。\n這條路這麼窄，\n應該不容易被追上來呀。」"
  },
  "96": {
   "text": "「嗚呼，呼、跑得好累……。」"
  },
  "97": {
   "text": "「……擦傷還不少嘛。」"
  },
  "98": {
   "text": "「咦？」"
  },
  "99": {
   "text": "「呀哇！\n是真的呀！\n一定是剛才衝撞羅爾先生時弄傷的呀。」"
  },
  "100": {
   "text": "「因為慌張沒注意到……。」"
  },
  "101": {
   "text": "「痛、好痛痛！\n一靜下來就覺得好痛！」"
  },
  "102": {
   "text": "「再忍耐一下下呀！\n等巴米斯冷靜下來後，\n再讓他幫我們處理傷口呀！」"
  },
  "103": {
   "text": "「啊，也是呢。\n總之現在得先解決巴米斯的問題……，」"
  },
  "104": {
   "text": "「……不，算了。」"
  },
  "105": {
   "text": "「咦？」"
  },
  "106": {
   "text": "「不用管我。\n你們快逃吧。」"
  },
  "107": {
   "text": "「為、為什麼呀！？」"
  },
  "108": {
   "text": "「這次對手不像之前那個弱小的帕米。\n面對巴米斯，我沒法同時保護你們。」"
  },
  "109": {
   "text": "「但、但是就算這樣，\n也不能丟下羅爾先生不管呀！」"
  },
  "110": {
   "text": "「就是呀！\n只要找到空隙施展癒術，就能解決……，」"
  },
  "111": {
   "text": "「我……，」"
  },
  "112": {
   "text": "「我是個盜賊出身的人。」"
  },
  "113": {
   "text": "「咦……？」"
  },
  "114": {
   "text": "「而且，這件事我沒告訴你們，一直在騙你們。\n現在說出來，遲早也會傳開吧。」"
  },
  "115": {
   "text": "「你懂了吧。\n快逃吧。\n誰也不會想幫一個盜賊出身的傢伙。」"
  },
  "116": {
   "text": "「……」"
  },
  "117": {
   "text": "「……羅爾先生。\n雖然我不了解你當盜賊時的事……，」"
  },
  "118": {
   "text": "「但就算如此，\n你與我們一起旅行的經歷，也不是假的呀。」"
  },
  "119": {
   "text": "「就是呀！\n旅途中你幫了我們很多忙，\n這次換我們報答你呀！」"
  },
  "120": {
   "text": "「……」"
  },
  "121": {
   "text": "「巴米斯進不了這種窄路呢。\n這樣的話，利用這點或許就能騰出手來使用癒術了。」"
  },
  "122": {
   "text": "「呀，是呀！\n用癒術安撫牠，再請羅爾先生說服，\n牠應該就能平息怒氣了！」"
  },
  "123": {
   "text": "「米魯魯魯！」"
  },
  "124": {
   "text": "「哇！\n巴米斯在抓牆壁……！」"
  },
  "125": {
   "text": "「在牆壁被破壞前快點行動呀！\n只能拼了，羅爾先生！」"
  },
  "126": {
   "text": "「……」"
  },
  "127": {
   "text": "「……哈哈。」"
  },
  "128": {
   "text": "「羅爾先生？」"
  },
  "129": {
   "text": "「這世道真是變了呢。」"
  },
  "130": {
   "text": "「能被你們這樣說，\n我早該答應查莫先生的委託了。」"
  },
  "131": {
   "text": "「那我們之後\n再一起去委託他呀！」"
  },
  "132": {
   "text": "「所以先解決眼前的狀況吧！」"
  },
  "133": {
   "text": "「……，是啊。」"
  },
  "134": {
   "text": "「那麼，我有個作戰計畫。」"
  },
  "135": {
   "text": "「作戰計畫呀？\n不愧是羅爾先生呀！\n該怎麼辦？」"
  },
  "136": {
   "text": "「首先，你們進到這個倉庫裡去。」"
  },
  "137": {
   "text": "「好、好的。」"
  },
  "138": {
   "text": "「有點窄呀。\n這樣的話羅爾先生進不來了。」"
  },
  "139": {
   "text": "「不，我沒關係。」"
  },
  "140": {
   "text": "「咦？」"
  },
  "141": {
   "text": "「然後，把門鎖上。」"
  },
  "142": {
   "text": "「呀！？」"
  },
  "143": {
   "text": "「羅、羅爾先生！？」"
  },
  "144": {
   "text": "「……謝謝你們兩個。」"
  },
  "145": {
   "text": "「但是，我還是不能把你們捲入其中。\n剛才看巴米斯的樣子就知道了。\n就算說了，它似乎還是看我不順眼。」"
  },
  "146": {
   "text": "「所以……，」"
  },
  "147": {
   "text": "「從這裡開始，由我來善後。\n外面的事我會處理好。\n因為那是我和它的約定。」"
  },
  "148": {
   "text": "「等、等一下呀！」"
  },
  "149": {
   "text": "「羅爾先生！」"
  },
  "150": {
   "text": "「那麼……。」"
  },
  "151": {
   "text": "「米魯魯！」"
  },
  "152": {
   "text": "「唔……！\n突然壓制我，真是毫不留情啊。」"
  },
  "153": {
   "text": "「米魯魯……！」"
  },
  "154": {
   "text": "「巴米斯……。」"
  },
  "155": {
   "text": "「你知道這跟阿蒂絲無關吧。\n全都是我擅自做的。\n拋棄你、背叛你的也是。」"
  },
  "156": {
   "text": "「……」"
  },
  "157": {
   "text": "「我的事隨你處置。\n只要這樣你就滿意了的話。」"
  },
  "158": {
   "text": "「但之後請逃遠一點。\n逃到不會被騎士團抓到的地方。」"
  },
  "159": {
   "text": "「為了這個。\n我們才對你扔石頭的。」"
  },
  "160": {
   "text": "「米魯魯……，」"
  },
  "161": {
   "text": "「米魯魯魯！」"
  },
  "162": {
   "text": "「這種日子還要過多久呢。」"
  },
  "163": {
   "text": "「直到其中一個被抓為止吧。」"
  },
  "164": {
   "text": "「……賊到哪裡都是賊呢。」"
  },
  "165": {
   "text": "「你早就知道了吧，從那時起。」"
  },
  "166": {
   "text": "「嗯。」"
  },
  "167": {
   "text": "「即使贖了罪，過去也會追上來。」"
  },
  "168": {
   "text": "「無論去哪裡，都是被厭惡的存在，是吧。」"
  },
  "169": {
   "text": "「羅爾先生！」"
  },
  "170": {
   "text": "「咦？」"
  },
  "171": {
   "text": "「就是現在，從上面潑下去！」"
  },
  "172": {
   "text": "「米魯魯！？」"
  },
  "173": {
   "text": "「什麼……！？」"
  },
  "174": {
   "text": "「呵呵，梅露可！\n第一次的協作呢！」"
  },
  "175": {
   "text": "「呀！？」"
  },
  "176": {
   "text": "「不，我們也在幫忙啦！」"
  },
  "177": {
   "text": "「別廢話，快做！」"
  },
  "178": {
   "text": "「噢啊啊啊！」"
  },
  "179": {
   "text": "「米、米魯魯！？」"
  },
  "180": {
   "text": "「該死……！\n這液體是什麼！」"
  },
  "181": {
   "text": "「這是料理長特製的醒酒湯。\n抱歉來晚了，羅爾。\n你被擊飛後我就跟丟了。」"
  },
  "182": {
   "text": "「謝斯迪……\n你為什麼會在這裡……」"
  },
  "183": {
   "text": "「我可是個盜賊出身，而且還對你……！」"
  },
  "184": {
   "text": "「想成為騎士，就得先看清自己的本分喔。\n那麼，扣分，減分。」"
  },
  "185": {
   "text": "「你真是……」"
  },
  "186": {
   "text": "「騎士團長……」"
  },
  "187": {
   "text": "「」"
  },
  "188": {
   "text": "「憑好惡來決定救或不救，未免太傲慢了。」"
  }
