 "lines": {
  "0": {
   "text": "「」"
  },
  "1": {
   "text": "「為什麼，我能相信呢？」"
  },
  "2": {
   "text": "「平靜的日常會一直持續下去……。」"
  },
  "3": {
   "text": "「」"
  },
  "4": {
   "text": "「」"
  },
  "5": {
   "text": "「好了，準備好了喔！」"
  },
  "6": {
   "text": "「槍的練習就到此為止，快過來吧……，」"
  },
  "7": {
   "text": "「」"
  },
  "8": {
   "text": "「申魯。」"
  },
  "9": {
   "text": "「……是、是的！」"
  },
  "10": {
   "text": "「（……沒注意到。\n已經過了這麼久了呢……）」"
  },
  "11": {
   "text": "「喂，再不快點就要涼了喔！」"
  },
  "12": {
   "text": "「這樣很危險……！\n我、我馬上就去……！」"
  },
  "13": {
   "text": "「呵呵，不用客氣，多吃點吧？\n我特意做了很多便當。」"
  },
  "14": {
   "text": "「是啊，申魯。\n看，你喜歡月餅，\n還有炒青菜、肉丸、煮豆子……、」"
  },
  "15": {
   "text": "「哇、哇……！\n盤子裡放太多了……、會灑出來的！」"
  },
  "16": {
   "text": "「沒關係的！看，穩得很吧？」"
  },
  "17": {
   "text": "「唔，這種說法叫結果論。\n我可是很清楚的。」"
  },
  "18": {
   "text": "「哈哈哈，好吧好吧。\n既然準備好了，那就開動吧！」"
  },
  "19": {
   "text": "「」"
  },
  "20": {
   "text": "「」"
  },
  "21": {
   "text": "「不愧是申魯。已經學會這招了嗎……。」"
  },
  "22": {
   "text": "「也許你，\n會成為這村莊裡最強的槍手吧。」"
  },
  "23": {
   "text": "「真的嗎！」"
  },
  "24": {
   "text": "「當然。」"
  },
  "25": {
   "text": "「……懷抱希望，向前邁進吧。\n累積的努力一定會結出果實。」"
  },
  "26": {
   "text": "「加油啊，申魯。」"
  },
  "27": {
   "text": "「是！」"
  },
  "28": {
   "text": "「和平是如此脆弱，\n在這個未來（前方）\n可能正等待著絕望。」"
  },
  "29": {
   "text": "「咕嚕嚕嗚……！」"
  },
  "30": {
   "text": "「咿咿咿咿！」"
  },
  "31": {
   "text": "「（……怎麼辦。\n沒想到，跑腿回來的路上會遇到這種事……！）」"
  },
  "32": {
   "text": "「咕嚕嚕嗚嗚！」"
  },
  "33": {
   "text": "「（……這種數量逃不掉！\n而且，萬一它們朝村子衝過去就糟了……）」"
  },
  "34": {
   "text": "「……！」"
  },
  "35": {
   "text": "「（必須阻止它們！絕對……！）」"
  },
  "36": {
   "text": "「師父曾說過！\n說我有使用槍的天賦……！」"
  },
  "37": {
   "text": "「喝……！哈啊……！」"
  },
  "38": {
   "text": "「」"
  },
  "39": {
   "text": "「……！」"
  },
  "40": {
   "text": "「咿咿咿……！」"
  },
  "41": {
   "text": "「……呼、呼。」"
  },
  "42": {
   "text": "「（好……好險。\n總算、擊退了它們……吧……）」"
  },
  "43": {
   "text": "「……！」"
  },
  "44": {
   "text": "「（……不行，不行。\n……身體，好重……）」"
  },
  "45": {
   "text": "「（而且，不知為何視野也模糊了……）」"
  },
  "46": {
   "text": "「（得趕快回村子去……。\n大家、會……、擔心我的……）」"
  },
  "47": {
   "text": "「」"
  },
  "48": {
   "text": "「」"
  },
  "49": {
   "text": "「……？」"
  },
  "50": {
   "text": "「……這是，什麼……」"
  },
  "51": {
   "text": "「……為什麼？」"
  },
  "52": {
   "text": "「家……。\n村子，還有所有東西都毀了……卻、沒有人……」"
  },
  "53": {
   "text": "「為什麼，沒有人……」"
  },
  "54": {
   "text": "「想要逃離這裡……？」"
  },
  "55": {
   "text": "「（帶著悲傷的表情，\n看著珍貴的世界毀滅嗎？）」"
  },
  "56": {
   "text": "「……！」"
  },
  "57": {
   "text": "「（剛才，那是……？）」"
  },
  "58": {
   "text": "「（是夢，一定是夢……。\n因為，那種事……！）」"
  },
  "59": {
   "text": "「（……那種事！）」"
  },
  "60": {
   "text": "「（如果，真的發生了……）」"
  },
  "61": {
   "text": "「……！」"
  },
  "62": {
   "text": "「（一切都會消失……。\n那種事，我不願意……！）」"
  },
  "63": {
   "text": "「必須去救……」"
  },
  "64": {
   "text": "「（在為時已晚之前。\n在失去之前，由我來……）」"
  },
  "65": {
   "text": "「（由我來拯救大家……！）」"
  },
  "66": {
   "text": "「」"
  },
  "67": {
   "text": "「咕嚕嚕嗚！」"
  },
  "68": {
   "text": "「叮鈴鈴……」"
  },
  "69": {
   "text": "「嗯，似乎是鐘聲把大家吸引過來的呢。」"
  },
  "70": {
   "text": "「原本希望能和平解決的……\n但現在已經不能這麼說了。」"
  },
  "71": {
   "text": "「」"
  },
  "72": {
   "text": "「……咕嚕嚕嗚！？」"
  },
  "73": {
   "text": "「而且，關於世界鐘的傳聞已經開始流傳了。」"
  },
  "74": {
   "text": "「因此，無知的人們會出於好奇闖入森林，\n這樣會造成阻礙。\n最好盡快解決。」"
  },
  "75": {
   "text": "「咕嚕嚕嗚！」"
  },
  "76": {
   "text": "「對不起各位，但這是為了履行使命。」"
  },
  "77": {
   "text": "「請讓一下。」"
  }
 },
