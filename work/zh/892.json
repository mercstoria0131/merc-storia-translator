 "lines": {
  "0": {
   "text": "「好啦，繼續加油哦☆」"
  },
  "1": {
   "text": "「唔……！」"
  },
  "2": {
   "text": "「啊啊～克蕾爾～！\n加油加油～！」"
  },
  "3": {
   "text": "「啊！克蕾爾小姐！\n快閃開呀！」"
  },
  "4": {
   "text": "「急速前進！」"
  },
  "5": {
   "text": "「呵呵，真厲害呢☆」"
  },
  "6": {
   "text": "「這次換我……」"
  },
  "7": {
   "text": "「什……麼！？」"
  },
  "8": {
   "text": "「怎麼了？\n克蕾爾的動作……」"
  },
  "9": {
   "text": "「呀！\n騎乘的電氣動作好奇怪呀！」"
  },
  "10": {
   "text": "「不會吧，難道……」"
  },
  "11": {
   "text": "「唔……還、還沒完呢！」"
  },
  "12": {
   "text": "「不見了……！？」"
  },
  "13": {
   "text": "「哎呀☆\n以為用那種電氣就能贏過我嗎？」"
  },
  "14": {
   "text": "「背後……！？」"
  },
  "15": {
   "text": "「糟糕！\n斯特魯拉多小姐的電氣已經進入攻擊狀態……」"
  },
  "16": {
   "text": "「我贏了哦☆」"
  },
  "17": {
   "text": "「唔……！」"
  },
  "18": {
   "text": "「勝、勝利者，斯特魯拉多選手！」"
  },
  "19": {
   "text": "「……」"
  },
  "20": {
   "text": "「怎麼會……」"
  },
  "21": {
   "text": "「……」"
  },
  "22": {
   "text": "「一個月後。」"
  },
  "23": {
   "text": "「……！」"
  },
  "24": {
   "text": "「我們再在這裡打一場吧。\n這次……」"
  },
  "25": {
   "text": "「要用好好調石過的元素電氣哦☆」"
  },
  "26": {
   "text": "「你……！」"
  },
  "27": {
   "text": "「唔……！」"
  },
  "28": {
   "text": "「果然，是調石不良……」"
  },
  "29": {
   "text": "「那麼，克蕾爾☆\n一個月後再見哦☆」"
  },
  "30": {
   "text": "「……」"
  },
  "31": {
   "text": "「塞哈奈魯～，調石！」"
  },
  "32": {
   "text": "「我知道啦。\n快把電氣借給我，我要檢查一下。」"
  },
  "33": {
   "text": "「好～的☆」"
  },
  "34": {
   "text": "「星星真煩人。」"
  },
  "35": {
   "text": "「那是我的身份認同啊！？」"
  },
  "36": {
   "text": "「從名為無聊的黑暗中，\n以娛樂照亮人們\n我這顆明星……！」"
  },
  "37": {
   "text": "「是是是。\n那件事我都知道……」"
  },
  "38": {
   "text": "「……」"
  },
  "39": {
   "text": "「……！」"
  },
  "40": {
   "text": "「……」"
  },
  "41": {
   "text": "「……」"
  },
  "42": {
   "text": "「克蕾爾……！」"
  },
  "43": {
   "text": "「哇！？」"
  },
  "44": {
   "text": "「咦！？\n啊、沒、沒事吧！？」"
  },
  "45": {
   "text": "「對、對不起，對不起！\n我站起來的時候，\n好像把飲料灑出來了……！」"
  },
  "46": {
   "text": "「坎托伊\n被淋得濕透了呢……。」"
  },
  "47": {
   "text": "「哇啊，衣服上有甜膩的味道……！\n對、對不起！\n有沒有東西可以擦……」"
  },
  "48": {
   "text": "「啊，\n但這好像不是擦一擦就能解決的……！\n該怎麼辦……」"
  },
  "49": {
   "text": "「不、不用緊！\n只是濕了而已，別那麼慌張！」"
  },
  "50": {
   "text": "「但、但是，好不容易穿的漂亮衣服\n被弄得黏糊糊的……！」"
  },
  "51": {
   "text": "「嘛，洗一洗應該就……」"
  },
  "52": {
   "text": "「洗……」"
  },
  "53": {
   "text": "「啊，對了！\n那個，體育場下面有可以自由使用的休息室，\n在那裡也可以洗衣服！」"
  },
  "54": {
   "text": "「作為賠罪，\n讓我幫你洗好嗎！？」"
  },
  "55": {
   "text": "「確實，穿著這副樣子到處走\n有點說不過去，這倒是幫了大忙……」"
  },
  "56": {
   "text": "「現在手邊沒有換洗的衣服。\n洗衣服的時候，我該不會被當成變態吧……？」"
  },
  "57": {
   "text": "「那就沒問題！\n我有帶換洗的衣服！」"
  },
  "58": {
   "text": "「這樣啊，那就安心……」"
  },
  "59": {
   "text": "「……咦？」"
  }
