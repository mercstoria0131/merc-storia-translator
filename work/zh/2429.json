 "lines": {
  "0": {
   "text": "「旁邊，可以坐嗎？」"
  },
  "1": {
   "text": "「……沒關係。」"
  },
  "2": {
   "text": "「你這年紀就當海兵了？\n階級是？」"
  },
  "3": {
   "text": "「一等兵。」"
  },
  "4": {
   "text": "「那收入大概得往後期待了。\n一等兵啊。」"
  },
  "5": {
   "text": "「我當海兵不是為了錢。\n是為了市民才當海兵的。」"
  },
  "6": {
   "text": "「連正經的志向都有啊？\n真是了不起。」"
  },
  "7": {
   "text": "「你是什麼人啊。\n明明才剛見面……。」"
  },
  "8": {
   "text": "「是嗎？\n我感覺跟你不是第一次見面呢。」"
  },
  "9": {
   "text": "「真是拙劣的搭訕話術。」"
  },
  "10": {
   "text": "「嘴真嚴厲啊。」"
  },
  "11": {
   "text": "「我很忙。\n只是拼桌沒關係，請自便。」"
  },
  "12": {
   "text": "「結果那件事最後還是泡湯了！\n太糟糕了吧！？\n我明明很努力了！」"
  },
  "13": {
   "text": "「嗯嗯，很努力呢，一等兵。」"
  },
  "14": {
   "text": "「對吧！？\n我有努力過吧！？」"
  },
  "15": {
   "text": "「很努力！\n你很棒！」"
  },
  "16": {
   "text": "「謝謝您！」"
  },
  "17": {
   "text": "「嗚嗚……，\n能聽我說說上次的任務嗎！？」"
  },
  "18": {
   "text": "「隨便說說看。」"
  },
  "19": {
   "text": "「啊，你……！\n真是個好人……！」"
  },
  "20": {
   "text": "「不不，沒你那麼好。」"
  },
  "21": {
   "text": "「然後？\n上次的任務是什麼？」"
  },
  "22": {
   "text": "「監視耶斯塔灣周邊海域，約一週。」"
  },
  "23": {
   "text": "「喔，那運氣真好！\n一週輕鬆賺到錢……，」"
  },
  "24": {
   "text": "「完全不是好工作！」"
  },
  "25": {
   "text": "「一週，\n盯著毫無動靜的海面\n拿錢！」"
  },
  "26": {
   "text": "「氣死人了！」"
  },
  "27": {
   "text": "「快瘋了！」"
  },
  "28": {
   "text": "「真認真啊。」"
  },
  "29": {
   "text": "「這是工作啊！」"
  },
  "30": {
   "text": "「不過，為什麼那裡\n也變得冷清了呢。\n以前明明很熱鬧的……。」"
  },
  "31": {
   "text": "「肯定是出現了大型魔寵，\n大家嚇得不敢靠近吧！\n都在說『希望海軍能解決一下』呢！」"
  },
  "32": {
   "text": "「唉呀！\n說得一點都沒錯嘛！」"
  },
  "33": {
   "text": "「真是亂糟糟的。」"
  },
  "34": {
   "text": "「亂到極點了！」"
  },
  "35": {
   "text": "「要喝果汁嗎？」"
  },
  "36": {
   "text": "「我開動了！」"
  },
  "37": {
   "text": "「……嗚嗚。\n嗚……。」"
  },
  "38": {
   "text": "「……我成為海兵，\n以為能幫到市民。\n但其實，完全不是那回事……。」"
  },
  "39": {
   "text": "「被人說海軍應該更盡責，\n我也無話可說。\n而且，老實說我甚至能理解那種心情……。」"
  },
  "40": {
   "text": "「唉……。\n我到底想在海軍做什麼呢……。」"
  },
  "41": {
   "text": "「嘛，別太在意了。\n因為這種無聊的事\n讓你失去志氣，多可惜啊。」"
  },
  "42": {
   "text": "「喂，老爹！\n咖哩……，」"
  },
  "43": {
   "text": "「賣完了。」"
  },
  "44": {
   "text": "「唉……。\n顧不上市民生活，\n連自己的肚子都填不飽的我……。」"
  },
  "45": {
   "text": "「那就把現在能端出來的全上吧。」"
  },
  "46": {
   "text": "「啊，那樣的話沒問題……，」"
  },
  "47": {
   "text": "「等等，全部！？\n您要吃那麼多嗎！？」"
  },
  "48": {
   "text": "「你不是餓了嗎？\n今天算我請客。」"
  },
  "49": {
   "text": "「欸！？」"
  },
  "50": {
   "text": "「你努力過了吧？」"
  },
  "51": {
   "text": "「雖、雖然有努力……，\n但我結局什麼都沒做到……，」"
  },
  "52": {
   "text": "「覺得自己什麼都沒做到，\n只是你這麼認為罷了。\n耶斯塔的監視，因為有你，\n可能也守護了某些東西吧？」"
  },
  "53": {
   "text": "「你對明天抱有希望。\n現在如此煩惱痛苦，正是證明。」"
  },
  "54": {
   "text": "「……。」"
  },
  "55": {
   "text": "「……，」"
  },
  "56": {
   "text": "「嗚、嗚嗚……，\n真的，謝謝你呀呀呀呀！」"
  },
  "57": {
   "text": "「又哭又吃，真忙碌啊！」"
  },
  "58": {
   "text": "「呀呀——呀呀！」"
  },
  "59": {
   "text": "「嗚嗚……，\n但是，真的沒關係嗎？\n點了這麼多，會很貴吧。」"
  },
  "60": {
   "text": "「別擔心啦，\n錢包裡還有點餘額……，」"
  },
  "61": {
   "text": "「咦？\n好像沒帶錢包。」"
  },
  "62": {
   "text": "「……。」"
  },
  "63": {
   "text": "「嗯嗯～？\n該不會忘在哪裡了吧～。」"
  },
  "64": {
   "text": "「喂——阿爾泰爾——。」"
  },
  "65": {
   "text": "「不、不用不用不用擔心！\n我、我雖然是個\n低階海兵，但還是能領到退職金的啦！」"
  },
  "66": {
   "text": "「別急著說！」"
  },
  "67": {
   "text": "「看來是走投無路了啊——。」"
  },
  "68": {
   "text": "「都是你的錯啦！」"
  },
  "69": {
   "text": "「別那麼慌張嘛。\n對了……，空。」"
  },
  "70": {
   "text": "「這個……，\n是耳環嗎？」"
  },
  "71": {
   "text": "「幸好有件值錢的私人物品救急。」"
  },
  "72": {
   "text": "「大叔，剩下的就交給你啦。」"
  },
  "73": {
   "text": "「啊，喂！\n你這釣魚的錢打算怎麼算！？」"
  },
  "74": {
   "text": "「就當作是工錢，拜託了。」"
  },
  "75": {
   "text": "「……。」"
  },
  "76": {
   "text": "「啊，一等兵。」"
  },
  "77": {
   "text": "「是、是！」"
  },
  "78": {
   "text": "「加油喔。」"
  },
  "79": {
   "text": "「……。」"
  },
  "80": {
   "text": "「我開動了～。」"
  },
  "81": {
   "text": "「真是……，還挺特別的傢伙呢。」"
  },
  "82": {
   "text": "「不過，他還是很好的喔。」"
  },
  "83": {
   "text": "「嗯？」"
  },
  "84": {
   "text": "「他絕對是好人！」"
  },
  "85": {
   "text": "「……你啊，真是單純呢。」"
  },
  "86": {
   "text": "「呵呵。\n感覺我好像能在海軍\n更努力了呢……，」"
  },
  "87": {
   "text": "「喂，你看！\n這張臉，跟剛才那個男人長得一模一樣吧！？」"
  },
  "88": {
   "text": "「這該不會是通緝犯的告示吧……，」"
  },
  "89": {
   "text": "「……。」"
  },
  "90": {
   "text": "「～♪」"
  },
  "91": {
   "text": "「哇啊啊啊啊！」"
  },
  "92": {
   "text": "「給我吃下這招！\n海兵衝撞！」"
  },
  "93": {
   "text": "「好險。」"
  },
  "94": {
   "text": "「哇——！」"
  },
  "95": {
   "text": "「是剛才那位一等兵啊。\n又想見我一面了？」"
  },
  "96": {
   "text": "「哼，擺著那副清爽的臉\n還敢這麼厚顏無恥！\n想裝傻可沒用！」"
  },
  "97": {
   "text": "「說的是什麼話？」"
  },
  "98": {
   "text": "「這個！\n這張通緝令！」"
  },
  "99": {
   "text": "「你該不會是海盜吧——！」"
  },
  "100": {
   "text": "「啊，這件事啊？」"
  },
  "101": {
   "text": "「你在那裡發什麼呆啊！」"
  },
  "102": {
   "text": "「我是海軍！你是海盜！\n我有責任審問你！」"
  },
  "103": {
   "text": "「真嚴肅啊～，\n剛才還一起吃飯呢。」"
  },
  "104": {
   "text": "「那是兩碼子事！\n請你跟我走一趟！」"
  },
  "105": {
   "text": "「一等兵，後面，後面。」"
  },
  "106": {
   "text": "「就算你這樣想轉移我的注意力也沒用……，」"
  },
  "107": {
   "text": "「噗噗——！」"
  },
  "108": {
   "text": "「哇——！」"
  },
  "109": {
   "text": "「魔、魔寵！\n為什麼偏偏這時候……，」"
  },
  "110": {
   "text": "「大概是你剛才\n把臉伸進牠們窩裡了吧。」"
  },
  "111": {
   "text": "「對不起！」"
  },
  "112": {
   "text": "「噗——！」"
  },
  "113": {
   "text": "「唔……！\n不、不得已了！」"
  },
  "114": {
   "text": "「那個，拔掉插銷……、\n丟！」"
  },
  "115": {
   "text": "「噗噗！？」"
  },
  "116": {
   "text": "「好……好！\n不愧是海軍的閃光彈！\n這樣……，」"
  },
  "117": {
   "text": "「一等兵～！\n加油～！」"
  },
  "118": {
   "text": "「你在旁邊悠閒地看什麼啊！？」"
  },
  "119": {
   "text": "「噗噗噗——！」"
  },
  "120": {
   "text": "「該死，這種程度……、」"
  },
  "121": {
   "text": "「啊，那個！？\n插銷沒拔……、」"
  },
  "122": {
   "text": "「噗嗚——！」"
  },
  "123": {
   "text": "「哎呀。」"
  },
  "124": {
   "text": "「噗！？」"
  },
  "125": {
   "text": "「你，為什麼……、」"
  },
  "126": {
   "text": "「讓開。」"
  },
  "127": {
   "text": "「咦，突然……噗咻！」"
  },
  "128": {
   "text": "「噗噗噗……！」"
  },
  "129": {
   "text": "「呼！」"
  },
  "130": {
   "text": "「噗噗！？」"
  },
  "131": {
   "text": "「這連暖身都不夠啊。」"
  },
  "132": {
   "text": "「噗……、噗噗！」"
  },
  "133": {
   "text": "「好、好厲害……、\n一個人對付那麼多……、」"
  },
  "134": {
   "text": "「等等，為什麼突然把我推開啊！」"
  },
  "135": {
   "text": "「沒咬到舌頭吧？\n真幸運～。」"
  },
  "136": {
   "text": "「請你體恤一下我！」"
  },
  "137": {
   "text": "「抱歉……。\n沒想到你會那麼想被魔寵\n撞擊。」"
  },
  "138": {
   "text": "「真的非常感謝。」"
  },
  "139": {
   "text": "「別放在心上。」"
  },
  "140": {
   "text": "「然後？\n你找我有事吧。」"
  },
  "141": {
   "text": "「是什麼來著？\n是要逮捕我來著？」"
  },
  "142": {
   "text": "「唔咕！」"
  },
  "143": {
   "text": "「本來以為能和你好好相處……、\n但你是海賊我是海軍，沒辦法。\n空。」"
  },
  "144": {
   "text": "「……還真是坦率。\n這麼輕易就舉手投降。」"
  },
  "145": {
   "text": "「對上你，就算戴著手銬我也有信心能贏。」"
  },
  "146": {
   "text": "「……。」"
  },
  "147": {
   "text": "「……。」"
  },
  "148": {
   "text": "「（被看扁了！）」"
  },
  "149": {
   "text": "「……真巧。\n其實我也覺得，對上你\n就算戴著手銬也贏不了。」"
  },
  "150": {
   "text": "「而且……、」"
  },
  "151": {
   "text": "「嗯？」"
  },
  "152": {
   "text": "「冷靜下來後，我想起一件事。\n雖然你是海賊，\n但我覺得你並不像是壞人。」"
  },
  "153": {
   "text": "「……。」"
  },
  "154": {
   "text": "「當然了！\n你粗暴、整天嬉皮笑臉、還瞧不起人！\n這些絕對得改！」"
  },
  "155": {
   "text": "「所以，我不給你戴手銬了。\n你為什麼成為通緝犯，\n能跟我說說嗎？」"
  },
  "156": {
   "text": "「那真是太好了。」"
  },
  "157": {
   "text": "「我也想起來了。\n你雖然只是個小卒子，實力也不強，\n但絕對是名正言順的海兵。」"
  },
  "158": {
   "text": "「……啊，對了。」"
  },
  "159": {
   "text": "「這是什麼……、」"
  },
  "160": {
   "text": "「剛才打架時掉出來的。\n是你的機密情報。」"
  },
  "161": {
   "text": "「哎呀～要是戴著手銬，就取不出來了……、」"
  },
  "162": {
   "text": "「內容，你看了嗎？」"
  },
  "163": {
   "text": "「沒看？」"
  },
  "164": {
   "text": "「沒看。」"
  },
  "165": {
   "text": "「沒看啊～。」"
  },
  "166": {
   "text": "「求求你了！\n這張筆記上寫的內容，\n請務必保密！」"
  },
  "167": {
   "text": "「不然的話，我可能會被海軍開除！\n所以這件事，請務必！\n保密！」"
  },
  "168": {
   "text": "「好啊。」"
  },
  "169": {
   "text": "「好溫柔！」"
  },
  "170": {
   "text": "「不過，可不能白給哦～。」"
  },
  "171": {
   "text": "「哇啊！？」"
  },
  "172": {
   "text": "「如、如果你願意保密，我做什麼都行！\n所以請……、」"
  },
  "173": {
   "text": "「對了。\n讓我幫你吧。」"
  },
  "174": {
   "text": "「這、這、幫忙？哪能……、」"
  },
  "175": {
   "text": "「咦？」"
  },
  "176": {
   "text": "「寶藏這種東西，可不是說找就能找到的。」"
  },
  "177": {
   "text": "「我挺喜歡你的。\n所以陪你殺殺時間吧。」"
  },
  "178": {
   "text": "「殺、殺時間……。」"
  },
  "179": {
   "text": "「對你來說，這也不算壞事吧？」"
  },
  "180": {
   "text": "「……。」"
  },
  "181": {
   "text": "「……你真的，願意陪我嗎？」"
  },
  "182": {
   "text": "「我剛不是說了嗎？」"
  },
  "183": {
   "text": "「……，」"
  },
  "184": {
   "text": "「啊，太感謝你了！\n我好開心！\n這幫大忙了！」"
  },
  "185": {
   "text": "「喂喂，別這麼誇張嘛。」"
  },
  "186": {
   "text": "「往後請多指教了！\n那個……、」"
  },
  "187": {
   "text": "「你，叫什麼名字？」"
  },
  "188": {
   "text": "「沒有名字。」"
  },
  "189": {
   "text": "「不可能沒有的啦。」"
  },
  "190": {
   "text": "「真的沒有啦。」"
  },
  "191": {
   "text": "「就是那種，不適合告訴你的名字。」"
  },
  "192": {
   "text": "「……。」"
  },
  "193": {
   "text": "「是那個傢伙嗎……。」"
  }
 },
