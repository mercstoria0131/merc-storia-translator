 "lines": {
  "0": {
   "text": "「……。」"
  },
  "1": {
   "text": "「……。」"
  },
  "2": {
   "text": "「……。」"
  },
  "3": {
   "text": "「（……那是。\n我，怎麼了……。\n怎麼，全身都痛……）」"
  },
  "4": {
   "text": "「（對了……，\n我是從飛翼龍背上掉下來的……）」"
  },
  "5": {
   "text": "「……！\n對了，飛翼龍！」"
  },
  "6": {
   "text": "「在哪裡……，」"
  },
  "7": {
   "text": "「咕……！，」"
  },
  "8": {
   "text": "「飛翼……，」"
  },
  "9": {
   "text": "「……，」"
  },
  "10": {
   "text": "「……，」"
  },
  "11": {
   "text": "「飛、飛翼龍……！」"
  },
  "12": {
   "text": "「怎、怎麼辦，傷這麼重……！\n菲莉婭，快治療……！」"
  },
  "13": {
   "text": "「不、不行！\n菲莉婭……，大家都不在這裡……！\n怎麼辦，我，只有我……！」"
  },
  "14": {
   "text": "「咕嚕嚕……，」"
  },
  "15": {
   "text": "「……，」"
  },
  "16": {
   "text": "「咕嚕嚕……！」"
  },
  "17": {
   "text": "「呀！\n又、又有另一隻魔寵過來了……！」"
  },
  "18": {
   "text": "「（怎、怎麼辦……！\n快逃，快逃……，）」"
  },
  "19": {
   "text": "「（……！）」"
  },
  "20": {
   "text": "「……不行。」"
  },
  "21": {
   "text": "「咕、咕……！，」"
  },
  "22": {
   "text": "「如果我逃了，\n誰來保護這隻傷得這麼重的飛翼龍，\n誰來為它處理傷口。」"
  },
  "23": {
   "text": "「必須由我來做……。\n這裡只有我一個人在。」"
  },
  "24": {
   "text": "「而且……，\n這是我，應該要做的事。」"
  },
  "25": {
   "text": "「　」"
  },
  "26": {
   "text": "「……！，上吧！」"
  },
  "27": {
   "text": "「　」"
  },
  "28": {
   "text": "「我是飛翼龍騎手的兒子，\n齊格弗里德·亞歷山大！」"
  },
  "29": {
   "text": "「這次，由我來對付！」"
  }
 },
 "warnings": []
}