  "13": {
   "text": "「」"
  },
  "14": {
   "text": "「……『同類』。」"
  },
  "15": {
   "text": "「……變異體。」"
  },
  "16": {
   "text": "「」"
  },
  "17": {
   "text": "「中庭……、」"
  },
  "18": {
   "text": "「已經……傍晚了嗎。」"
  },
  "19": {
   "text": "「因為你突然昏倒了，\n是艾歐和她把你搬過來的。\n我們一直在等你醒來。」"
  },
  "20": {
   "text": "「咕嚕……。」"
  },
  "21": {
   "text": "「……。」"
  },
  "22": {
   "text": "「艾歐、盧克……。」"
  },
  "23": {
   "text": "「原來如此。\n謝謝你們。」"
  },
  "24": {
   "text": "「貴公竟然也會向他人道謝呢。」"
  },
  "25": {
   "text": "「如果就這樣下去……、我大概會掉進動力爐裡。」"
  },
  "26": {
   "text": "「就算不這樣，\n貴公最終也難免要離開這世界吧？」"
  },
  "27": {
   "text": "「……。」"
  },
  "28": {
   "text": "「這種時候還說些有的沒的……！\n零，能說話就張開嘴！」"
  },
  "29": {
   "text": "「……。」"
  },
  "30": {
   "text": "「主治醫都叫你張嘴了，\n你別在那裡裝死啊！」"
  },
  "31": {
   "text": "「……。」"
  },
  "32": {
   "text": "「那個藥……、沒用的啦。」"
  },
  "33": {
   "text": "「喂你喝之後我就改良過了！\n有沒有效，不喝怎麼知道！」"
  },
  "34": {
   "text": "「……。」"
  },
  "35": {
   "text": "「零……！」"
  },
  "36": {
   "text": "「為什麼，你要比我先放棄啊！？」"
  },
  "37": {
   "text": "「你……、\n明明比我擁有更厲害的天賦啊！」"
  },
  "38": {
   "text": "「如果是你，連我救不了的人都能救……。」"
  },
  "39": {
   "text": "「不只是醫生，你什麼都能成為……！」"
  },
  "40": {
   "text": "「別拿『力量不足』當藉口，\n你明明能改變這個世界吧！？」"
  },
  "41": {
   "text": "「那個『存在』，不就是你自己嗎？」"
  },
  "42": {
   "text": "「自私自利、高高在上，把別人耍得團團轉。\n然後按照你的理想\n改變世界、推進時代……、」"
  },
  "43": {
   "text": "「這不就是你在充滿束縛的人生中，\n最大的願望嗎！？」"
  },
  "44": {
   "text": "「……。」"
  },
  "45": {
   "text": "「我……、」"
  },
  "46": {
   "text": "「……！？」"
  },
  "47": {
   "text": "「……。」"
  },
  "48": {
   "text": "「幹嘛啦。\n被抓住手臂就嚇成這樣，真丟臉。」"
  },
  "49": {
   "text": "「把藥給我喝吧。」"
  },
  "50": {
   "text": "「……。」"
  },
  "51": {
   "text": "「……張開嘴。」"
  },
  "52": {
   "text": "「嗯。」"
  },
  "53": {
   "text": "「……。」"
  },
  "54": {
   "text": "「……好難喝。」"
  },
  "55": {
   "text": "「明明可以讓貝格加很多糖的。」"
  },
  "56": {
   "text": "「……。」"
  },
  "57": {
   "text": "「有生效嗎。\n這個。」"
  },
  "58": {
   "text": "「……那種，不是速效藥。」"
  },
  "59": {
   "text": "「也是呢。」"
  },
  "60": {
   "text": "「……、」"
  },
  "61": {
   "text": "「不過……、」"
  },
  "62": {
   "text": "「要是有效就好了。」"
  },
  "63": {
   "text": "「咦？」"
  },
  "64": {
   "text": "「」"
  },
  "65": {
   "text": "「……。」"
  },
  "66": {
   "text": "「斯佩。」"
  },
  "67": {
   "text": "「」"
  },
  "68": {
   "text": "「溫暖嗎？」"
  },
  "69": {
   "text": "「……。」"
  },
  "70": {
   "text": "「喂。」"
  },
  "71": {
   "text": "「活下去，真是件孤獨的事啊。」"
  },
  "72": {
   "text": "「就算有了喜歡的人，\n也不可能永遠在一起。\n自己的事，得自己解決才甘心。」"
  },
  "73": {
   "text": "「……。」"
  },
  "74": {
   "text": "「但是……\n在與某人一起、\n朝著同一方向邁進的期間裡，」"
  },
  "75": {
   "text": "「那僅是過程的時間……」"
  },
  "76": {
   "text": "「為孤獨的人生，\n帶來了多餘、意外、\n卻珍貴的東西啊。」"
  },
  "77": {
   "text": "「」"
  },
  "78": {
   "text": "「」"
  },
  "79": {
   "text": "「」"
  },
  "80": {
   "text": "「」"
  },
  "81": {
   "text": "「」"
  },
  "82": {
   "text": "「」"
  },
  "83": {
   "text": "「」"
  },
  "84": {
   "text": "「」"
  },
  "85": {
   "text": "「我並不討厭你們。」"
  },
  "86": {
   "text": "「那些拼命努力、\n試圖改變世界、推動時代的靈魂……」"
  },
  "87": {
   "text": "「在我眼中，顯得格外耀眼。」"
  },
  "88": {
   "text": "「年幼時，我開始厭惡它。\n那個令人想哭、\n充滿無聊事物的世界。」"
  },
  "89": {
   "text": "「無法獨自立刻改變現狀的自己。\n即使被讚美多麼優秀，\n也覺得自己只是渺小的小孩。」"
  },
  "90": {
   "text": "「」"
  },
  "91": {
   "text": "「即便如此。」"
  },
  "92": {
   "text": "「與你們一起度過的時光，很開心。」"
  },
  "93": {
   "text": "「與像你們這樣、\n絕不放棄掙扎的靈魂一起生活，」"
  },
  "94": {
   "text": "「很開心。\n就像看到了我內心缺失的\n夢想與希望一樣。」"
  },
  "95": {
   "text": "「很開心……」"
  },
  "96": {
   "text": "「我並不討厭你們。」"
  },
  "97": {
   "text": "「……。」"
  },
  "98": {
   "text": "「即使沒有遇見你們，\n我也會隨性而活、隨性而死吧。」"
  },
  "99": {
   "text": "「我孤獨的人生……」"
  },
  "100": {
   "text": "「變得有趣了。」"
  },
  "101": {
   "text": "「絕不要放棄。\n即使在我不在的世界裡。」"
  },
  "102": {
   "text": "「靈魂，不能停止掙扎。」"
  },
  "103": {
   "text": "「生命，不該渴望燃盡。」"
  },
  "104": {
   "text": "「你們這種活法……」"
  },
  "105": {
   "text": "「我愛著你們。」"
  },
  "106": {
   "text": "「」"
  }
 },
