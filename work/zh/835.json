 "lines": {
  "0": {
   "text": "「暴走的魔寵啊啊啊！」"
  },
  "1": {
   "text": "「什麼！？」"
  },
  "2": {
   "text": "「雖然喊著是暴走的魔寵……，」"
  },
  "3": {
   "text": "「好像是在那邊耶，我們過去看看吧！」"
  },
  "4": {
   "text": "「這是……，」"
  },
  "5": {
   "text": "「鎮子一片狼藉……，」"
  },
  "6": {
   "text": "「咕嚕嚕嚕嚕嚕！」"
  },
  "7": {
   "text": "「看到了呀！\n有隻巨大的魔寵在暴走呀！」"
  },
  "8": {
   "text": "「哎呀呀，到處都一片狼藉呢！」"
  },
  "9": {
   "text": "「這下子，麻煩大了……！」"
  },
  "10": {
   "text": "「咕嚕嚕！」"
  },
  "11": {
   "text": "「情況不妙，照這樣下去森翁會遇到大麻煩……！」"
  },
  "12": {
   "text": "「但是，那麼巨大的魔寵……，\n到底是從哪裡來的……，」"
  },
  "13": {
   "text": "「不，比起那個，我們得盡快解決，\n否則損失只會越來越大！」"
  },
  "14": {
   "text": "「……請交給我吧。」"
  },
  "15": {
   "text": "「尤莉婭！？\n從這麼遠的地方射箭呀！？」"
  },
  "16": {
   "text": "「怎麼可能那麼遠！\n女性的力量根本射不……，」"
  },
  "17": {
   "text": "「射得到的！\n為了這種日子，我已經鍛鍊很久了……！」"
  },
  "18": {
   "text": "「（而且，靠得太近的話……，）」"
  },
  "19": {
   "text": "「（不不，現在要專心……！\n從這裡絕對不會失手。\n不能再讓鎮子被破壞了……，）」"
  },
  "20": {
   "text": "「……，」"
  },
  "21": {
   "text": "「尤莉婭？」"
  },
  "22": {
   "text": "「……，」"
  },
  "23": {
   "text": "「請退後。」"
  },
  "24": {
   "text": "「我要射了！」"
  },
  "25": {
   "text": "「咕嚕！？」"
  },
  "26": {
   "text": "「呀！？\n射偏了呀……，」"
  },
  "27": {
   "text": "「不，剛才那是故意射偏的！」"
  },
  "28": {
   "text": "「下次一定命中！\n不要再破壞鎮子了！」"
  },
  "29": {
   "text": "「咕嚕……，\n咕嚕嚕嚕嚕嚕！」"
  },
  "30": {
   "text": "「什……！」"
  },
  "31": {
   "text": "「你根本聽不進勸，\n還朝這邊衝過來了！」"
  },
  "32": {
   "text": "「這樣下去會撞上的！\n尤莉婭，快退後……，」"
  },
  "33": {
   "text": "「……，」"
  },
  "34": {
   "text": "「糟了……！\n該不會又因為恐懼症\n動彈不得了吧……！」"
  },
  "35": {
   "text": "「咕嚕嚕嚕嚕！」"
  },
  "36": {
   "text": "「尤莉婭！」"
  },
  "37": {
   "text": "「怎麼會在這種地方……！」"
  }
 },
