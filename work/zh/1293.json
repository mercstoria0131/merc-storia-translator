   "text": "「格拉拉……！」"
  },
  "11": {
   "text": "「……哈、哈啊……。」"
  },
  "12": {
   "text": "「……、走、走了嗎？」"
  },
  "13": {
   "text": "「……、\n……太好了……，」"
  },
  "14": {
   "text": "「我、保護到你了……，」"
  },
  "15": {
   "text": "「卡拉卡拉拉阿——！」"
  },
  "16": {
   "text": "「阿咕……！」"
