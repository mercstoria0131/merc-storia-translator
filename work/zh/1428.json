  "0": {
   "text": "「地板裂開了呢。」"
  },
  "1": {
   "text": "「切，真掃興！\n喂，地板要塌了！\n不想被捲進去就快閃開！」"
  },
  "2": {
   "text": "「哇啊啊！」"
  },
  "3": {
   "text": "「阿雷克！」"
  },
  "4": {
   "text": "「萊、萊伊吉……\n謝謝你。」"
  },
  "5": {
   "text": "「來，抓緊！\n我拉你上來！」"
  },
  "6": {
   "text": "「要是掉下去，\n醒來會很慘的啦！」"
  },
  "7": {
   "text": "「就是這樣。」"
  },
  "8": {
   "text": "「不過，\n地板塌了，下面直通底層……\n原因是……」"
  },
  "9": {
   "text": "「咕嚕嚕啦啦！」"
  },
  "10": {
   "text": "「魔寵？！\n原來是這樣，\n是這隻魔寵在下面，把天花板弄壞了！」"
  },
  "11": {
   "text": "「……！\n快看！\n下面有人……！」"
  },
  "12": {
   "text": "「那個人是……」"
  },
  "13": {
   "text": "「<name>、大家，\n沒事吧？」"
  },
  "14": {
   "text": "「在的！\n漢斯也……」"
  },
  "15": {
   "text": "「……」"
  },
  "16": {
   "text": "「漢斯？」"
  },
  "17": {
   "text": "「傑羅。」"
  },
  "18": {
   "text": "「……！」"
  },
  "19": {
   "text": "「<name>先生！\n快看，上面有人呀！」"
  },
  "20": {
   "text": "「那是……\n阿雷克和艾莉卡！」"
  },
  "21": {
   "text": "「太好了……\n沒事就好……！」"
  },
  "22": {
   "text": "「……！\n大家，別分心！」"
  },
  "23": {
   "text": "「咕嚕嚕啦啦！」"
  },
  "24": {
   "text": "「糟、糟糕了！\n這樣下去<name>他們會……！」"
  },
  "25": {
   "text": "「希魯哈托特、梅古拉特蒂！\n以保護市民為最優先！」"
  },
  "26": {
   "text": "「是！」"
  },
  "27": {
   "text": "「欸！？\n要爬下瓦礫堆嗎！？\n等、等等我呀！」"
  },
  "28": {
   "text": "「……我也要去！」"
  },
  "29": {
   "text": "「我、我也去！」"
  },
  "30": {
   "text": "「……」"
  },
  "31": {
   "text": "「怎麼辦，隊長。\n現在的話，很容易就能逃走了。」"
  },
  "32": {
   "text": "「……哼。」"
  },
  "33": {
   "text": "「走。\n你們，跟過來！」"
  },
  "34": {
   "text": "「索伊亞薩！」"
  }
 },
