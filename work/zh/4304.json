  "19": {
   "text": "「庫拉阿～！」"
  },
  "20": {
   "text": "「」"
  },
  "21": {
   "text": "「新的魔寵……！」"
  },
  "22": {
   "text": "「佩麗麗！」"
  },
  "23": {
   "text": "「庫拉阿ァアー！」"
  },
  "24": {
   "text": "「嗚嗚嗚嗚啊啊！」"
