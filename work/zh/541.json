  "0": {
   "text": "「我是青遲。\n請多指教。」"
  },
  "1": {
   "text": "「啊，是。\n請多指教。」"
  },
  "2": {
   "text": "「請多指教呀！」"
  },
  "3": {
   "text": "「好的，我會傾盡全力為您效勞的。」"
  },
  "4": {
   "text": "「不、不用那麼拼命吧？\n累了就說累了啊！？」"
  },
  "5": {
   "text": "「好的。」"
  },
  "6": {
   "text": "「（真的嗎……）」"
  },
  "7": {
   "text": "「她、她太乖了，\n反而讓人有點擔心呢……。」"
  },
  "8": {
   "text": "「是、是啊……。」"
  },
  "9": {
   "text": "「喂，如果真的累了……，咦？」"
  },
  "10": {
   "text": "「……。」"
  },
  "11": {
   "text": "「啊，青遲倒下了啊啊啊！？」"
  },
  "12": {
   "text": "「……抱歉。\n我正在進行斷食修行……，」"
  },
  "13": {
   "text": "「誰——！\n快上飯來！我要吃飯啊啊！」"
  },
  "14": {
   "text": "「餓到倒下的話，早點說啊！？」"
  },
  "15": {
   "text": "「這點程度，還不至於讓我放棄……，\n唔……。」"
  },
  "16": {
   "text": "「飯、飯——！\n快上飯——！」"
  },
  "17": {
   "text": "「總、總算解決了呢……。」"
  },
  "18": {
   "text": "「不能讓青遲離開視線呢……。」"
  },
  "19": {
   "text": "「是呀……。」"
  }
 },
