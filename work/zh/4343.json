  "50": {
   "text": "「啾！」"
  },
  "51": {
   "text": "「啾！ 啾啾～！」"
  },
  "52": {
   "text": "「圖圖？」"
  },
  "53": {
   "text": "「啾！」"
  },
  "54": {
