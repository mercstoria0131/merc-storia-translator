 "lines": {
  "0": {
   "text": "「啊啊啊——！」"
  },
  "1": {
   "text": "「好痛好痛……」"
  },
  "2": {
   "text": "「我、穿牆而過……」"
  },
  "3": {
   "text": "「……！\n不行，牆壁又變回普通牆壁了！」"
  },
  "4": {
   "text": "「……得想辦法跟<name>他們會合才行。\n既然穿牆而過，應該是在那條通道的旁邊。\n也許哪裡有回到原來的通道的路。」"
  },
  "5": {
   "text": "「咦？」"
  },
  "6": {
   "text": "「啾！」"
  },
  "7": {
   "text": "「芙芙！？」"
  },
  "8": {
   "text": "「啾——！」"
  },
  "9": {
   "text": "「是擔心我過來的嗎？\n……謝謝你。」"
  },
  "10": {
   "text": "「啾！」"
  },
  "11": {
   "text": "「哇啊啊啊——！」"
  },
  "12": {
   "text": "「……。」"
  },
  "13": {
   "text": "「等等，咦？\n好像沒有撞上去……」"
  },
  "14": {
   "text": "「在撞到地板之前，下落速度變緩了。\n大概是某種機關裝置吧。」"
  },
  "15": {
   "text": "「不過話說回來，我們到底掉到哪裡了……\n艾莉卡人在哪裡……」"
  },
  "16": {
   "text": "「……」"
  },
  "17": {
   "text": "「斯特拉？」"
  },
  "18": {
   "text": "「終於見面了呢。」"
  },
  "19": {
   "text": "「艾力亞斯……！」"
  },
  "20": {
   "text": "「咦？\n艾力亞斯是……」"
  },
  "21": {
   "text": "「……嘁，果然我沒辦法完美操控它。\n明明不需要以這種方式引發誤動作……」"
  },
  "22": {
   "text": "「……嗨，好久不見了。\n真不希望在這種地方相遇。」"
  }
 },
