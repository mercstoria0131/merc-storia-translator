 "lines": {
  "0": {
   "text": "「摩魯魯魯……嗚嗚……！」"
  },
  "1": {
   "text": "「」"
  },
  "2": {
   "text": "「剛才那道光……」"
  },
  "3": {
   "text": "「（那是什麼？\n那股扭曲感……）」"
  },
  "4": {
   "text": "「老師！？」"
  },
  "5": {
   "text": "「」"
  },
  "6": {
   "text": "「圖魯塔！？」"
  },
  "7": {
   "text": "「（在扭曲的另一端，\n是圖魯塔……！？）」"
  },
  "8": {
   "text": "「怎……怎麼回事呀？\n圖魯塔大人現在，\n應該在世界會議場才對呀！？」"
  },
  "9": {
   "text": "「到底發生了什麼……」"
  },
  "10": {
   "text": "「嗚……！」"
  },
  "11": {
   "text": "「這、這是什麼……！？」"
  },
  "12": {
   "text": "「提、提奧！\n身體不舒服嗎？沒關係吧！？」"
  },
  "13": {
   "text": "「唔……沒關係！\n我沒事！\n但是……」"
  },
  "14": {
   "text": "「摩魯魯魯……嗚嗚……！」"
  },
  "15": {
   "text": "「強烈的魔力流動，\n從帕皮永周圍噴湧而出……」"
  },
  "16": {
   "text": "「正朝那道扭曲處聚集……！」"
  },
  "17": {
   "text": "「……。」"
  },
  "18": {
   "text": "「卡伊里歐斯大人！\n這到底發生了什麼事……！？」"
  },
  "19": {
   "text": "「……。」"
  },
  "20": {
   "text": "「那道扭曲，是一扇門。」"
  },
  "21": {
   "text": "「門？\n是指……門之守護者開啟的那扇門嗎？」"
  },
  "22": {
   "text": "「在那扇門的另一端，能看見另一個世界。\n這種力量，我只知道這一種。」"
  },
  "23": {
   "text": "「但是，那孩子製造的門……」"
  },
  "24": {
   "text": "「規模太大，力量過強。」"
  },
  "25": {
   "text": "「再這樣下去，會將這個世界整個吞噬……！」"
  },
  "26": {
   "text": "「摩魯魯……嗚嗚！」"
  },
  "27": {
   "text": "「哇……！」"
  },
  "28": {
   "text": "「（水……進眼睛了……）」"
  },
  "29": {
   "text": "「……！？」"
  },
  "30": {
   "text": "「【你也選擇與人類共同生活嗎。】」"
  },
  "31": {
   "text": "「（剛才的聲音是……）」"
  },
  "32": {
   "text": "「（現在的記憶是。\n此刻，緊貼著這記憶持有者的心是）」"
  },
  "33": {
   "text": "「【那麼，以你們之王的身份下令吧。】」"
  },
  "34": {
   "text": "「【順著那顆心的願望，\n交織心意，締結緣分吧。】」"
  },
  "35": {
   "text": "「費尼夏爾……！」"
  },
  "36": {
   "text": "「我從夏爾那裡聽說了。\n聽說你的力量，在四柱之中也是特別的存在呢。」"
  },
  "37": {
   "text": "「願這份個性，不僅能守護你的王，\n也能成為助你踏上獨特旅程的助力，\n我也一同祈願著。」"
  },
  "38": {
   "text": "「」"
  },
  "39": {
   "text": "「」"
  },
  "40": {
   "text": "「」"
  },
  "41": {
   "text": "「哇！」"
  },
  "42": {
   "text": "「快看快看，是不認識的蝴蝶先生。\n他是從那個大洞裡出來的！」"
  },
  "43": {
   "text": "「看起來不是壞孩子呢。\n好像只是有點害羞罷了。」"
  },
  "44": {
   "text": "「你是誰呀？\n從洞的另一頭來的，旅人先生。」"
  },
  "45": {
   "text": "「……摩魯魯……！」"
  },
  "46": {
   "text": "「謝謝你，帕皮永·瓦爾特。\n來自不同世界，成為我們鄰居的你。」"
  },
  "47": {
   "text": "「如果你要回到原本的世界，\n我們會透過這扇門送你一程。」"
  },
  "48": {
   "text": "「當你再次來到這個世界時，\n我們會再次歡迎你這位異鄉人。」"
  },
  "49": {
   "text": "「啾嚕嚕！」"
  },
  "50": {
   "text": "「呀啊啊！」"
  },
  "51": {
   "text": "「為什麼突然魔寵們都暴動了？\n是我們做了什麼嗎……！」"
  },
  "52": {
   "text": "「……不是這樣。\n人類的王，對魔寵的王施了術法。」"
  },
  "53": {
   "text": "「怎麼會……」"
  },
  "54": {
   "text": "「……必須關閉那扇門。」"
  },
  "55": {
   "text": "「若讓人類與魔寵共存的世界\n那扇門繼續敞開……」"
  },
  "56": {
   "text": "「連我們的世界也會毀滅……！」"
  },
  "57": {
   "text": "「對不起。\n帕皮永·瓦爾特。」"
  },
  "58": {
   "text": "「如果你要傷害我們的話……」"
  },
  "59": {
   "text": "「」"
  },
  "60": {
   "text": "「【我給出的力量，\n讓妖精連結了我們的世界與他們的世界。】」"
  },
  "61": {
   "text": "「【然而，當我們的王與人類的皇帝爭鬥時，\n妖精卻切斷了\n我們世界與他們世界的連結。】」"
  },
  "62": {
   "text": "「【他們拋棄了我們……！】」"
  },
  "63": {
   "text": "「<name>大人！\n湖面上映出了帕皮永·瓦爾特的影子……！」"
  },
  "64": {
   "text": "「【我不明白。\n始祖費尼夏爾啊。\n始祖梅菲爾哈內啊。】」"
  },
  "65": {
   "text": "「【他們是否是想共同生活的生物，\n我一點也不明白。】」"
  },
  "66": {
   "text": "「【是勤勉溫柔、值得愛護的生靈，\n還是愚昧殘忍、令人恐懼的生靈】」"
  },
  "67": {
   "text": "「【你們為什麼，不拋棄他們呢】」"
  },
  "68": {
   "text": "「【我不明白……！】」"
  },
  "69": {
   "text": "「帕枇永……」"
  },
  "70": {
   "text": "「很痛苦呢。\n帕皮永·瓦爾特。」"
  },
  "71": {
   "text": "「你從始祖梅菲爾哈內那裡獲得了強大的力量。\n同樣地，你的心也開始\n稍微承接了始祖的心。」"
  },
  "72": {
   "text": "「」"
  },
  "73": {
   "text": "「」"
  },
  "74": {
   "text": "「我的心，正在折磨你。」"
  },
  "75": {
   "text": "「摩魯魯魯嗚嗚……！」"
  },
  "76": {
   "text": "「啾啾嗚……！」"
  },
  "77": {
   "text": "「什……麼！？」"
  },
  "78": {
   "text": "「（身體被扭曲的力量，拉扯著……！）」"
  },
  "79": {
   "text": "「哇啊啊啊！？」"
  },
  "80": {
   "text": "「<name>！」"
  },
  "81": {
   "text": "「<name>！」"
  },
  "82": {
   "text": "「切……！\n快點！」"
  },
  "83": {
   "text": "「」"
  },
  "84": {
   "text": "「……哈！？」"
  },
  "85": {
   "text": "「咦！？」"
  },
  "86": {
   "text": "「欸！？」"
  },
  "87": {
   "text": "「那、那是什麼！？\n怎麼突然有個女孩子從天上掉下來了！？」"
  },
  "88": {
   "text": "「（人類……！\n這裡不是妖精之國吧！？）」"
  },
  "89": {
   "text": "「啊啊啊啊……！」"
  },
  "90": {
   "text": "「呀哇啊啊……！」"
  },
  "91": {
   "text": "「啾嗚嗚——！」"
  },
  "92": {
   "text": "「該死……！\n<name>！」"
  },
  "93": {
   "text": "「（我……、在墜落？\n到底要去哪裡……！？）」"
  },
  "94": {
   "text": "「摩魯魯嗚嗚……！」"
  },
  "95": {
   "text": "「摩魯魯魯……！」"
  },
  "96": {
   "text": "「帕枇永……！」"
  },
  "97": {
   "text": "「……！冷靜一點！\n停止使用力量！」"
  },
  "98": {
   "text": "「摩魯魯嗚嗚嗚……！」"
  },
  "99": {
   "text": "「……！」"
  },
  "100": {
   "text": "「（我的聲音傳得到嗎？\n現在在我眼前的帕枇永\n其實只是我的錯覺……）」"
  },
  "101": {
   "text": "「（其實，他在更遠的地方……）」"
  },
  "102": {
   "text": "「<name>先生！」"
  },
  "103": {
   "text": "「用癒術……！」"
  },
  "104": {
   "text": "「憑藉你的力量，\n一定能靠近帕枇永的心靈！」"
  },
  "105": {
   "text": "「梅露可……！」"
  },
  "106": {
   "text": "「……！」"
  },
  "107": {
   "text": "「」"
  },
  "108": {
   "text": "「摩魯嗚嗚嗚！」"
  },
  "109": {
   "text": "「摩魯魯嗚嗚嗚……！」"
  },
  "110": {
   "text": "「呀哇！？」"
  },
  "111": {
   "text": "「」"
  },
  "112": {
   "text": "「」"
  },
  "113": {
   "text": "「梅露可！」"
  },
  "114": {
   "text": "「……！」"
  },
  "115": {
   "text": "「（手伸不過去……！）」"
  },
  "116": {
   "text": "「赫斯佩……、」"
  },
  "117": {
   "text": "「」"
  },
  "118": {
   "text": "「」"
  },
  "119": {
   "text": "「摩魯魯嗚……。」"
  },
  "120": {
   "text": "「摩魯魯魯嗚……！」"
  },
  "121": {
   "text": "「……！」"
  },
  "122": {
   "text": "「<name>！」"
  },
  "123": {
   "text": "「」"
  },
  "124": {
   "text": "「……。」"
  },
  "125": {
   "text": "「（發著光）」"
  },
  "126": {
   "text": "「（那枚戒指……）」"
  },
  "127": {
   "text": "「」"
  },
  "128": {
   "text": "「啊……。」"
  },
  "129": {
   "text": "「摩魯魯魯嗚……！」"
  },
  "130": {
   "text": "「摩魯魯嗚嗚！」"
  },
  "131": {
   "text": "「帕皮永·瓦爾特……！」"
  },
  "132": {
   "text": "「我不會說『我懂你的心情』。\n反正……、誰也無法\n真正理解別人的心情。」"
  },
  "133": {
   "text": "「但是，我。\n如果你就這樣傷害世界和大家，\n你一定會後悔的……！」"
  },
  "134": {
   "text": "「摩魯……、」"
  },
  "135": {
   "text": "「摩魯嗚嗚嗚……！」"
  },
  "136": {
   "text": "「傷害你的是過去的事！\n不是現在活著的<name>，\n也不是你現在所處的世界！」"
  },
  "137": {
   "text": "「摩魯魯魯嗚嗚嗚……！」"
  },
  "138": {
   "text": "「……。」"
  },
  "139": {
   "text": "「我……、」"
  },
  "140": {
   "text": "「我知道，我的鄰居們，\n都是我想一起活下去的人。」"
  },
  "141": {
   "text": "「就算確認了他人是怎樣的存在，\n哪一個才是你追求的真相，\n也只有你自己能選擇。」"
  },
  "142": {
   "text": "「是想和他們一起生活，\n還是不想與他們共存，\n都只能由你決定……！」"
  },
  "143": {
   "text": "「」"
  },
  "144": {
   "text": "「」"
  },
  "145": {
