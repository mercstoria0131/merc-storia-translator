  "0": {
   "text": "「耶～！我是茉莉呀！」"
  },
  "1": {
   "text": "「……等等，\n那個，我是茉莉。\n請多指教？」"
  },
  "2": {
   "text": "「咦？\n怎、怎麼了？」"
  },
  "3": {
   "text": "「沒什麼，就是這樣。\n我要成為同伴了，茉莉……」"
  },
  "4": {
   "text": "「啊～真是的！\n學不會姐姐的說話方式！\n下次再說吧！」"
  },
  "5": {
   "text": "「……呃，那個……。」"
  },
  "6": {
   "text": "「重新自我介紹，耶～！我是茉莉呀！\n哥哥！\n來玩討債遊戲吧！」"
  },
  "7": {
   "text": "「為什麼啊！？」"
  },
  "8": {
   "text": "「因為現在想玩了！\n快點快點！」"
  },
  "9": {
   "text": "「呃，好吧……。」"
  },
  "10": {
   "text": "「那麼，我當討債人囉！」"
  },
  "11": {
   "text": "「啊，好。\n那麼，請開始吧。」"
  },
  "12": {
   "text": "「為什麼！？\n哥哥你欠債了，應該要呼救才對！」"
  },
  "13": {
   "text": "「這又是為什麼！？」"
  },
  "14": {
   "text": "「快點嘛！」"
  },
  "15": {
   "text": "「真是拿你沒辦法……。\n確實，被討債人追的話，可能會求救吧。」"
  },
  "16": {
   "text": "「哇～討債人來了～！\n救救我～！」"
  },
  "17": {
   "text": "「呵呵呵。\n我要跟你斷絕金錢的緣分，斷絕，斷絕！\n討債人茉莉登場！」"
  },
  "18": {
   "text": "「這樣就沒問題了，哥哥！」"
  },
  "19": {
   "text": "「不是說要從討債人那裡逃掉嗎！？」"
  }
