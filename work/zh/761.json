 "lines": {
  "0": {
   "text": "「那個，我聽說你\n願意成為我們的同伴……」"
  },
  "1": {
   "text": "「……。」"
  },
  "2": {
   "text": "「點頭的話，\n就是願意一起旅行了吧？」"
  },
  "3": {
   "text": "「……。」"
  },
  "4": {
   "text": "「啊，謝謝你。」"
  },
  "5": {
   "text": "「……。」"
  },
  "6": {
   "text": "「……。」"
  },
  "7": {
   "text": "「那個……\n雖然該說的我說了，但巴希羅先生……」"
  },
  "8": {
   "text": "「不願意的話，直接拒絕也沒關係……！？」"
  },
  "9": {
   "text": "「呀～！\n這麼長，頭髮卻好柔順～！\n太適合做造型了～！」"
  },
  "10": {
   "text": "「骨頭好帥～！\n好硬～！」"
  },
  "11": {
   "text": "「喂，待會兒再讓我坐肩膀上～！」"
  },
  "12": {
   "text": "「不行～！\n介紹所的大姊之後，\n才輪到我摸頭髮的！」"
  },
  "13": {
   "text": "「欸～，要守順序啦～！」"
  },
  "14": {
   "text": "「……。」"
  },
  "15": {
   "text": "「從剛才開始就一直……」"
  },
  "16": {
   "text": "「被介紹所的大姊\n弄成很可愛的髮型」"
  },
  "17": {
   "text": "「被孩子們戳骨頭、\n在身上爬來爬去，\n甚至直接在上面吵架……！」"
  },
  "18": {
   "text": "「這樣下去，\n會變成那種帶孩子帶到筋疲力盡的爸爸吧！」"
  },
  "19": {
   "text": "「……？」"
  },
  "20": {
   "text": "「就算歪著頭問……！」"
  },
  "21": {
   "text": "「你們別在巴希羅先生背上吵架啦……。\n還有別戳骨頭，\n最近甚至開始像敲鼓一樣敲了……。」"
  },
  "22": {
   "text": "「巴希羅先生會累壞的！」"
  },
  "23": {
   "text": "「欸～！」"
  },
  "24": {
   "text": "「巴希羅先生不討厭我們，沒關係啦～！」"
  },
  "25": {
   "text": "「就是嘛！」"
  },
  "26": {
   "text": "「再玩一下下就好～！」"
  },
  "27": {
   "text": "「沒關係啦，小氣～！」"
  },
  "28": {
   "text": "「說什麼小氣，我其實……」"
  },
  "29": {
   "text": "「哇！\n巴、巴希羅先生！？\n為什麼要讓我坐肩膀上……」"
  },
  "30": {
   "text": "「……。」"
  },
  "31": {
   "text": "「一副達成目標的表情幹嘛！？」"
  },
  "32": {
   "text": "「總、總之我本來也想玩，\n才沒有要阻止你們啦～！」"
  }
