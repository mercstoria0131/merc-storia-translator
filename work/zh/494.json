  "1": {
   "text": "「你還要嚇到什麼時候呀……。」"
  },
  "2": {
   "text": "「因、因為～……。」"
  },
  "3": {
   "text": "「已經沒事了。\n好像抵達村子了。」"
  },
  "4": {
   "text": "「好、好耶！」"
  },
  "5": {
   "text": "「……等等，那是？」"
  },
  "6": {
   "text": "「怎麼感覺\n沒有想像中那麼熱鬧呀……。」"
  },
  "7": {
   "text": "「話說回來，……未免也太安靜了吧？」"
  },
  "8": {
   "text": "「呀！？\n村口好像有人呀！」"
  },
  "9": {
   "text": "「……得回村子才行……，\n但是……，\n……已經走不動了……，」"
  },
  "10": {
   "text": "「怎、怎麼了呀！？」"
  },
  "11": {
   "text": "「……走路好麻煩，好累……。」"
  },
  "12": {
   "text": "「……呀？」"
  },
  "13": {
   "text": "「……詛咒……。\n罐子……。」"
  },
  "14": {
   "text": "「詛咒？\n……罐子？」"
  },
  "15": {
   "text": "「魯魯魯魯！」"
  },
  "16": {
   "text": "「大家！\n是魔寵！\n是剛才剩下的那隻！」"
  },
  "17": {
   "text": "「進村之前先在這裡擋住它！」"
  }
