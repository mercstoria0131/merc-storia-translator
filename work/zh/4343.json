  "78": {
   "text": "「啾！」"
  },
  "79": {
   "text": "「……啊，謝謝！」"
  },
  "80": {
   "text": "「請相信並等著我。\n我會敲響鐘，回來的……！」"
  },
  "81": {
   "text": "「和<name>一起！」"
  },
  "82": {
   "text": "「啾！」"
  },
  "83": {
   "text": "「呼啊、呼啊……！」"
  },
  "84": {
   "text": "「嘎魯魯魯！」"
  },
  "85": {
   "text": "「嘎魯阿阿……！」"
  },
  "86": {
   "text": "「又有另一隻魔寵……！\n是被藍色結晶吸引過來的呀！？」"
  },
  "87": {
   "text": "「厄爾庇斯！」"
  },
  "88": {
   "text": "「啊，再、再給我一點時間……！」"
  },
  "89": {
   "text": "「……拜託了，赫斯佩拉！」"
  },
  "90": {
   "text": "「喔魯魯！」"
