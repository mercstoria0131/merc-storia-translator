  },
  "32": {
   "text": "「切……。」"
  },
  "33": {
   "text": "「沒辦法了……！」"
  },
  "34": {
   "text": "「……？\n剛才那道光，是什麼……、」"
  },
  "35": {
   "text": "「那……！？」"
