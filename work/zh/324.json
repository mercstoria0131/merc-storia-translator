  "0": {
   "text": "「哇、哇，這些人好強～！」"
  },
  "1": {
   "text": "「好了，\n快說你們隊長在哪裡！」"
  },
  "2": {
   "text": "「不不不不，這是秘密！」"
  },
  "3": {
   "text": "「隊長是我們的恩人！\n就算受搔癢刑也不說！」"
  },
  "4": {
   "text": "「恩人……？」"
  },
  "5": {
   "text": "「呀～呀～！\n看來我的團員受過照顧呢！？」"
  },
  "6": {
   "text": "「……！？」"
  },
  "7": {
   "text": "「突然攻擊人，真沒禮貌！」"
  },
  "8": {
   "text": "「傑、傑羅隊長——！」"
  },
  "9": {
   "text": "「喂喂，\n別指望盜賊會有你們那種常識啊？\n我們過的是另一種生活嘛！」"
  },
  "10": {
   "text": "「說得對……。\n惡者皆滅！\n只要這樣就好！」"
  },
  "11": {
   "text": "「咕嚕嚕嚕！」"
  },
  "12": {
   "text": "「糟糕……！\n在森林裡鬧出動靜，\n好像惹惱了魔寵……！」"
  },
  "13": {
   "text": "「這下好了！\n魔寵就交給你們，我們撤退！\n快換個據點！」"
  },
  "14": {
   "text": "「哇、不愧是隊長！\n動作真快！」"
  },
  "15": {
   "text": "「別那樣說……！」"
  },
  "16": {
   "text": "「等、等一下！」"
  },
  "17": {
   "text": "「咕嚕！」"
  },
  "18": {
   "text": "「快走！\n這裡交給我們處理！」"
  },
  "19": {
   "text": "「……！\n……不能拋下恩人！」"
  }
