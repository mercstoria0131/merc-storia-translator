 "lines": {
  "0": {
   "text": "「咦？\n塔塔恩卡呢？\n不是說差不多該出發了嗎……」"
  },
  "1": {
   "text": "「抱歉，可能來晚了。」"
  },
  "2": {
   "text": "「啊，塔塔恩卡！\n沒關係啦，是發生什麼事了嗎？」"
  },
  "3": {
   "text": "「那個……」"
  },
  "4": {
   "text": "「嗯？\n圍巾下面好像動來動去的？」"
  },
  "5": {
   "text": "「喵！」"
  },
  "6": {
   "text": "「剛才那聲……是塔塔恩卡的聲音嗎？」"
  },
  "7": {
   "text": "「怎麼可能，你是笨蛋嗎？」"
  },
  "8": {
   "text": "「開玩笑被認真回擊了……！」"
  },
  "9": {
   "text": "「其實……剛剛在那邊\n看到一隻受傷的貓，就幫它處理了傷口。\n結果它就一直跟過來……」"
  },
  "10": {
   "text": "「喂，可以一起帶走嗎？」"
  },
  "11": {
   "text": "「欸？」"
  },
  "12": {
   "text": "「嗯……\n好吧，既然塔塔恩卡想帶就帶吧……」"
  },
  "13": {
   "text": "「真的嗎？\n太好了……\n謝謝你。」"
  },
  "14": {
   "text": "「你也開心了吧。」"
  },
  "15": {
   "text": "「喵！」"
  },
  "16": {
   "text": "「（嘛，一隻的話照顧起來應該沒問題）」"
  },
  "17": {
   "text": "「那麼，差不多該出發了。」"
  },
  "18": {
   "text": "「嗯。」"
  },
  "19": {
   "text": "「喵喵喵……！」"
  },
  "20": {
   "text": "「咕咕咕……！」"
  },
  "21": {
   "text": "「汪汪汪……！」"
  },
  "22": {
   "text": "「這、這是怎麼回事……。\n介紹所外面有一大群動物……！」"
  },
  "23": {
   "text": "「啊，那裡的是前幾天幫它處理傷口的狗……！\n那邊的是昨天分給牠飯吃的鳥……！\n這邊的是……」"
  },
  "24": {
   "text": "「……。」"
  },
  "25": {
   "text": "「喂，<name>……。」"
  },
  "26": {
   "text": "「怎、怎麼了？」"
  },
  "27": {
   "text": "「大家好像都想一起去，\n那個……可以一起帶去旅行嗎？」"
  },
  "28": {
   "text": "「這、這個數量，應該有點困難吧……。」"
  },
  "29": {
   "text": "「也是呢……。\n而且跟著去旅行的話，\n可能也會有危險……。」"
  },
  "30": {
   "text": "「大家，對不起……。」"
  },
  "31": {
   "text": "「雖然捨不得，但還是得走了。」"
  },
  "32": {
   "text": "「嗯。」"
  },
  "33": {
   "text": "「喵、喵喵嗚……！」"
  },
  "34": {
   "text": "「咕咕咕……！」"
  },
  "35": {
   "text": "「嗚嗚嗚……！」"
  },
  "36": {
   "text": "「怎、怎麼這麼悲傷的鳴叫聲……！」"
  },
  "37": {
   "text": "「喂，<name>……。」"
  },
  "38": {
   "text": "「……好、好吧。\n出發延後一天，\n你們好好告別吧。」"
  },
  "39": {
   "text": "「……！\n可、可以嗎？」"
  },
  "40": {
   "text": "「……反正，\n被動物們抱住腳不放的話，\n也出發不了嘛……。」"
  },
  "41": {
   "text": "「喵喵嗚……！」"
  },
  "42": {
   "text": "「也是呢……。」"
  },
  "43": {
   "text": "「（當時的我還不知道……。\n接下來因為動物們的陰謀，\n出發被迫再延後一週的事……）」"
  }
 },
