{
 "id": 2997,
 "title": "動物之國",
 "title_ja": "動物の国",
 "model": "ollama:qwen3.8:27b",
 "time": "2026-11-06 02:11:40",
 "lines": {
  "0": {
   "text": "「嗚嗚嗚！」"
  },
  "1": {
   "text": "「……嗚嗚嗚！」"
  },
  "2": {
   "text": "「啾啾啾啾……！」"
  },
  "3": {
   "text": "「……啾啾啾啾。」"
  },
  "4": {
   "text": "「咩咩咩咩！」"
  },
  "5": {
   "text": "「……咩咩咩咩！」"
  },
  "6": {
   "text": "「……。呼……。」"
  },
  "7": {
   "text": "「咕嚕嚕嚕嚕嚕嚕嚕嚕！」"
  },
  "8": {
   "text": "「……。」"
  },
  "9": {
   "text": "「……為什麼？」"
  },
  "10": {
   "text": "「咕嚕嚕嚕嚕嚕嚕嚕！」"
  },
  "11": {
   "text": "「……。」"
  },
  "12": {
   "text": "「為什麼……、為什麼啊！？」"
  },
  "13": {
   "text": "「咕嚕嚕嚕嚕！咕嚕嚕嚕嚕！」"
  },
  "14": {
   "text": "「嗚嗚嗚嗚嗚嗚！」"
  },
  "15": {
   "text": "「呼啊啊啊啊啊……。」"
  },
  "16": {
   "text": "「……哈。睡飽了。」"
  },
  "17": {
   "text": "「啾……。」"
  },
  "18": {
   "text": "「早安呀，雷耶。」"
  },
  "19": {
   "text": "「嗯，早安～。」"
  },
  "20": {
   "text": "「咦，厄爾庇斯呢？\n今天輪到吃飯當值嗎？」"
  },
  "21": {
   "text": "「不是的呀。\n她說要在早餐前去修行呀。」"
  },
  "22": {
   "text": "「啊……這樣啊。」"
  },
  "23": {
   "text": "「從離開植物之國後就一直……是吧。」"
  },
  "24": {
   "text": "「本人努力是好事，但是……。」"
  },
  "25": {
   "text": "「雷耶，你有猜測到原因吧？」"
  },
  "26": {
   "text": "「嗯、嗯。可是……。」"
  },
  "27": {
   "text": "「呀呀，沒關係的呀。\n也有不能說出口的事情呀。」"
  },
  "28": {
   "text": "「……謝謝。」"
  },
  "29": {
   "text": "「那個……、我該起床了，\n梅露可要一起來嗎？」"
  },
  "30": {
   "text": "「我在等提奧呀。\n應該快起床了吧。」"
  },
  "31": {
   "text": "「喔～早安。」"
  },
  "32": {
   "text": "「知道了。那回頭見。」"
  },
  "33": {
   "text": "「是呀～。」"
  },
  "34": {
   "text": "「呼哇～，早……，」"
  },
  "35": {
   "text": "「咕啊啊啊，好刺眼！\n要、要融化了～！」"
  },
  "36": {
   "text": "「……唔，嗚嗚。\n為什麼太陽那麼刺眼啊……。」"
  },
  "37": {
   "text": "「嗯嗯……好了好了，習慣了。」"
  },
  "38": {
   "text": "「嘿！看招！」"
  },
  "39": {
   "text": "「啊……。」"
  },
  "40": {
   "text": "「耶～！」"
  },
  "41": {
   "text": "「靠蠻力是有力氣才用得上的戰法！\n沒力氣的你，不混點假動作就贏不了！」"
  },
  "42": {
   "text": "「唔……！」"
  },
  "43": {
   "text": "「……。」"
  },
  "44": {
   "text": "「厄爾庇斯……。」"
  },
  "45": {
   "text": "「那是因為你還不夠成熟。\n連鈴都被奪走……真丟臉。」"
  },
  "46": {
   "text": "「你作為奏鐘士的實力，實在太不足了。」"
  },
  "47": {
   "text": "「（果然她還在在意\n當時的事情啊）」"
  },
  "48": {
   "text": "「（當時聽到的只有我和赫斯佩拉……。\n我知道她聽到了什麼）」"
  },
  "49": {
   "text": "「（可是……）」"
  },
  "50": {
   "text": "「哈啊……該怎麼辦啊。」"
  },
  "51": {
   "text": "「（我從來沒鼓勵過別人～！\n而且，我一直都是被鼓勵的那一方！）」"
  },
  "52": {
   "text": "「（啊～，被說什麼會開心呢？\n不過不管說什麼，好像都會開心呢！）」"
  },
  "53": {
   "text": "「（啊～，啊～，這種事情，\n正是厄爾庇斯或\n梅露可的拿手好戲啊……）」"
  },
  "54": {
   "text": "「（乾脆去問大家？\n不行不行，厄爾庇斯應該不想被當成重要人物。\n果然還是我自己解決……！）」"
  },
  "55": {
   "text": "「但我能做些什麼呢～！」"
  },
  "56": {
   "text": "「一大早就有精神呢。」"
  },
  "57": {
   "text": "「完全不行啊。\n恨自己沒鍛鍊過溝通能力……，」"
  },
  "58": {
   "text": "「哎呀，良巴早安！」"
  },
  "59": {
   "text": "「嗨，早安。」"
  },
  "60": {
   "text": "「早安，蕾雅～。」"
  },
  "61": {
   "text": "「厄、厄爾庇斯……。」"
  },
  "62": {
   "text": "「嗚嚕嚕。」"
  },
  "63": {
   "text": "「哇啊啊啊赫斯佩拉！」"
  },
  "64": {
   "text": "「嗚嚕嚕……。」"
  },
  "65": {
   "text": "「對、對不起……。\n抱歉打擾了。」"
  },
  "66": {
   "text": "「沒關係，剛好結束了。\n我去擦擦身體。」"
  },
  "67": {
   "text": "「嗯、嗯。去吧……。」"
  },
  "68": {
   "text": "「我也來準備早餐吧～。\n蕾雅不用在意，繼續吧。」"
  },
  "69": {
   "text": "「繼、繼續什麼……。\n咦，這樣抱著頭發抖就好嗎？」"
  },
  "70": {
   "text": "「如果這樣能振作起來的話……。\n不，那邊那邊。」"
  },
  "71": {
   "text": "「那邊……。」"
  },
  "72": {
   "text": "「……咦？\n為什麼我拿著速寫本。」"
  },
  "73": {
   "text": "「那是因為你在畫畫啊。」"
  },
  "74": {
   "text": "「畫畫。」"
  },
  "75": {
   "text": "「畫畫啊啊啊！？」"
  },
  "76": {
   "text": "「對了，在植物之國買過顏料之類的吧。\n感覺如何，第一次用畫具的感覺。」"
  },
  "77": {
   "text": "「超棒的～。\n畫起來的感覺無與倫比～。」"
  },
  "78": {
   "text": "「而且，這是速寫本吧？　好厲害。\n全是紙耶。太豪華了要流鼻血了。」"
  },
  "79": {
   "text": "「喔～，別流出來喔～。」"
  },
  "80": {
   "text": "「好的。」"
  },
  "81": {
   "text": "「那麼～！」"
  },
  "82": {
   "text": "「等等，為什麼我在畫畫！\n現在不是時候啊喂！」"
  },
  "83": {
   "text": "「在厄爾庇斯煩惱的時候！\n這個畫畫白痴啊啊啊啊！」"
  },
  "84": {
   "text": "「……我是不是說了什麼壞話？」"
  },
  "85": {
   "text": "「該死！\n這種畫什麼的！這種畫什麼的～！」"
  },
  "86": {
   "text": "「撕不碎……！」"
  },
  "87": {
   "text": "「我回來了……怎麼了。」"
  },
  "88": {
   "text": "「完全不知道。」"
  },
  "89": {
   "text": "「嗚，原諒我厄爾庇斯……。\n原諒我這個沒用的傢伙……。」"
  },
  "90": {
   "text": "「沒關係，我原諒你。」"
  },
  "91": {
   "text": "「果然不能原諒……。」"
  },
  "92": {
   "text": "「到底要哪個啦。」"
  },
  "93": {
   "text": "「嗚嗚……。從早上開始就這麼熱鬧啊。」"
  },
  "94": {
   "text": "「早安。\n……等等，為什麼雷耶在發呆啊。」"
  },
  "95": {
   "text": "「啾啾。」"
  },
  "96": {
   "text": "「大叔我是無辜的。」"
  },
  "97": {
   "text": "「我什麼都沒說啊。」"
  },
  "98": {
   "text": "「啊～，大家都醒了～。\n早安……。」"
  },
  "99": {
   "text": "「是呀～。」"
  },
  "100": {
   "text": "「早安，大家。」"
  },
  "101": {
   "text": "「提奧，去洗臉吧。」"
  },
  "102": {
   "text": "「好～。」"
  },
  "103": {
   "text": "「那，我也去。\n早飯值班的是誰來著。」"
  },
  "104": {
   "text": "「我。\n喜歡甜蛋捲的人舉手。」"
  },
  "105": {
   "text": "「好。」"
  },
  "106": {
   "text": "「我要加生薑的……。」"
  },
  "107": {
   "text": "「好好好。\n喂，蕾雅你也去洗個臉清醒一下。」"
  },
  "108": {
   "text": "「嗯～」"
  },
  "109": {
   "text": "「（唉～，真的難以置信……。\n在那種狀態下畫畫，\n我到底是怎麼想的啊！）」"
  },
  "110": {
   "text": "「（現在應該考慮厄爾庇斯的事才對！\n哪有時間畫這種畫……！）」"
  },
  "111": {
   "text": "「哪有時間……。」"
  },
  "112": {
   "text": "「……。」"
  },
  "113": {
   "text": "「感覺平衡有點不對。\n這裡改一下……，嗯～……？」"
  },
  "114": {
   "text": "「……咕嚕嚕。」"
  },
  "115": {
   "text": "「話說回來，但是。」"
  },
  "116": {
   "text": "「嗯？\n啊，圖魯塔。那個拿過去。」"
  },
  "117": {
   "text": "「好嘞～。」"
  },
  "118": {
   "text": "「然後，怎麼了梅露可？」"
  },
  "119": {
   "text": "「昨晚，動物叫得很厲害，對吧？」"
  },
  "120": {
   "text": "「啊，對了，確實有各種叫聲。\n狗啊、貓之類的。」"
  },
  "121": {
   "text": "「有貓耶！」"
  },
  "122": {
   "text": "「只是聽到叫聲而已喔？」"
  },
  "123": {
   "text": "「還有，庫庫杜杜杜之類的聲音也有。」"
  },
  "124": {
   "text": "「不，那是喔喔喔喔喔吧。」"
  },
  "125": {
   "text": "「不不不，絕對不只是喔喔喔喔喔。\n絕對沒有。」"
  },
  "126": {
   "text": "「我也聽到了。\n……帕奧恩之類的。」"
  },
  "127": {
   "text": "「這片森林的生態系是怎麼回事呀？」"
  },
  "128": {
   "text": "「這嘛……。\n總之，真是名副其實的感覺呢。」"
  },
  "129": {
   "text": "「動物之國……。」"
  },
  "130": {
   "text": "「果然有很多貓嗎！？」"
  },
  "131": {
   "text": "「試著叫叫看吧。」"
  },
  "132": {
   "text": "「喵嗷～！」"
  },
  "133": {
   "text": "「呀嗷～！」"
  },
  "134": {
   "text": "「呼嗚嗚……！」"
  },
  "135": {
   "text": "「為什麼在威嚇啊。」"
  },
  "136": {
   "text": "「喂，小魔女。\n帳篷收好了喔。」"
  },
  "137": {
   "text": "「好～，捲起來～。」"
  },
  "138": {
   "text": "「啾。」"
  },
  "139": {
   "text": "「嗯，確實是野生動物很多的國家呢。\n行李放這裡喔。」"
  },
  "140": {
   "text": "「嗚～，好重好重……。」"
  },
  "141": {
   "text": "「良巴先生來過這裡嗎？」"
  },
  "142": {
   "text": "「是啊。看過很多動物喔～。」"
  },
  "143": {
   "text": "「貓之類的！？」"
  },
  "144": {
   "text": "「野豬之類的。」"
  },
  "145": {
   "text": "「野豬啊……。」"
  },
  "146": {
   "text": "「嗚，是動物啊……。」"
  },
  "147": {
   "text": "「蕾雅，動物呢？」"
  },
  "148": {
   "text": "「電氣之國幾乎沒有動物呢。\n完全不知道該怎麼應對。」"
  },
  "149": {
   "text": "「呵呵呵……，這趟旅程會很艱難呢。」"
  },
  "150": {
   "text": "「蕾、蕾雅姊姊……。」"
  },
  "151": {
   "text": "「話說回來，這裡被稱為動物之國，\n並不是因為野生動物很多的意思。」"
  },
  "152": {
   "text": "「咦？」"
  },
  "153": {
   "text": "「在這個國家生活的居民，\n都擁有動物的特徵喔。」"
  },
  "154": {
   "text": "「這不就是說大家都有獸耳嘛！」"
  },
  "155": {
   "text": "「蕾雅姊姊，你的情緒好可怕喔！」"
  },
  "156": {
   "text": "「動物的特徵……。」"
  },
  "157": {
   "text": "「」"
  },
  "158": {
   "text": "「」"
  },
  "159": {
   "text": "「」"
  },
  "160": {
   "text": "「……感覺很懷念呢。」"
  },
  "161": {
   "text": "「是呀。」"
  },
  "162": {
   "text": "「在電氣之國話題沸騰的獸耳，\n沒想到竟然能親眼見到……呵呵呵。」"
  },
  "163": {
   "text": "「獸耳和動物不一樣嗎？」"
  },
  "164": {
   "text": "「是不同屬性喔！」"
  },
  "165": {
   "text": "「屬性是……。」"
  },
  "166": {
   "text": "「雖然可以興奮，但\n也要小心一點喔～。」"
  },
  "167": {
   "text": "「呀，有什麼危險的事情嗎？」"
  },
  "168": {
   "text": "「在某些地方是有的。\n植物之國是舊時代和新時代分開的，對吧？」"
  },
  "169": {
   "text": "「這裡則是按種族分開的。\n就是犬族、貓族、鱗族這種情況。」"
  },
  "170": {
   "text": "「就像我們那邊的世界一樣嗎。」"
  },
  "171": {
   "text": "「世界？」"
  },
  "172": {
   "text": "「這裡是按甜點種類分開的。\n像是巧克力世界、軟糖世界……那樣。」"
  },
  "173": {
   "text": "「真是充滿夢想的世界呢……。」"
  },
  "174": {
   "text": "「大叔我已經胸悶了。」"
  },
  "175": {
   "text": "「各個種族的文化差異很大呢。\n搞不好會發生麻煩。」"
  },
  "176": {
   "text": "「良巴先生也遇到過什麼事嗎？」"
  },
  "177": {
   "text": "「不小心闖進犬族的村子裡了……。\n被那裡的大哥狠狠威嚇了一頓……。」"
  },
  "178": {
   "text": "「威嚇……。」"
  },
  "179": {
   "text": "「嗚，開始感到不安了……。」"
  },
  "180": {
   "text": "「嘛，只要看地圖就不用擔心了。\n先經過鳥族的村子吧。」"
  },
  "181": {
   "text": "「走這條路不行嗎？」"
  },
  "182": {
   "text": "「因為要經過獅子族的村子。\n那群人有點好戰……，」"
  },
  "183": {
   "text": "「道路狀況就交給你們了。\n那麼，我們這邊開始做準備。\n隱形先生，可以嗎？」"
  },
  "184": {
   "text": "「嗯。\n赫斯佩拉，拜託了。」"
  },
  "185": {
   "text": "「嗚嚕嚕。」"
  },
  "186": {
   "text": "「大家先確認一下自己的行李吧。」"
  },
  "187": {
   "text": "「好～！\n師父的信，還有蒸汽機車的三角旗。\n然後是漫畫……，」"
  },
  "188": {
   "text": "「……啊，忘記帶換洗衣服了。」"
  },
  "189": {
   "text": "「真是的，又這樣？」"
  },
  "190": {
   "text": "「嗚嗚，對不起……。\n今晚絕對會整理好的……。」"
  },
  "191": {
   "text": "「還有換洗衣服，錢包……。」"
  },
  "192": {
   "text": "「速寫本。」"
  },
  "193": {
   "text": "「……。」"
  },
  "194": {
   "text": "「那個，放得進去嗎？」"
  },
  "195": {
   "text": "「啊，不！\n要放，要放進去！\n捨棄畫具這種事，我哪捨得！」"
  },
  "196": {
   "text": "「可是……，」"
  },
  "197": {
   "text": "「赫斯佩拉，再稍微彎一下腰。\n嗯，謝謝。」"
  },
  "198": {
   "text": "「嗚嚕嚕。」"
  },
  "199": {
   "text": "「（……要是我除了畫畫之外，還能做點別的事就好了）」"
  },
  "200": {
   "text": "「哇～，果然很厲害呢！」"
  },
  "201": {
   "text": "「不愧是專業畫師呀～。」"
  },
  "202": {
   "text": "「是、是嗎？謝謝。\n如果不介意的話，送給你吧。」"
  },
  "203": {
   "text": "「真的可以嗎！？」"
  },
  "204": {
   "text": "「嗯。反正我也只能做這些事了。」"
  },
  "205": {
   "text": "「呀？」"
  },
  "206": {
   "text": "「不不，是我單方面說啦。\n那麼給你了，怎麼……，」"
  },
  "207": {
   "text": "「庫魯魯！」"
  },
  "208": {
   "text": "「……。」"
  },
  "209": {
   "text": "「咦，那是我的速寫本？」"
  },
  "210": {
   "text": "「庫魯庫魯！」"
  },
  "211": {
   "text": "「帕……，」"
  },
  "212": {
   "text": "「被搶走了啦～！」"
  },
  "213": {
   "text": "「<name>先生！<name>先生！\n<name>先生——！」"
  },
  "214": {
   "text": "「幹、幹嘛啦——！」"
  },
  "215": {
   "text": "「庫魯庫魯——！」"
  },
  "216": {
   "text": "「哇哦！？」"
  },
  "217": {
   "text": "「嗯？那隻魔寵拿著的，\n不是蕾雅的速寫本嗎？」"
  },
  "218": {
   "text": "「啊，真的耶——！？」"
  },
  "219": {
   "text": "「咦！」"
  },
  "220": {
   "text": "「啊，啊——！還有畫到一半的畫呢——！」"
  },
  "221": {
   "text": "「……沒救了。」"
  },
  "222": {
   "text": "「放棄得也太快了吧！？」"
  },
  "223": {
   "text": "「可是被魔寵搶走了嘛！？\n根本搶不回來啦——！」"
  },
  "224": {
   "text": "「交給我！赫斯佩拉，我們走。」"
  },
  "225": {
   "text": "「喔魯魯！」"
  },
  "226": {
   "text": "「厄爾庇斯！？\n啊、啊，等等！不能再讓你增加負擔了！」"
  },
  "227": {
   "text": "「啊——，我也要去喔——！」"
  },
  "228": {
   "text": "「厄爾姊！蕾雅姊——！」"
  },
  "229": {
   "text": "「<name>先生，我們也去！」"
  },
  "230": {
   "text": "「好，快點出發！」"
  },
  "231": {
   "text": "「真是的，每次都吵吵鬧鬧的！？」"
  },
  "232": {
   "text": "「跟這群人一起旅行就是這樣啦。\n你懂的吧。」"
  },
  "233": {
   "text": "「好沉重啊！好，出發吧！」"
  },
  "234": {
   "text": "「等等——，兩位——！」"
  },
  "235": {
   "text": "「庫——！庫魯魯！」"
  },
  "236": {
   "text": "「呼、呼、呼……！\n為、為什麼，偏偏是我的速寫本呢……。」"
  },
  "237": {
   "text": "「雷耶，你還好嗎？」"
  },
  "238": {
   "text": "「啊……。\n嗯、嗯。」"
  },
  "239": {
   "text": "「抱歉，這種時候……。」"
  },
  "240": {
   "text": "「……？沒關係啦。\n為什麼要這麼道歉呢？」"
  },
  "241": {
   "text": "「唔……。\n那、那是因為……。」"
  },
  "242": {
   "text": "「……抱歉。」"
  },
  "243": {
   "text": "「……？」"
  },
  "244": {
   "text": "「喔魯魯！」"
  },
  "245": {
   "text": "「啊！」"
  },
  "246": {
   "text": "「庫庫庫……！」"
  },
  "247": {
   "text": "「哇，被徹底挑釁了！」"
  },
  "248": {
   "text": "「但還來得及追上的！」"
  },
  "249": {
   "text": "「……不對，是想要追上嗎？」"
  },
  "250": {
   "text": "「咦？」"
  },
  "251": {
   "text": "「總之只能追了！\n把雷耶的速寫本還回來！」"
  },
  "252": {
   "text": "「拜託了——！」"
  },
  "253": {
   "text": "「庫魯——！」"
  },
  "254": {
   "text": "「……呼、要穿出森林……！」"
  },
  "255": {
   "text": "「……！」"
  },
  "256": {
   "text": "「」"
  },
  "257": {
   "text": "「喔……，」"
  },
  "258": {
   "text": "「這、這是……！」"
  },
  "259": {
   "text": "「世界鐘！？」"
  },
  "260": {
   "text": "「……呼。」"
  },
  "261": {
   "text": "「厄、厄爾庇斯？」"
  },
  "262": {
   "text": "「我、我沒事。\n現在首要任務，是奪回速寫本。\n魔寵是！」"
  },
  "263": {
   "text": "「庫魯魯——。」"
  },
  "264": {
   "text": "「好痛！」"
  },
  "265": {
   "text": "「咦，那是我的速寫本？」"
  },
  "266": {
   "text": "「庫魯魯！庫拉——！」"
  },
  "267": {
   "text": "「呀啊——！被、被襲擊了——！」"
  },
  "268": {
   "text": "「雷、雷耶！」"
  },
  "269": {
   "text": "「快離開！雷耶很怕魔寵……！」"
  },
  "270": {
   "text": "「庫魯魯！」"
  },
  "271": {
   "text": "「別扯我的頭髮啊！」"
  },
  "272": {
   "text": "「嗷嗷嗷嗷嗷！」"
  },
  "273": {
   "text": "「……！」"
  },
  "274": {
   "text": "「剛才那是……叫聲？」"
  },
  "275": {
   "text": "「咕！」"
  },
  "276": {
   "text": "「咿！怎、怎麼了！？\n那是什麼啊！」"
  },
  "277": {
   "text": "「是——我——們——的——錢——幣——！」"
  },
  "278": {
   "text": "「……有什麼東西要來了？」"
  },
  "279": {
   "text": "「別碰我！」"
  },
  "280": {
   "text": "「呀啊啊啊啊啊！？」"
  },
  "281": {
   "text": "「誰！？」"
  },
  "282": {
   "text": "「呀啊啊，普里泰里奧娜大人——！」"
  },
  "283": {
   "text": "「我們一直在等您呢，普里大人——！」"
  },
  "284": {
   "text": "「嘎——呵呵呵！\n謝謝你的報告，我的親衛隊——！」"
  },
  "285": {
   "text": "「話說回來……又是你啊，芙勞蕾茵！\n真是個不知悔改的傢伙呢。\n來到鐘邊的魔寵，現在只有你一個了哦？」"
  },
  "286": {
   "text": "「庫魯魯！」"
  },
  "287": {
   "text": "「呵呵～，看來很有幹勁嘛。\n好啊好啊，我都興奮起來了！」"
  },
  "288": {
   "text": "「那邊的人類是同伴嗎？\n我知道了。一起把你打飛吧！」"
  },
  "289": {
   "text": "「咦！？等等等等，我們是！」"
  },
  "290": {
   "text": "「厄爾庇斯、雷耶！\n你們沒事吧——！」"
  },
  "291": {
   "text": "「嗯嗯～？」"
  },
  "292": {
   "text": "「大、大家！\n救救我——！\n情況好像有點不對勁！」"
  },
  "293": {
   "text": "「不對勁？」"
  },
  "294": {
   "text": "「……等等，那個可愛的世界鐘是！」"
  },
  "295": {
   "text": "「世界鐘居然可以裝飾！？\n糟糕了——！我也該做一個！」"
  },
  "296": {
   "text": "「哎呀，人變多了。而且又是人類。\n跟魔寵為伍，真是些怪人呢。」"
  },
  "297": {
   "text": "「算了！不管來多少人，\n照舊把你們趕走！」"
  },
  "298": {
   "text": "「呀——！普里大人——！」"
  },
  "299": {
   "text": "「咦！怎、怎麼了！？」"
  },
  "300": {
   "text": "「這裡氣氛不太對勁呢。」"
  },
  "301": {
   "text": "「這條尾巴我好像在哪裡見過。\n那應該是……。」"
  },
  "302": {
   "text": "「呀，我想起來了！\n那條尾巴是……！」"
  },
  "303": {
   "text": "「」"
  },
  "304": {
   "text": "「獅子族……！\n是動物之國中勢力最大的一族。」"
  },
  "305": {
   "text": "「而且那傢伙，\n對自己的領地可是嚴格得很呢。」"
  },
  "306": {
   "text": "「也就是說，情況不妙了……。」"
  },
  "307": {
   "text": "「欸——，知道到這種程度還敢闖進來！？」"
  },
  "308": {
   "text": "「嘎呼呼呼呼，你們真有趣！\n是這麼想要這口鐘嗎？」"
  },
  "309": {
   "text": "「確實有到處敲鐘，但是……，」"
  },
  "310": {
   "text": "「果然目標是鐘啊！」"
  },
  "311": {
   "text": "「真是無禮之輩！」"
  },
  "312": {
   "text": "「糟了。」"
  },
  "313": {
   "text": "「糟糕了。」"
  },
  "314": {
   "text": "「不行哦——！\n這口鐘是要由我來敲的！」"
  },
  "315": {
   "text": "「那、你也是奏鐘士……！」"
  },
  "316": {
   "text": "「欸，那是什麼。」"
  },
  "317": {
   "text": "「欸。」"
  },
  "318": {
   "text": "「那到底為什麼要敲鐘！？」"
  },
  "319": {
   "text": "「嘎呼呼呼……那、就是、嘛。」"
  },
  "320": {
   "text": "「是為了慶祝我的結婚哦——！」"
  },
  "321": {
   "text": "「結……，」"
  },
  "322": {
   "text": "「結婚！？」"
  },
  "323": {
   "text": "「對，我知道的！\n聽說在國外，結婚時敲鐘\n既時髦又高雅呢！」"
  },
  "324": {
   "text": "「所以正打算準備鐘的時候，\n這口鐘就出現了！\n世界在祝福我們的結婚呢～！」"
  },
  "325": {
   "text": "「也就是說，有權敲這口鐘的是我。\n明白了嗎？」"
  },
  "326": {
   "text": "「……。」"
  },
  "327": {
   "text": "「看你們好像明白了！」"
  },
  "328": {
   "text": "「剛才那可不是那種沉默！？」"
  },
  "329": {
   "text": "「為了讓你們再也不敢打鐘的主意，\n好好教訓你們一頓吧？」"
  },
  "330": {
   "text": "「就像往常一樣……嘛。」"
  },
  "331": {
   "text": "「咕嚕嚕嚕！」"
  },
  "332": {
   "text": "「……！來了！」"
  },
  "333": {
   "text": "「在候婚第一人的力量面前跪下吧——！」"
  }
 },
